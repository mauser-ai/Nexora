rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar profilo utente: solo il proprietario può scrivere, chiunque autenticato legge
    match /users/{userId}/avatar.jpg {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Logo aziendale del team: chiunque autenticato può scrivere/leggere
    match /teams/{teamId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Sfondi template PDF: l'utente può scrivere i propri, chiunque autenticato legge
    match /users/{userId}/template_bg/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
