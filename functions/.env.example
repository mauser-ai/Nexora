# ─── Stripe ───────────────────────────────────────────────────────────────────
# Copia questo file in .env e compila con le tue chiavi reali.
# Il file .env NON deve essere committato nel repository (aggiungilo a .gitignore).

# Chiave segreta Stripe (dashboard.stripe.com → Sviluppatori → Chiavi API)
STRIPE_SECRET_KEY=INSERISCI_STRIPE_SECRET_KEY

# Segreto webhook Stripe (dashboard.stripe.com → Sviluppatori → Webhook → Signing secret)
STRIPE_WEBHOOK_SECRET=INSERISCI_STRIPE_WEBHOOK_SECRET

# ID prezzi Stripe (dashboard.stripe.com → Prodotti → seleziona il prodotto → ID prezzo)
STRIPE_PRICE_BASE=INSERISCI_STRIPE_PRICE_BASE
STRIPE_PRICE_PRO=INSERISCI_STRIPE_PRICE_PRO
STRIPE_PRICE_ENTERPRISE=INSERISCI_STRIPE_PRICE_ENTERPRISE
