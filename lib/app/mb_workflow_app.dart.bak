                      ),
                      // 3 – Contatti
                    ] else if (selectedIndex == 2) ...[
                      const _SectionTitle(
                        title: 'Contatti',
                        subtitle:
                            'Rubrica CRM: contatti collegati ad aziende, deal e attività.',
                      ),
                      const SizedBox(height: 16),
                      SizedBox(
                        height: 700,
                        child: ContattiFirestoreCard(
                          crmData: _crmData,
