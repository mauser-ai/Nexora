  @override
  Widget build(BuildContext context) {
    // Sidebar identica all'immagine Teamleader Focus
    // 0=Task 1=Calendario 2=Società 3=Contatti 4=Opportunità
    // 5=Preventivi 6=Progetti 7=Finanze 8=Ticket 9=Prodotti
    // 10=Segnatempo 11=Statistiche 12=Impostazioni 13=Archivio
    // 0=ToDo(Task/Carico/Agenda) 1=Società 2=Contatti 3=Opportunità 4=Preventivi
    // 5=Progetti 6=Finanze 7=Ticket 8=Prodotti 9=Segnatempo 10=Statistiche 11=Impostazioni 12=Archivio
    final railItems = <({String label, IconData icon, IconData activeIcon})>[
      (
        label: 'ToDo',
        icon: Icons.checklist_outlined,
        activeIcon: Icons.checklist,
      ),
      (
        label: 'Società',
        icon: Icons.apartment_outlined,
        activeIcon: Icons.apartment,
      ),
      (
        label: 'Contatti',
        icon: Icons.people_outline_rounded,
        activeIcon: Icons.people_rounded,
      ),
      (
        label: 'Opportunità',
        icon: Icons.trending_up_outlined,
        activeIcon: Icons.trending_up,
      ),
      (
        label: 'Preventivi',
        icon: Icons.request_quote_outlined,
        activeIcon: Icons.request_quote,
      ),
      (
        label: 'Progetti',
        icon: Icons.folder_open_outlined,
        activeIcon: Icons.folder_open,
      ),
      (
        label: 'Finanze',
        icon: Icons.receipt_long_outlined,
        activeIcon: Icons.receipt_long,
      ),
      (
        label: 'Ticket',
        icon: Icons.support_agent_outlined,
        activeIcon: Icons.support_agent,
      ),
      (
        label: 'Prodotti',
        icon: Icons.inventory_2_outlined,
        activeIcon: Icons.inventory_2,
      ),
      (
        label: 'Segnatempo',
        icon: Icons.schedule_outlined,
        activeIcon: Icons.schedule,
      ),
      (
        label: 'Statistiche',
        icon: Icons.bar_chart_outlined,
        activeIcon: Icons.bar_chart,
      ),
      (
        label: 'Impostazioni',
        icon: Icons.settings_outlined,
        activeIcon: Icons.settings,
      ),
      (
        label: 'Archivio',
        icon: Icons.folder_copy_outlined,
        activeIcon: Icons.folder_copy,
      ),
    ];
    return StreamBuilder<WorkspaceSnapshot>(
      stream: _workspaceStream,
      initialData: WorkspaceSnapshot.empty,
      builder: (context, snapshot) {
        if (snapshot.hasError) {
          return FirestoreErrorPage(
            error: snapshot.error.toString(),
            onSignOut: FirebaseAuth.instance.signOut,
          );
        }

        final workspace = snapshot.data ?? WorkspaceSnapshot.empty;
        if (workspace.plannedSlots.isEmpty) {
          _autoAlignedPlanningWeek = false;
        } else if (!_autoAlignedPlanningWeek) {
          final currentWeekEnd = visibleWeekStart.add(const Duration(days: 6));
          final hasSlotsInVisibleWeek = workspace.plannedSlots.any((slot) {
            final day = DateTime(
              slot.date.year,
              slot.date.month,
              slot.date.day,
            );
            return !day.isBefore(visibleWeekStart) &&
                !day.isAfter(currentWeekEnd);
          });
          if (hasSlotsInVisibleWeek) {
            _autoAlignedPlanningWeek = true;
          } else {
            final today = DateTime.now();
            final todayDate = DateTime(today.year, today.month, today.day);
            final normalizedSlots =
                workspace.plannedSlots
                    .map(
                      (slot) => DateTime(
                        slot.date.year,
                        slot.date.month,
                        slot.date.day,
                      ),
                    )
                    .toList()
                  ..sort((a, b) => a.compareTo(b));
            DateTime targetDate = normalizedSlots.first;
            for (final date in normalizedSlots) {
              if (!date.isBefore(todayDate)) {
                targetDate = date;
                break;
              }
              targetDate = date;
            }
            _autoAlignedPlanningWeek = true;
            WidgetsBinding.instance.addPostFrameCallback((_) {
              if (!mounted) {
                return;
              }
              setState(() {
                visibleWeekStart = _startOfWeek(targetDate);
              });
            });
          }
        }
        // indice 1 = Calendario → mostra la timeline planner esistente
        // indice 1 = Calendario → mostra la timeline planner esistente
        // Agenda (sub 2 di ToDo) usa layout full-height come il planner
        // Carico (sub 1) e Agenda (sub 2) usano entrambi il layout full-height
        final isPlanningSection =
            selectedIndex == 0 && (_todoSub == 1 || _todoSub == 2);
        const pagePadding = EdgeInsets.all(24);
        _ensureWorkspaceBootstrap(workspace);

        // Seed CRM demo data su Firestore al primo accesso con aziende esistenti
        if (workspace.companies.isNotEmpty && !_crmSeeded) {
          _crmSeeded = true;
          _crmRepository.seedCrmData(widget.user.uid, workspace.companies);
        }

        // Seed Gweb SRL team (riccardo.sacchetto@gweb.agency o qualsiasi utente senza team)
        if (!_teamSeeded && _teamInfo == null) {
          _teamSeeded = true;
          _teamRepository.seedGwebTeam(
            currentUserId: widget.user.uid,
            currentUserEmail: widget.user.email ?? '',
          );
        }

        // ── Detail page override ──
        // Se un'entità è aperta, mostriamo la scheda dettaglio invece del listing
        if (_detailEntity != null && _detailType != null) {
          final detailContent = _buildDetailPage(
            context,
            workspace,
            pagePadding,
          );
          if (detailContent != null) {
            return LayoutBuilder(
              builder: (context, constraints) {
                if (constraints.maxWidth < 960) {
                  return MobileWorkspaceScaffold(
                    workspace: workspace,
                    currentUserName: widget.user.email ?? widget.user.uid,
                    emailSignatureHtml: workspace.emailSignatureHtml,
                    onCreateTicket: _createTicket,
                    onUpdateTicket: _updateTicket,
                    onEditTask: (task) async =>
                        _openTaskDialog(context, workspace, task: task),
                    onLogTime: (task) async =>
                        _openTimeTrackDialog(context, workspace, task: task),
                    onToggleTaskDone: _toggleTaskDone,
                    onDeleteTimelineSlot: (slot) =>
                        _deleteTimelineSlot(workspace, slot),
                    onRepeatTaskUntilDeadline: (task, slot) =>
                        _repeatTaskUntilDeadlineFromSlot(workspace, task, slot),
                    onAddTask: () => _openTaskDialog(context, workspace),
                  );
                }
                return Scaffold(
                  body: Row(
                    children: [
                      Container(
                        width: 195,
                        color: GussoniBrand.sidebarColor,
                        child: SafeArea(
                          child: Padding(
                            padding: const EdgeInsets.fromLTRB(10, 20, 10, 16),
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.stretch,
                              children: [
                                // Logo del team o logo Nexora
                                _SidebarLogo(),
                                const SizedBox(height: 28),
                                Expanded(
                                  child: SingleChildScrollView(
                                    child: Column(
                                      crossAxisAlignment:
                                          CrossAxisAlignment.stretch,
                                      children: [
                                        ...List.generate(railItems.length, (
                                          index,
                                        ) {
                                          final item = railItems[index];
                                          final selected =
                                              selectedIndex == index;
                                          return Column(
                                            crossAxisAlignment:
                                                CrossAxisAlignment.stretch,
                                            children: [
                                              Padding(
                                                padding: const EdgeInsets.only(bottom: 2),
                                                child: _SidebarNavButton(
                                                  label: item.label,
                                                  icon: selected
                                                      ? item.activeIcon
                                                      : item.icon,
                                                  selected: selected,
                                                  onTap: () {
                                                    _closeDetail();
                                                    _selectSection(index);
                                                  },
                                                ),
                                              ),
                                              _TodoSidebarSubmenu(
                                                visible: index == 0 && selected,
                                                todoSub: _todoSub,
                                                onSelect: (i) {
                                                  setState(() {
                                                    _todoSub = i;
                                                    _detailType = null;
                                                    _detailEntity = null;
                                                  });
                                                  _syncCrmSubscription();
                                                  _onTaskContextChanged();
                                                  _schedulePersistUiState();
                                                },
                                              ),
                                              _FinanzeSidebarSubmenu(
                                                visible: index == 6 && selected,
                                                finanzeSub: _finanzeSub,
                                                onSelect: (i) {
                                                  setState(() {
                                                    _finanzeSub = i;
                                                    _detailType = null;
                                                    _detailEntity = null;
                                                  });
                                                  _syncCrmSubscription();
                                                  _syncTeamSubscriptions();
                                                  _schedulePersistUiState();
                                                },
                                              ),
                                            ],
                                          );
                                        }),
                                      ],
                                    ),
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ),
                      ),
                      Expanded(
                        child: Column(
                          children: [
                            SafeArea(
                              bottom: false,
                              child: Padding(
                                padding: const EdgeInsets.fromLTRB(
                                  16,
                                  12,
                                  16,
                                  0,
                                ),
                                child: Row(
                                  children: [
                                    const Spacer(),
                                    OutlinedButton.icon(
                                      onPressed: FirebaseAuth.instance.signOut,
                                      icon: const Icon(Icons.logout),
                                      label: const Text('Logout'),
                                    ),
                                  ],
                                ),
                              ),
                            ),
                            Expanded(
                              child: Padding(
                                padding: pagePadding,
                                child: detailContent,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ],
                  ),
                );
              },
            );
          }
        }

        // Agenda: schermata piena con header ToDo + sub-tabs sopra il planner
        final content = isPlanningSection
            ? Padding(
                padding: pagePadding,
                child: workspace.isEmpty
                    ? EmptyWorkspaceCard(
                        isLoading:
                            _workspaceBootstrapInProgress ||
                            !_workspaceBootstrapStarted,
                        errorMessage: _workspaceBootstrapError,
                      )
                    : Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          // Header ToDo con sub-tabs e indicatore Calendario
                          Row(
                            children: [
                              Expanded(
                                child: _SectionTitle(
                                  title: _todoSub == 1
                                      ? 'Carico di lavoro'
                                      : 'Agenda',
                                  subtitle: _todoSub == 1
                                      ? 'Vista sola lettura del carico settimanale per azienda.'
                                      : 'Pianifica gli slot con selezione task assegnati a te.',
                                ),
                              ),
                              const SizedBox(width: 16),
                              // Indicatore stato calendario
                              Container(
                                padding: const EdgeInsets.symmetric(
                                  horizontal: 10,
                                  vertical: 5,
                                ),
                                decoration: BoxDecoration(
                                  color: _todoSub == 2
                                      ? const Color(0xFFF0FDF4)
                                      : const Color(0xFF080A14),
                                  borderRadius: BorderRadius.circular(8),
                                  border: Border.all(
                                    color: _todoSub == 2
                                        ? GussoniBrand.primary
                                        : const Color(0xFF1E2130),
                                  ),
                                ),
                                child: Row(
                                  mainAxisSize: MainAxisSize.min,
                                  children: [
                                    Icon(
                                      Icons.calendar_month_outlined,
                                      size: 14,
                                      color: _todoSub == 2
                                          ? GussoniBrand.primary
                                          : const Color(0xFF525D78),
                                    ),
                                    const SizedBox(width: 5),
                                    Text(
                                      'Calendario: ${_todoSub == 2 ? "Attivo" : "Disattivo"}',
                                      style: TextStyle(
                                        fontSize: 12,
                                        fontWeight: FontWeight.w700,
                                        color: _todoSub == 2
                                            ? GussoniBrand.primary
                                            : const Color(0xFF525D78),
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                              const SizedBox(width: 12),
                              _TodoSubTabs(
                                selected: _todoSub,
                                onChanged: (i) {
                                  setState(() {
                                    _todoSub = i;
                                    _detailType = null;
                                    _detailEntity = null;
                                  });
                                  _syncCrmSubscription();
                                  _syncTeamSubscriptions();
                                  _schedulePersistUiState();
                                },
                              ),
                            ],
                          ),
                          const SizedBox(height: 12),
                          Expanded(
                            child: _todoSub == 1
                                ? CaricoCard(workspace: workspace)
                                : AgendaCalendar(
                                    workspace: workspace,
                                    currentUserId: widget.user.uid,
                                    visibleWeekStart: visibleWeekStart,
                                    onShiftWeek: _shiftWeek,
                                    onScheduleTask: (task, date, startHour, durationHours) =>
                                        _scheduleTaskOnDay(workspace, task, date, startHour, durationHours),
                                    onDeleteTimelineSlot: (slot) =>
                                        _deleteTimelineSlot(workspace, slot),
                                    onEditTask: (task) =>
                                        _openTaskDialog(context, workspace, task: task),
                                    onLogTime: (task) =>
                                        _openTimeTrackDialog(context, workspace, task: task),
                                    onToggleTaskDone: _toggleTaskDone,
                                    onAddTask: () => _openTaskDialog(context, workspace),
                                    selectedPlanningTaskId: _planningTaskId,
                                    onSelectedPlanningTaskIdChanged: (id) =>
