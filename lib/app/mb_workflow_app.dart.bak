  @override
  Widget build(BuildContext context) {
    return Center(
      child: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
        child: Image.asset(
          GussoniBrand.logoWhitePath,
          fit: BoxFit.contain,
          height: 48,
        ),
