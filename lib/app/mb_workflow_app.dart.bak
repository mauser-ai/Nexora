class TimeTrackingStatsCard extends StatefulWidget {
  const TimeTrackingStatsCard({super.key, required this.workspace});

  final WorkspaceSnapshot workspace;

  @override
  State<TimeTrackingStatsCard> createState() => _TimeTrackingStatsCardState();
}

class _TimeTrackingStatsCardState extends State<TimeTrackingStatsCard> {
  String? _companyId;
  String? _projectId;
  DateTime _startDate = DateTime.now().subtract(const Duration(days: 30));
  DateTime _endDate = DateTime.now();

  @override
  Widget build(BuildContext context) {
    final projects = widget.workspace.projects
        .where(
          (project) => _companyId == null || project.companyId == _companyId,
        )
        .toList();
    final filteredTasks = widget.workspace.tasks.where((task) {
      if (_companyId != null && task.companyId != _companyId) {
        return false;
      }
      if (_projectId != null && task.projectId != _projectId) {
        return false;
      }
      return true;
    }).toList();
    final filteredTaskIds = filteredTasks.map((task) => task.id).toSet();
    final tasksById = {
      for (final task in widget.workspace.tasks) task.id: task,
    };
    final companyById = {
      for (final company in widget.workspace.companies)
        company.id: company.name,
    };
    final projectById = {
      for (final project in widget.workspace.projects) project.id: project.name,
    };
    final filtered = widget.workspace.timeTracks.where((track) {
      final day = DateTime(
        track.startAt.year,
        track.startAt.month,
        track.startAt.day,
      );
      if (day.isBefore(
            DateTime(_startDate.year, _startDate.month, _startDate.day),
          ) ||
          day.isAfter(DateTime(_endDate.year, _endDate.month, _endDate.day))) {
        return false;
      }
      if (_companyId != null && track.companyId != _companyId) {
        return false;
      }
      if (_projectId != null && track.projectId != _projectId) {
        return false;
      }
      return true;
    }).toList();

    final totalHours = filtered.fold<double>(
      0,
      (sum, item) => sum + item.hours,
    );
    final totalEstimated = filteredTasks.fold<double>(
      0,
      (sum, task) => sum + task.estimatedHours,
    );
    final totalPlanned = widget.workspace.plannedSlots.fold<double>(0, (
      sum,
      slot,
    ) {
      if (!filteredTaskIds.contains(slot.taskId)) {
        return sum;
      }
      return sum + slot.plannedHours;
    });
    final taskCount = filtered
        .map((item) => item.taskId)
        .where((id) => id.isNotEmpty)
        .toSet()
        .length;
    final companyTotals = <String, double>{};
    final projectTotals = <String, double>{};
    final taskTotals = <String, double>{};
    for (final track in filtered) {
      companyTotals.update(
        track.companyId,
        (v) => v + track.hours,
        ifAbsent: () => track.hours,
      );
      projectTotals.update(
        track.projectId,
        (v) => v + track.hours,
        ifAbsent: () => track.hours,
      );
      taskTotals.update(
        track.taskId,
        (v) => v + track.hours,
        ifAbsent: () => track.hours,
      );
    }
    final topCompanies = companyTotals.entries.toList()
      ..sort((a, b) => b.value.compareTo(a.value));
    final topProjects = projectTotals.entries.toList()
      ..sort((a, b) => b.value.compareTo(a.value));
    final topTasks = taskTotals.entries.toList()
      ..sort((a, b) => b.value.compareTo(a.value));
    final taskTriples = <_TripleRow>[];
    for (final task in filteredTasks) {
      final planned = widget.workspace.plannedSlots
          .where((slot) => slot.taskId == task.id)
          .fold<double>(0, (sum, slot) => sum + slot.plannedHours);
      final spent = filtered
          .where((track) => track.taskId == task.id)
          .fold<double>(0, (sum, track) => sum + track.hours);
      taskTriples.add(
        _TripleRow(
          label: task.name,
          estimated: task.estimatedHours,
          planned: planned,
          spent: spent,
        ),
      );
    }
    taskTriples.sort((a, b) => b.spent.compareTo(a.spent));

    final clientTriplesById = <String, _TripleAccumulator>{};
    for (final task in filteredTasks) {
      final acc = clientTriplesById.putIfAbsent(
        task.companyId,
        _TripleAccumulator.new,
      );
      acc.estimated += task.estimatedHours;
    }
    for (final slot in widget.workspace.plannedSlots) {
      final task = tasksById[slot.taskId];
      if (task == null || !filteredTaskIds.contains(task.id)) {
        continue;
      }
      final acc = clientTriplesById.putIfAbsent(
        task.companyId,
        _TripleAccumulator.new,
      );
      acc.planned += slot.plannedHours;
    }
    for (final track in filtered) {
      final companyId = track.companyId.isNotEmpty
          ? track.companyId
          : tasksById[track.taskId]?.companyId ?? '';
      if (companyId.isEmpty) {
        continue;
      }
      final acc = clientTriplesById.putIfAbsent(
        companyId,
        _TripleAccumulator.new,
      );
      acc.spent += track.hours;
    }
    final clientTriples =
        clientTriplesById.entries
            .map(
              (entry) => _TripleRow(
                label: companyById[entry.key] ?? '-',
                estimated: entry.value.estimated,
                planned: entry.value.planned,
                spent: entry.value.spent,
              ),
            )
            .toList()
          ..sort((a, b) => b.spent.compareTo(a.spent));

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Wrap(
              spacing: 12,
              runSpacing: 12,
              children: [
                SizedBox(
                  width: 240,
                  child: DropdownButtonFormField<String>(
                    value: _companyId,
                    decoration: const InputDecoration(
                      labelText: 'Cliente',
                      border: OutlineInputBorder(),
                    ),
                    items: [
                      const DropdownMenuItem(
                        value: null,
                        child: Text('Tutti i clienti'),
                      ),
                      ...widget.workspace.companies.map(
                        (company) => DropdownMenuItem(
                          value: company.id,
                          child: Text(company.name),
                        ),
                      ),
                    ],
                    onChanged: (value) {
                      setState(() {
                        _companyId = value;
                        if (_projectId != null &&
                            projects.every(
                              (project) => project.id != _projectId,
                            )) {
                          _projectId = null;
                        }
                      });
                    },
                  ),
                ),
                SizedBox(
                  width: 240,
                  child: DropdownButtonFormField<String>(
                    value: _projectId,
                    decoration: const InputDecoration(
                      labelText: 'Progetto',
                      border: OutlineInputBorder(),
                    ),
                    items: [
                      const DropdownMenuItem(
                        value: null,
                        child: Text('Tutti i progetti'),
                      ),
                      ...projects.map(
                        (project) => DropdownMenuItem(
                          value: project.id,
                          child: Text(project.name),
                        ),
                      ),
                    ],
                    onChanged: (value) => setState(() => _projectId = value),
                  ),
                ),
                OutlinedButton.icon(
                  onPressed: () async {
                    final picked = await showDatePicker(
                      context: context,
                      initialDate: _startDate,
                      firstDate: DateTime(2020),
                      lastDate: DateTime(2100),
                    );
                    if (picked != null) {
                      setState(() => _startDate = picked);
                    }
                  },
                  icon: const Icon(Icons.calendar_today_outlined),
                  label: Text('Da ${_shortDate(_startDate)}'),
                ),
                OutlinedButton.icon(
                  onPressed: () async {
                    final picked = await showDatePicker(
                      context: context,
                      initialDate: _endDate,
                      firstDate: DateTime(2020),
                      lastDate: DateTime(2100),
                    );
                    if (picked != null) {
                      setState(() => _endDate = picked);
                    }
                  },
                  icon: const Icon(Icons.event_outlined),
                  label: Text('A ${_shortDate(_endDate)}'),
                ),
              ],
            ),
            const SizedBox(height: 16),
            Wrap(
              spacing: 12,
              runSpacing: 12,
              children: [
                _StatsTile(
                  label: 'Preventivato',
                  value: _formatHours(totalEstimated),
                ),
                _StatsTile(
                  label: 'Pianificato',
                  value: _formatHours(totalPlanned),
                ),
                _StatsTile(
                  label: 'Ore segnate',
                  value: _formatHours(totalHours),
                ),
                _StatsTile(label: 'Segnatempo', value: '${filtered.length}'),
                _StatsTile(label: 'Task coinvolti', value: '$taskCount'),
              ],
            ),
            const SizedBox(height: 16),
            _TripleMatrixCard(
              title: 'Cliente: preventivato / pianificato / speso',
              rows: clientTriples,
            ),
            const SizedBox(height: 12),
            _TripleMatrixCard(
              title: 'Task: preventivato / pianificato / speso',
              rows: taskTriples,
            ),
            const SizedBox(height: 12),
            _StatsBars(
              title: 'Tempo per cliente',
              entries: topCompanies.take(6).toList(),
              labelById: (id) => companyById[id] ?? '-',
            ),
            const SizedBox(height: 12),
            _StatsBars(
              title: 'Tempo per progetto',
              entries: topProjects
                  .where((entry) => entry.key.isNotEmpty)
                  .take(6)
                  .toList(),
              labelById: (id) => projectById[id] ?? '-',
            ),
            const SizedBox(height: 12),
            _StatsBars(
              title: 'Tempo per task',
              entries: topTasks
                  .where((entry) => entry.key.isNotEmpty)
                  .take(8)
                  .toList(),
              labelById: (id) => tasksById[id]?.name ?? '-',
            ),
          ],
        ),
      ),
    );
  }
}

class _TripleAccumulator {
  double estimated = 0;
  double planned = 0;
  double spent = 0;
}

class _TripleRow {
  const _TripleRow({
    required this.label,
    required this.estimated,
    required this.planned,
    required this.spent,
  });

  final String label;
  final double estimated;
  final double planned;
  final double spent;
}

class _TripleMatrixCard extends StatelessWidget {
  const _TripleMatrixCard({required this.title, required this.rows});

  final String title;
  final List<_TripleRow> rows;

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: const Color(0xFFFFFFFF),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: const Color(0xFF1E2130)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            title,
            style: Theme.of(
              context,
            ).textTheme.titleMedium?.copyWith(fontWeight: FontWeight.w700),
          ),
          const SizedBox(height: 10),
          if (rows.isEmpty)
            const Text('Nessun dato disponibile.')
          else
            SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              child: ConstrainedBox(
                constraints: const BoxConstraints(minWidth: 860),
                child: DataTable(
                  columns: const [
                    DataColumn(label: Text('Nome')),
                    DataColumn(label: Text('Preventivato')),
                    DataColumn(label: Text('Pianificato')),
                    DataColumn(label: Text('Speso')),
                    DataColumn(label: Text('Delta speso-prev.')),
                  ],
                  rows: rows
                      .map(
                        (row) => DataRow(
                          cells: [
                            DataCell(Text(row.label)),
                            DataCell(Text(_formatHours(row.estimated))),
                            DataCell(Text(_formatHours(row.planned))),
                            DataCell(Text(_formatHours(row.spent))),
                            DataCell(
                              Text(
                                _formatHours(row.spent - row.estimated),
                                style: TextStyle(
                                  color: row.spent > row.estimated
                                      ? const Color(0xFFB91C1C)
                                      : const Color(0xFF0F766E),
                                ),
                              ),
                            ),
                          ],
                        ),
                      )
                      .toList(),
                ),
              ),
            ),
        ],
      ),
    );
  }
}

class _StatsTile extends StatelessWidget {
  const _StatsTile({required this.label, required this.value});

  final String label;
  final String value;

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 195,
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: const Color(0xFFFFFFFF),
