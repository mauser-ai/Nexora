class DashboardPage extends StatefulWidget {
  const DashboardPage({super.key, required this.user});

  final User user;

  @override
  State<DashboardPage> createState() => _DashboardPageState();
}

class _DashboardPageState extends State<DashboardPage> {
  final _repository = FirestoreWorkspaceRepository();
  final _crmRepository = FirestoreCrmRepository();
  final _teamRepository = TeamRepository();
  final _planner = const PlanningService();
  final _googleCalendar = GoogleCalendarService();
  final _youdox = const YoudoxService();
  int selectedIndex = 0;
  late DateTime visibleWeekStart;
  bool _googleCalendarBusy = false;
  bool _googleCalendarConnected = false;
  String? _googleCalendarEmail;
  Timer? _googleSyncDebounce;
  Timer? _uiStateDebounce;
  WorkspaceSnapshot? _pendingGoogleSyncWorkspace;
  late Stream<WorkspaceSnapshot> _workspaceStream;
  StreamSubscription<CrmData>? _crmDataSubscription;
  bool _uiStateRestored = false;
  final _pushTokenService = PushTokenRegistrationService();
  bool _autoAlignedPlanningWeek = false;
  // CRM Firestore stream state
  CrmData _crmData = CrmData.empty;
  bool _crmSeeded = false;
  bool _workspaceBootstrapStarted = false;
  bool _workspaceBootstrapInProgress = false;
  String? _workspaceBootstrapError;

  // ── Team state ──
  TeamInfo? _teamInfo; // info team corrente
  Map<String, List<TimeTrack>> _memberTimeTracks = {}; // memberId → tracks
  Map<String, List<WorkTask>> _memberTasksCache = {}; // memberId -> tasks
  final Map<String, StreamSubscription<List<Map<String, dynamic>>>>
  _memberTimeTrackSubs = {};
  final Map<String, StreamSubscription<List<Map<String, dynamic>>>>
  _allMembersTaskSubs = {};
  StreamSubscription<List<Map<String, dynamic>>>? _selectedMemberTaskSub;
  String? _selectedMemberTaskSubUserId;
  String? _selectedMemberId; // null = me stesso
  bool _teamSeeded = false;
  bool _backlogCleanupStarted = false;
  int _taskQueryLimit = 120;
  static const int _taskQueryLimitMax = 1500;

  // Submenu ToDo (0=Task, 1=Carico, 2=Agenda)
  int _todoSub = 0;
  // Submenu Finanze (0=Fatture, 1=Abbonamenti, 2=Note di credito)
  int _finanzeSub = 0;
  String? _planningTaskId;

  // Navigazione master-detail: entità attualmente aperta
  Object?
  _detailEntity; // Company | CrmFirestoreContact | Deal | Quotation | Project | InvoiceDraft | WorkTask | Product
  String?
  _detailType; // 'company' | 'contact' | 'deal' | 'quotation' | 'project' | 'invoice' | 'task' | 'product'

  void _openDetail(String type, Object entity) {
    setState(() {
      _detailType = type;
      _detailEntity = entity;
    });
    _syncCrmSubscription();
  }

  void _closeDetail() {
    setState(() {
      _detailType = null;
      _detailEntity = null;
    });
    _syncCrmSubscription();
  }

  Future<void> _planTaskInCalendar(WorkTask task) async {
    if (!mounted) {
      return;
    }
    setState(() {
      selectedIndex = 0;
      _todoSub = 2;
      _planningTaskId = task.id;
      _detailType = null;
      _detailEntity = null;
    });
    _syncCrmSubscription();
    _schedulePersistUiState();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          'Task selezionato per pianificazione: ${task.name}. Trascina sugli slot in Agenda.',
        ),
      ),
    );
  }

  // ── Team helpers ──

  // Gestione cache/sottoscrizioni team (on-demand)
  void _loadMemberTimeTracks(TeamInfo teamInfo) {
    final activeMemberIds = teamInfo.activeMembers
        .map((member) => member.userId)
        .where((id) => id != widget.user.uid)
        .toSet();

    final staleTrackSubs = _memberTimeTrackSubs.keys
        .where((id) => !activeMemberIds.contains(id))
        .toList();
    for (final memberId in staleTrackSubs) {
      _memberTimeTrackSubs.remove(memberId)?.cancel();
      _memberTimeTracks.remove(memberId);
    }

    final staleTaskSubs = _allMembersTaskSubs.keys
        .where((id) => !activeMemberIds.contains(id))
        .toList();
    for (final memberId in staleTaskSubs) {
      _allMembersTaskSubs.remove(memberId)?.cancel();
      _memberTasksCache.remove(memberId);
    }
    _syncTeamSubscriptions();
  }

  // Ritorna il workspace con i timeTracks del membro selezionato
  WorkspaceSnapshot _workspaceForSelectedMember(WorkspaceSnapshot myWorkspace) {
    final memberId = _selectedMemberId;
    if (memberId == null || memberId == widget.user.uid) return myWorkspace;
    final memberTracks = _memberTimeTracks[memberId] ?? [];
    return myWorkspace.copyWith(timeTracks: memberTracks);
  }

  // Ritorna tutti i tasks del team (propri + quelli degli altri filtrabili)
  List<WorkTask> _tasksForFilter(
    WorkspaceSnapshot workspace,
    String? filterUserId,
  ) {
    if (filterUserId == null) {
      final byCompositeKey = <String, WorkTask>{};
      for (final task in workspace.tasks) {
        byCompositeKey['${task.assigneeId}_${task.id}'] = task;
      }
      for (final memberTasks in _memberTasksCache.values) {
        for (final task in memberTasks) {
          byCompositeKey['${task.assigneeId}_${task.id}'] = task;
        }
      }
      return byCompositeKey.values.toList();
    }
    if (filterUserId == widget.user.uid) {
      return workspace.tasks;
    }
    return _memberTasksCache[filterUserId] ?? const <WorkTask>[];
  }

  WorkspaceSnapshot _workspaceForTaskFilter(
    WorkspaceSnapshot workspace,
    String? filterUserId,
  ) {
    return workspace.copyWith(tasks: _tasksForFilter(workspace, filterUserId));
  }

  String? _normalizedTaskFilterUserId(String? selectedMemberId) {
    if (selectedMemberId == null || selectedMemberId == 'all') {
      return null;
    }
    return selectedMemberId;
  }

  List<WorkTask> _decodeMemberTasks(
    String memberId,
    List<Map<String, dynamic>> rawTasks,
  ) {
    return rawTasks
        .map((m) {
          final id = m['id'] as String;
          final data = Map<String, dynamic>.from(m)..remove('id');
          final task = WorkTask.fromMap(id, data);
          if (task.assigneeId.isNotEmpty) {
            return task;
          }
          return task.copyWith(assigneeId: memberId);
        })
        .where((task) {
          return task.status == TaskStatus.planned ||
              task.status == TaskStatus.inProgress;
        })
        .toList()
      ..sort((a, b) => b.startDate.compareTo(a.startDate));
  }

  void _syncTeamTaskSubscriptions() {
    final shouldWatchTasks = selectedIndex == 0 && _todoSub == 0;
    final teamInfo = _teamInfo;
    if (!shouldWatchTasks || teamInfo == null) {
      _selectedMemberTaskSub?.cancel();
      _selectedMemberTaskSub = null;
      _selectedMemberTaskSubUserId = null;
      for (final sub in _allMembersTaskSubs.values) {
        sub.cancel();
      }
      _allMembersTaskSubs.clear();
      return;
    }

    final activeMemberIds = teamInfo.activeMembers
        .map((m) => m.userId)
        .where((id) => id != widget.user.uid)
        .toSet();

    if (_selectedMemberId == null) {
      // "Tutti i task del team": ascolta i membri attivi (solo in questa vista)
      _selectedMemberTaskSub?.cancel();
      _selectedMemberTaskSub = null;
      _selectedMemberTaskSubUserId = null;

      final stale = _allMembersTaskSubs.keys
          .where((id) => !activeMemberIds.contains(id))
          .toList();
      for (final memberId in stale) {
        _allMembersTaskSubs.remove(memberId)?.cancel();
        _memberTasksCache.remove(memberId);
      }

      for (final memberId in activeMemberIds) {
        _allMembersTaskSubs.putIfAbsent(
          memberId,
          () => _teamRepository
              .watchMemberTasks(memberId, taskLimit: _taskQueryLimit)
              .listen((rawTasks) {
                if (!mounted) return;
                final tasks = _decodeMemberTasks(memberId, rawTasks);
                setState(() {
                  _memberTasksCache = {..._memberTasksCache, memberId: tasks};
                });
              }),
        );
      }
      return;
    }

    // Non serve ascoltare tutti i membri quando non siamo su "Tutti"
    for (final sub in _allMembersTaskSubs.values) {
      sub.cancel();
    }
    _allMembersTaskSubs.clear();

    if (_selectedMemberId == widget.user.uid) {
      _selectedMemberTaskSub?.cancel();
      _selectedMemberTaskSub = null;
      _selectedMemberTaskSubUserId = null;
      return;
    }

    final memberId = _selectedMemberId!;
    if (!activeMemberIds.contains(memberId)) {
      _selectedMemberTaskSub?.cancel();
      _selectedMemberTaskSub = null;
      _selectedMemberTaskSubUserId = null;
      _memberTasksCache.remove(memberId);
      return;
    }

    if (_selectedMemberTaskSubUserId == memberId &&
        _selectedMemberTaskSub != null) {
      return;
    }

    _selectedMemberTaskSub?.cancel();
    _selectedMemberTaskSubUserId = memberId;
    _selectedMemberTaskSub = _teamRepository
        .watchMemberTasks(memberId, taskLimit: _taskQueryLimit)
        .listen((rawTasks) {
          if (!mounted) return;
          final tasks = _decodeMemberTasks(memberId, rawTasks);
          setState(() {
            _memberTasksCache = {..._memberTasksCache, memberId: tasks};
          });
        });
  }

  void _onTaskPaginationChanged(int page, int pageSize) {
    final needed = ((page + 1) * pageSize + pageSize).clamp(
      120,
      _taskQueryLimitMax,
    );
    if (needed <= _taskQueryLimit) {
      return;
    }
    setState(() {
      _taskQueryLimit = needed;
      _workspaceStream = _repository.watchWorkspace(
        widget.user.uid,
        taskLimit: _taskQueryLimit,
      );
    });
    _syncTeamSubscriptions();
  }

  void _resetTaskPaginationWindow() {
    if (_taskQueryLimit == 120) {
      return;
    }
    setState(() {
      _taskQueryLimit = 120;
      _workspaceStream = _repository.watchWorkspace(
        widget.user.uid,
        taskLimit: _taskQueryLimit,
      );
    });
  }

  void _onTaskContextChanged() {
    _resetTaskPaginationWindow();
    _syncTeamSubscriptions();
  }

  bool _isTaskTabActive() => selectedIndex == 0 && _todoSub == 0;

  @override
  void initState() {
    super.initState();
    _workspaceStream = _repository.watchWorkspace(
      widget.user.uid,
      taskLimit: _taskQueryLimit,
    );
    visibleWeekStart = _startOfWeek(DateTime.now());
    _selectedMemberId = widget.user.uid;
    AnalyticsService.instance.setUser(widget.user.uid);
    AnalyticsService.instance.logScreen('task');
    _restoreUiState();
    _syncCrmSubscription();
    _restoreGoogleCalendarSession();
    // Start team stream
    _teamRepository.watchUserTeam(widget.user.uid).listen((teamInfo) {
      if (!mounted) return;
      setState(() => _teamInfo = teamInfo);
      if (teamInfo != null) {
        _loadMemberTimeTracks(teamInfo);
      }
    });
    unawaited(
      _pushTokenService.start(userId: widget.user.uid, repository: _repository),
    );
    unawaited(_cleanupBacklogTasksIfNeeded());
  }

  void _syncTeamTimeTrackSubscriptions() {
    final shouldWatchTracks = selectedIndex == 9;
    final teamInfo = _teamInfo;
    final selectedMemberId = _selectedMemberId;
    if (!shouldWatchTracks ||
        teamInfo == null ||
        selectedMemberId == null ||
        selectedMemberId == widget.user.uid) {
      for (final sub in _memberTimeTrackSubs.values) {
        sub.cancel();
      }
      _memberTimeTrackSubs.clear();
      return;
    }

    final activeMemberIds = teamInfo.activeMembers
        .map((m) => m.userId)
        .where((id) => id != widget.user.uid)
        .toSet();
    if (!activeMemberIds.contains(selectedMemberId)) {
      for (final sub in _memberTimeTrackSubs.values) {
        sub.cancel();
      }
      _memberTimeTrackSubs.clear();
      _memberTimeTracks.remove(selectedMemberId);
      return;
    }

    final stale = _memberTimeTrackSubs.keys
        .where((id) => id != selectedMemberId)
        .toList();
    for (final memberId in stale) {
      _memberTimeTrackSubs.remove(memberId)?.cancel();
    }

    _memberTimeTrackSubs.putIfAbsent(
      selectedMemberId,
      () => _teamRepository.watchMemberTimeTracks(selectedMemberId).listen((
        rawTracks,
      ) {
        if (!mounted) return;
        final tracks = rawTracks.map((m) {
          final id = m['id'] as String;
          final data = Map<String, dynamic>.from(m)..remove('id');
          return TimeTrack.fromMap(id, {...data, 'userId': selectedMemberId});
        }).toList();
        setState(() {
          _memberTimeTracks = {..._memberTimeTracks, selectedMemberId: tracks};
        });
      }),
    );
  }

  void _syncTeamSubscriptions() {
    _syncTeamTaskSubscriptions();
    _syncTeamTimeTrackSubscriptions();
  }

  bool get _isViewingOtherMember =>
      _selectedMemberId != null && _selectedMemberId != widget.user.uid;

  Future<void> _cleanupBacklogTasksIfNeeded() async {
    if (_backlogCleanupStarted) {
      return;
    }
    _backlogCleanupStarted = true;
    try {
      await _repository.deleteBacklogTasks(widget.user.uid);
    } catch (_) {
      // Pulizia non bloccante: se fallisce, la UI resta operativa.
    }
  }

  Future<void> _restoreGoogleCalendarSession() async {
    try {
      final account = await _googleCalendar.tryRestoreSession();
      if (!mounted) {
        return;
      }
      setState(() {
        _googleCalendarConnected = _googleCalendar.isConnected;
        _googleCalendarEmail = account?.email;
      });
    } catch (_) {
      // Ignora: la connessione puo essere effettuata manualmente.
    }
  }

  Future<void> _restoreUiState() async {
    try {
      final saved = await _repository.getUserUiState(widget.user.uid);
      if (!mounted || saved.isEmpty) {
        return;
      }
      final savedIndex = (saved['selectedIndex'] as num?)?.toInt();
      final savedTodo = (saved['todoSub'] as num?)?.toInt();
      final savedFinanze = (saved['finanzeSub'] as num?)?.toInt();
      setState(() {
        if (savedIndex != null && savedIndex >= 0 && savedIndex <= 12) {
          selectedIndex = savedIndex;
        }
        if (savedTodo != null && savedTodo >= 0 && savedTodo <= 2) {
          _todoSub = savedTodo;
        }
        if (savedFinanze != null && savedFinanze >= 0 && savedFinanze <= 2) {
          _finanzeSub = savedFinanze;
        }
      });
    } catch (_) {
      // Ignore and keep defaults
    } finally {
      _uiStateRestored = true;
      _syncCrmSubscription();
      _syncTeamSubscriptions();
    }
  }

  void _schedulePersistUiState() {
    if (!_uiStateRestored) {
      return;
    }
    _uiStateDebounce?.cancel();
    _uiStateDebounce = Timer(const Duration(milliseconds: 400), () {
      unawaited(
        _repository.saveUserUiState(
          widget.user.uid,
          selectedIndex: selectedIndex,
          todoSub: _todoSub,
          finanzeSub: _finanzeSub,
        ),
      );
    });
  }

  bool _needsCrmStream() {
    if (_detailType == 'company' ||
        _detailType == 'contact' ||
        _detailType == 'deal' ||
        _detailType == 'quotation' ||
        _detailType == 'product') {
      return true;
    }
    if (selectedIndex == 1 ||
        selectedIndex == 2 ||
        selectedIndex == 3 ||
        selectedIndex == 4 ||
        selectedIndex == 8 ||
        selectedIndex == 10) {
      return true;
    }
    if (selectedIndex == 6 && (_finanzeSub == 1 || _finanzeSub == 2)) {
      return true;
    }
    return false;
  }

  void _syncCrmSubscription() {
    final needsCrm = _needsCrmStream();
    if (needsCrm && _crmDataSubscription == null) {
      _crmDataSubscription = _crmRepository
          .watchCrmData(widget.user.uid)
          .listen((data) {
            if (mounted) {
              setState(() => _crmData = data);
            }
          });
      return;
    }
    if (!needsCrm && _crmDataSubscription != null) {
      _crmDataSubscription?.cancel();
      _crmDataSubscription = null;
    }
  }

  void _selectSection(int index) {
    final wasTaskTab = _isTaskTabActive();
    setState(() => selectedIndex = index);
    _syncCrmSubscription();
    _syncTeamSubscriptions();
    if (wasTaskTab && !_isTaskTabActive()) {
      _resetTaskPaginationWindow();
    }
    _schedulePersistUiState();
    const screens = [
      'todo',
      'societa',
      'contatti',
      'opportunita',
      'preventivi',
      'progetti',
      'finanze',
      'ticket',
      'prodotti',
      'segnatempo',
      'statistiche',
      'impostazioni',
      'archivio',
    ];
    if (index < screens.length) {
      AnalyticsService.instance.logScreen(screens[index]);
    }
  }

  Future<void> _seedWorkspace() async {
    await _bootstrapUserWorkspace(widget.user.uid);
    await AnalyticsService.instance.logSeedWorkspace();
  }

  Future<void> _bootstrapUserWorkspace(String userId) async {
    await _repository.seedWorkspace(userId);
    await _crmRepository.seedCrmData(
      userId,
      buildDemoWorkspace(userId).companies,
    );
  }

  void _ensureWorkspaceBootstrap(WorkspaceSnapshot workspace) {
    if (!workspace.isEmpty || _workspaceBootstrapStarted) {
      return;
    }
    _workspaceBootstrapStarted = true;
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted) {
        return;
      }
      setState(() {
        _workspaceBootstrapInProgress = true;
        _workspaceBootstrapError = null;
      });
      unawaited(
        _seedWorkspace()
            .catchError((error, _) {
              if (!mounted) {
                return;
              }
              setState(() {
                _workspaceBootstrapError =
                    'Errore inizializzazione dati: $error';
              });
            })
            .whenComplete(() {
              if (!mounted) {
                return;
              }
              setState(() {
                _workspaceBootstrapInProgress = false;
              });
            }),
      );
    });
  }

  Future<void> _openCreateUserDialog() async {
    final rootContext = context;
    final emailController = TextEditingController();
    final passwordController = TextEditingController();
    final confirmController = TextEditingController();
    var creating = false;
    String? errorMessage;
    try {
      await showDialog<void>(
        context: context,
        builder: (dialogContext) => StatefulBuilder(
          builder: (modalContext, setModalState) => AlertDialog(
            title: const Text('Crea utente'),
            content: SizedBox(
              width: 420,
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text(
                    'Crea un nuovo account operatore con email e password.',
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: emailController,
                    keyboardType: TextInputType.emailAddress,
                    decoration: const InputDecoration(
                      labelText: 'Email',
                      border: OutlineInputBorder(),
                    ),
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: passwordController,
                    obscureText: true,
                    decoration: const InputDecoration(
                      labelText: 'Password',
                      border: OutlineInputBorder(),
                    ),
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: confirmController,
                    obscureText: true,
                    decoration: const InputDecoration(
                      labelText: 'Conferma password',
                      border: OutlineInputBorder(),
                    ),
                  ),
                  if (errorMessage != null) ...[
                    const SizedBox(height: 10),
                    Text(
                      errorMessage!,
                      style: const TextStyle(color: Color(0xFF9F1239)),
                    ),
                  ],
                ],
              ),
            ),
            actions: [
              TextButton(
                onPressed: creating
                    ? null
                    : () => Navigator.of(dialogContext).pop(),
                child: const Text('Annulla'),
              ),
              FilledButton(
                onPressed: creating
                    ? null
                    : () async {
                        final email = emailController.text.trim();
                        final password = passwordController.text.trim();
                        final confirm = confirmController.text.trim();
                        if (email.isEmpty ||
                            password.isEmpty ||
                            confirm.isEmpty) {
                          setModalState(() {
                            errorMessage = 'Compila tutti i campi.';
                          });
                          return;
                        }
                        if (password.length < 6) {
                          setModalState(() {
                            errorMessage =
                                'La password deve avere almeno 6 caratteri.';
                          });
                          return;
                        }
                        if (password != confirm) {
                          setModalState(() {
                            errorMessage = 'Le password non coincidono.';
                          });
                          return;
                        }
                        setModalState(() {
                          creating = true;
                          errorMessage = null;
                        });
                        // Crea utente via Firebase Auth REST API
                        // (no secondary app — funziona su web)
                        try {
                          final apiKey = Firebase.app().options.apiKey;
                          final uri = Uri.parse(
                            'https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=$apiKey',
                          );
                          final response = await http.post(
                            uri,
                            headers: {'Content-Type': 'application/json'},
                            body: jsonEncode({
                              'email': email,
                              'password': password,
                              'returnSecureToken': true,
                            }),
                          );
                          final body =
                              jsonDecode(response.body) as Map<String, dynamic>;
                          if (response.statusCode == 200) {
                            final createdUid = body['localId'] as String?;
                            if (createdUid != null) {
                              await _bootstrapUserWorkspace(createdUid);
                            }
                            if (!mounted) return;
                            if (dialogContext.mounted)
                              Navigator.of(dialogContext).pop();
                            ScaffoldMessenger.of(rootContext).showSnackBar(
                              SnackBar(
                                content: Text(
                                  'Utente creato e dati iniziali caricati: $email',
                                ),
                              ),
                            );
                          } else {
                            final errCode =
                                (body['error'] as Map?)?['message']
                                    as String? ??
                                'Errore sconosciuto';
                            setModalState(() {
                              creating = false;
                              errorMessage = errCode.contains('EMAIL_EXISTS')
                                  ? 'Email già in uso.'
                                  : 'Errore: $errCode';
                            });
                          }
                        } catch (_) {
                          setModalState(() {
                            creating = false;
                            errorMessage = 'Errore di rete.';
                          });
                        }
                      },
                child: creating
                    ? const SizedBox(
                        height: 18,
                        width: 18,
                        child: CircularProgressIndicator(strokeWidth: 2),
                      )
                    : const Text('Crea utente'),
              ),
            ],
          ),
        ),
      );
    } finally {
      emailController.dispose();
      passwordController.dispose();
      confirmController.dispose();
    }
  }

  Future<void> _connectGoogleCalendar() async {
    setState(() => _googleCalendarBusy = true);
    try {
      final account = await _googleCalendar.connect();
      if (!mounted) {
        return;
      }
      setState(() {
        _googleCalendarConnected = _googleCalendar.isConnected;
        _googleCalendarEmail = account?.email;
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            _googleCalendarConnected
                ? 'Google Calendar collegato.'
                : 'Connessione Google annullata.',
          ),
        ),
      );
    } catch (error) {
      if (!mounted) {
        return;
      }
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(_googleCalendarErrorMessage(error))),
      );
    } finally {
      if (mounted) {
        setState(() => _googleCalendarBusy = false);
      }
    }
  }

  Future<void> _disconnectGoogleCalendar() async {
    setState(() => _googleCalendarBusy = true);
    try {
      await _googleCalendar.disconnect();
      if (!mounted) {
        return;
      }
      setState(() {
        _googleCalendarConnected = false;
        _googleCalendarEmail = null;
      });
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Google Calendar disconnesso.')),
      );
    } catch (error) {
      if (!mounted) {
        return;
      }
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('Errore disconnessione: $error')));
    } finally {
      if (mounted) {
        setState(() => _googleCalendarBusy = false);
      }
    }
  }

  Future<void> _syncPlanningToGoogleCalendar(
    WorkspaceSnapshot workspace, {
    bool showFeedback = true,
    bool setBusy = true,
  }) async {
    if (!_googleCalendarConnected) {
      if (showFeedback) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Collega prima un account Google.')),
        );
      }
      return;
    }

    if (setBusy) {
      setState(() => _googleCalendarBusy = true);
    }
    try {
      const calendarId = 'primary';
      final tasksById = {for (final task in workspace.tasks) task.id: task};
      final existingMap = await _repository.getGoogleCalendarSlotEventMap(
        widget.user.uid,
      );
      final activeSlotIds = workspace.plannedSlots
          .map((slot) => slot.id)
          .toSet();

      for (final slot in workspace.plannedSlots) {
        final task = tasksById[slot.taskId];
        final start = _slotStartDateTime(slot);
        final end = start.add(_durationFromHours(slot.plannedHours));
        final title = task?.name ?? 'Task pianificato';
        final eventId = await _googleCalendar.upsertEvent(
          calendarId: calendarId,
          eventId: existingMap[slot.id],
          title: title,
          description: 'Gussoni slotId=${slot.id}',
          start: start,
          end: end,
        );
        await _repository.setGoogleCalendarSlotEvent(
          widget.user.uid,
          slotId: slot.id,
          eventId: eventId,
        );
      }

      for (final entry in existingMap.entries) {
        if (activeSlotIds.contains(entry.key)) {
          continue;
        }
        await _googleCalendar.deleteEvent(
          calendarId: calendarId,
          eventId: entry.value,
        );
        await _repository.deleteGoogleCalendarSlotEvent(
          widget.user.uid,
          slotId: entry.key,
        );
      }

      if (!mounted) {
        return;
      }
      if (showFeedback) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              'Sincronizzazione completata: ${workspace.plannedSlots.length} slot.',
            ),
          ),
        );
      }
    } catch (error) {
      if (!mounted) {
        return;
      }
      if (showFeedback) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text(_googleCalendarErrorMessage(error))),
        );
      }
    } finally {
      if (setBusy && mounted) {
        setState(() => _googleCalendarBusy = false);
      }
    }
  }

  void _syncPlanningAfterChange(WorkspaceSnapshot workspace) {
    if (!_googleCalendarConnected) {
      return;
    }
    _pendingGoogleSyncWorkspace = workspace;
    _googleSyncDebounce?.cancel();
    _googleSyncDebounce = Timer(const Duration(milliseconds: 500), () {
      final pending = _pendingGoogleSyncWorkspace;
      if (pending == null || !mounted) {
        return;
      }
      _pendingGoogleSyncWorkspace = null;
      unawaited(
        _syncPlanningToGoogleCalendar(
          pending,
          showFeedback: false,
          setBusy: false,
        ),
      );
    });
  }

  @override
  void dispose() {
    _crmDataSubscription?.cancel();
    _uiStateDebounce?.cancel();
    _googleSyncDebounce?.cancel();
    for (final sub in _memberTimeTrackSubs.values) {
      sub.cancel();
    }
    _selectedMemberTaskSub?.cancel();
    for (final sub in _allMembersTaskSubs.values) {
      sub.cancel();
    }
    unawaited(_pushTokenService.stop());
    super.dispose();
  }

  String _googleCalendarErrorMessage(Object error) {
    final raw = error.toString();
    final lower = raw.toLowerCase();
    if (lower.contains('origin_mismatch') ||
        lower.contains('idpiframe_initialization_failed')) {
      return 'Google OAuth: origin non autorizzata. Aggiungi l\'URL corrente negli Authorized JavaScript origins del client OAuth.';
    }
    if (lower.contains('access_denied') || lower.contains('popup_closed')) {
      return 'Autorizzazione Google annullata o popup bloccato.';
    }
    if (lower.contains('calendar') && lower.contains('api')) {
      return 'Google Calendar API non abilitata o permessi insufficienti.';
    }
    return 'Errore Google Calendar: $raw';
  }

  Future<void> _moveSlot(
    WorkspaceSnapshot workspace,
    TimelineSlot slot,
    DateTime newDate,
    double newStartHour,
  ) async {
    final updatedSlot = slot.copyWith(
      date: DateTime(newDate.year, newDate.month, newDate.day),
      startHour: newStartHour,
    );
    await _repository.updateTimelineSlot(widget.user.uid, updatedSlot);
    await AnalyticsService.instance.logTimelineSlotMoved();
    final nextSlots = workspace.plannedSlots
        .map((item) => item.id == slot.id ? updatedSlot : item)
        .toList();
    _syncPlanningAfterChange(workspace.copyWith(plannedSlots: nextSlots));
  }

  Future<void> _resizeTaskEstimate(
    WorkspaceSnapshot workspace,
    TimelineSlot slot,
    double delta,
  ) async {
    final resizedHours = (slot.plannedHours + delta)
        .clamp(0.5, 200.0)
        .toDouble();
    final updatedSlot = slot.copyWith(plannedHours: resizedHours);
    await _repository.updateTimelineSlot(widget.user.uid, updatedSlot);
    await AnalyticsService.instance.logTimelineSlotResized();
    final nextSlots = workspace.plannedSlots
        .map((item) => item.id == slot.id ? updatedSlot : item)
        .toList();
    _syncPlanningAfterChange(workspace.copyWith(plannedSlots: nextSlots));
  }

