                            selected: _finanzeSub,
                            onChanged: (i) {
                              setState(() {
                                _finanzeSub = i;
                                _detailType = null;
                                _detailEntity = null;
                              });
                              _syncCrmSubscription();
                              _syncTeamSubscriptions();
                              _schedulePersistUiState();
                            },
