                      ),
                      // 5 – Preventivi
                    ] else if (selectedIndex == 4) ...[
                      const _SectionTitle(
                        title: 'Preventivi',
                        subtitle:
                            'Crea e invia preventivi ai clienti con righe e IVA.',
                      ),
                      const SizedBox(height: 16),
                      PreventiviCard(
                        crmData: _crmData,
                        companies: workspace.companies,
                        crmRepo: _crmRepository,
                        userId: widget.user.uid,
                        onOpenDetail: (q) => _openDetail('quotation', q),
                      ),
                      // 6 – Progetti
                    ] else if (selectedIndex == 5) ...[
                      const _SectionTitle(
                        title: 'Progetti',
                        subtitle:
                            'Progetti con fasi, task collegati e time tracking.',
                      ),
                      const SizedBox(height: 16),
                      ProgettiCard(
                        workspace: workspace,
                        onAddProject: () =>
                            _openProjectDialog(context, workspace),
