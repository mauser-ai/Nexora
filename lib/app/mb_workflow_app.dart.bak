  Future<void> _scheduleTaskOnDay(
    WorkspaceSnapshot workspace,
    WorkTask task,
    DateTime startDate,
    double startHour,
    double durationHours,
  ) async {
    final normalizedDate = DateTime(
      startDate.year,
      startDate.month,
      startDate.day,
    );
    final normalizedStartHour = _normalizeStartHourForDay(
      startHour: startHour,
      durationHours: durationHours,
    );
    final normalizedDuration = durationHours.clamp(0.5, 12.0).toDouble();
    final updatedTask = task.status == TaskStatus.backlog
        ? task.copyWith(status: TaskStatus.planned)
        : task;
    final newSlot = TimelineSlot(
      id: 'slot-${task.id}-${DateTime.now().microsecondsSinceEpoch}',
      taskId: task.id,
      date: normalizedDate,
      plannedHours: normalizedDuration,
      startHour: normalizedStartHour,
    );

    if (updatedTask != task) {
      await _repository.updateTask(widget.user.uid, updatedTask);
    }
    await _repository.updateTimelineSlot(widget.user.uid, newSlot);
    final nextTasks = workspace.tasks
        .map((item) => item.id == updatedTask.id ? updatedTask : item)
        .toList();
    _syncPlanningAfterChange(
      workspace.copyWith(
        tasks: nextTasks,
        plannedSlots: [...workspace.plannedSlots, newSlot],
      ),
    );
  }

  Future<void> _repeatTaskUntilDeadlineFromSlot(
    WorkspaceSnapshot workspace,
    WorkTask task,
    TimelineSlot baseSlot,
  ) async {
    final startDate = DateTime(
      baseSlot.date.year,
      baseSlot.date.month,
      baseSlot.date.day,
    );
    final deadline = DateTime(
      task.deadline.year,
      task.deadline.month,
      task.deadline.day,
    );
    if (!deadline.isAfter(startDate)) {
      return;
    }

    final existingKeys = workspace.plannedSlots
        .where((slot) => slot.taskId == task.id)
        .map(
          (slot) =>
              '${slot.date.year}-${slot.date.month}-${slot.date.day}-${slot.startHour.toStringAsFixed(2)}',
        )
        .toSet();

    final newSlots = <TimelineSlot>[];
    var cursor = startDate.add(const Duration(days: 1));
    while (!cursor.isAfter(deadline)) {
      final normalizedDate = DateTime(cursor.year, cursor.month, cursor.day);
      final availability = workspace.availability.firstWhere(
        (entry) => entry.weekday == normalizedDate.weekday,
        orElse: () => const UserAvailability(weekday: 0, hours: 0, isOff: true),
      );
      final isBlocked =
          availability.isOff ||
          _isVacationDay(workspace.vacations, normalizedDate);
      if (!isBlocked) {
        final key =
            '${normalizedDate.year}-${normalizedDate.month}-${normalizedDate.day}-${baseSlot.startHour.toStringAsFixed(2)}';
        if (!existingKeys.contains(key)) {
          final nextSlot = TimelineSlot(
            id: 'slot-${task.id}-${normalizedDate.microsecondsSinceEpoch}',
            taskId: task.id,
            date: normalizedDate,
            plannedHours: baseSlot.plannedHours,
            startHour: _normalizeStartHourForDay(
              startHour: baseSlot.startHour,
              durationHours: baseSlot.plannedHours,
            ),
          );
          newSlots.add(nextSlot);
          existingKeys.add(key);
        }
      }
      cursor = cursor.add(const Duration(days: 1));
    }

    await _repository.upsertTimelineSlots(widget.user.uid, newSlots);

    if (newSlots.isEmpty) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text(
              'Nessun giorno disponibile trovato fino alla scadenza.',
            ),
          ),
        );
      }
      return;
    }

    _syncPlanningAfterChange(
      workspace.copyWith(
        plannedSlots: [...workspace.plannedSlots, ...newSlots],
      ),
    );
    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Aggiunti ${newSlots.length} slot fino alla scadenza.'),
        ),
      );
    }
  }

