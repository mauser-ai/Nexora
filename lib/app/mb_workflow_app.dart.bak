  Future<void> _exportInvoiceXml(
    BuildContext context,
    WorkspaceSnapshot workspace,
    InvoiceDraft invoice,
  ) async {
    final details = await _repository.getInvoiceDetails(
      widget.user.uid,
      invoice.id,
    );
    if (details == null) {
      if (!context.mounted) {
        return;
      }
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Dettagli fattura non trovati.')),
      );
      return;
    }
    final company = _firstWhereOrNull(
      workspace.companies,
      (item) => item.id == invoice.companyId,
    );
    if (company == null) {
      if (!context.mounted) {
        return;
      }
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Cliente non trovato in anagrafica.')),
      );
      return;
    }
    if (!workspace.billingProfile.isConfigured) {
      if (!context.mounted) {
        return;
      }
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Compila i dati emittente in Impostazioni prima di esportare XML.',
          ),
        ),
      );
      return;
    }

    final xml = buildFatturaPaXml(
      invoice: invoice,
      invoiceDetails: details,
      seller: workspace.billingProfile,
      customer: company,
    );
    if (!context.mounted) {
      return;
    }
    await showDialog<void>(
      context: context,
      builder: (context) => AlertDialog(
        title: Text('XML ${invoice.number}'),
        content: SizedBox(
          width: 820,
          child: SingleChildScrollView(child: SelectableText(xml)),
        ),
        actions: [
          TextButton(
            onPressed: () async {
              await Clipboard.setData(ClipboardData(text: xml));
              if (!context.mounted) {
                return;
              }
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(content: Text('XML copiato negli appunti.')),
              );
            },
            child: const Text('Copia XML'),
          ),
          FilledButton(
            onPressed: () async {
              await _repository.saveInvoice(
                widget.user.uid,
                invoice: invoice.copyWith(status: InvoiceStatus.exported),
              );
              if (!context.mounted) {
                return;
              }
              Navigator.of(context).pop();
            },
            child: const Text('Segna esportata'),
          ),
        ],
      ),
    );
  }

  Future<void> _emitInvoiceYoudoxDraft(
    BuildContext context,
    WorkspaceSnapshot workspace,
    InvoiceDraft invoice,
  ) async {
    final details = await _repository.getInvoiceDetails(
      widget.user.uid,
      invoice.id,
    );
    if (details == null) {
      if (!context.mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Dettagli fattura non trovati.')),
      );
      return;
    }

    final company = _firstWhereOrNull(
      workspace.companies,
      (item) => item.id == invoice.companyId,
    );
    if (company == null) {
      if (!context.mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Cliente non trovato in anagrafica.')),
      );
      return;
    }
    final xml = buildFatturaPaXml(
      invoice: invoice,
      invoiceDetails: details,
      seller: workspace.billingProfile,
      customer: company,
    );
    final ts = DateTime.now();
    final stamp =
        '${ts.year.toString().padLeft(4, '0')}${ts.month.toString().padLeft(2, '0')}${ts.day.toString().padLeft(2, '0')}${ts.hour.toString().padLeft(2, '0')}${ts.minute.toString().padLeft(2, '0')}${ts.second.toString().padLeft(2, '0')}';
    final safeNumber = invoice.number.replaceAll(
      RegExp(r'[^A-Za-z0-9._-]'),
      '_',
    );
    final filename =
        '${safeNumber.isEmpty ? invoice.id : safeNumber}_$stamp.xml';

    final youdoxConfig = await _repository.getYoudoxConfig(widget.user.uid);
    if (!youdoxConfig.isConfigured) {
      if (!context.mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Credenziali YouDOX non configurate. Vai in Impostazioni > Configurazione YouDOX.',
          ),
        ),
      );
      return;
    }

    try {
      final result = await _youdox.createDraftFromXml(
        xml: xml,
        filename: filename,
        credentials: youdoxConfig,
      );
      await _repository.saveInvoice(
        widget.user.uid,
        invoice: invoice,
        details: <String, dynamic>{
          'youdox': <String, dynamic>{
            'lastDraftAt': FieldValue.serverTimestamp(),
            'filename': result.filename,
            'message': result.message,
          },
        },
      );
      if (!context.mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            result.message.isNotEmpty
                ? 'Bozza creata su YouDOX (${result.filename}): ${result.message}'
                : 'Bozza creata su YouDOX (${result.filename}).',
          ),
        ),
      );
    } catch (error) {
      if (!context.mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Errore creazione bozza YouDOX: $error')),
      );
    }
  }

