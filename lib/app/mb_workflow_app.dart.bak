class _YouDoxSettingsCardState extends State<YouDoxSettingsCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _username;
  late final TextEditingController _password;
  late final TextEditingController _clientId;
  bool _obscurePassword = true;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    _username = TextEditingController(text: widget.config.username);
    _password = TextEditingController(text: widget.config.password);
    _clientId = TextEditingController(text: widget.config.clientId);
  }

  @override
  void dispose() {
    _username.dispose();
    _password.dispose();
    _clientId.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
