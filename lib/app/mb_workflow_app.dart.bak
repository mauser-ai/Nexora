                      ),
                      // 9 – Prodotti
                    ] else if (selectedIndex == 8) ...[
                      const _SectionTitle(
                        title: 'Prodotti',
                        subtitle:
                            'Catalogo prodotti e servizi con prezzi, SKU e categorie.',
                      ),
                      const SizedBox(height: 16),
                      ProdottiCard(
                        crmData: _crmData,
                        crmRepo: _crmRepository,
                        userId: widget.user.uid,
                        onOpenDetail: (p) => _openDetail('product', p),
                      ),
                      // 10 – Segnatempo
                    ] else if (selectedIndex == 9) ...[
                      // Segnatempo con selettore membro team
                      Row(
                        children: [
                          const Expanded(
                            child: _SectionTitle(
                              title: 'Segnatempo',
                              subtitle: 'Traccia i tempi per task e progetto.',
                            ),
                          ),
                          if (_teamInfo != null &&
                              _teamInfo!.activeMembers.length > 1) ...[
                            const SizedBox(width: 16),
                            _TeamMemberSelector(
                              members: _teamInfo!.activeMembers,
                              currentUserId: widget.user.uid,
                              selectedId: _selectedMemberId ?? widget.user.uid,
                              onChanged: (id) {
                                setState(() => _selectedMemberId = id);
                                _syncTeamSubscriptions();
                              },
                            ),
                          ],
                        ],
                      ),
                      const SizedBox(height: 16),
                      TimeTrackingBoard(
                        workspace: _workspaceForSelectedMember(workspace),
                        visibleWeekStart: visibleWeekStart,
                        onShiftWeek: _shiftWeek,
                        // Read-only quando si visualizza un altro membro
                        onAddTrackForDay: _isViewingOtherMember
                            ? null
                            : (day) => _openTimeTrackDialog(
                                context,
                                workspace,
                                date: day,
                              ),
                        onEditTrack: _isViewingOtherMember
                            ? null
                            : (track) => _openTimeTrackDialog(
                                context,
                                workspace,
                                track: track,
                              ),
                        onDeleteTrack: _isViewingOtherMember
                            ? null
                            : _deleteTimeTrack,
                      ),
                      // 11 – Statistiche
                    ] else if (selectedIndex == 10) ...[
                      const _SectionTitle(
                        title: 'Statistiche',
                        subtitle:
                            'Monitor operativo: opportunità, abbonamenti, segnatempo, fatture e conto economico.',
                      ),
                      const SizedBox(height: 16),
                      OperationalMonitorStatsCard(
                        workspace: workspace,
                        crmData: _crmData,
                      ),
                      // 11 – Impostazioni
                    ] else if (selectedIndex == 11) ...[
                      SizedBox(
                        height: MediaQuery.of(context).size.height - 120,
                        child: SettingsPageContent(
                          workspace: workspace,
                          userId: widget.user.uid,
                          userEmail: widget.user.email ?? '',
                          teamInfo: _teamInfo,
                          repository: _repository,
                          onUpdateBillingProfile: _updateBillingProfile,
                          onUpdateYoudoxConfig: _updateYoudoxConfig,
                          onUpdateEmailSignatureHtml: _updateEmailSignatureHtml,
                          onToggleAvailability: (entry, value) =>
                              _toggleAvailability(workspace, entry, value),
                          onCreateVacation: (v) => _createVacation(workspace, v),
                          onDeleteVacation: (v) => _deleteVacation(workspace, v),
                          onOpenCreateUserDialog: _openCreateUserDialog,
                          onRemoveTeamMember: _teamInfo != null
                              ? (memberId) => _removeTeamMember(_teamInfo!, memberId)
                              : null,
                        ),
                      ),
                      // 12 – Archivio
                    ] else if (selectedIndex == 12) ...[
                      const _SectionTitle(
                        title: 'Archivio',
                        subtitle:
                            'File manager a cartelle clienti con upload e drag and drop.',
                      ),
                      const SizedBox(height: 16),
                      SizedBox(
                        height: 680,
                        child: ArchiveManagerCard(workspace: workspace),
                      ),
                    ],
                  ],
                ),
              );

        return LayoutBuilder(
          builder: (context, constraints) {
            final isCompact = constraints.maxWidth < 960;

            if (isCompact) {
              return MobileWorkspaceScaffold(
                workspace: workspace,
                currentUserName: widget.user.email ?? widget.user.uid,
                emailSignatureHtml: workspace.emailSignatureHtml,
                onCreateTicket: _createTicket,
                onUpdateTicket: _updateTicket,
                onEditTask: (task) async =>
                    _openTaskDialog(context, workspace, task: task),
                onLogTime: (task) async =>
                    _openTimeTrackDialog(context, workspace, task: task),
                onToggleTaskDone: _toggleTaskDone,
                onDeleteTimelineSlot: (slot) =>
                    _deleteTimelineSlot(workspace, slot),
                onRepeatTaskUntilDeadline: (task, slot) =>
                    _repeatTaskUntilDeadlineFromSlot(workspace, task, slot),
                onAddTask: () => _openTaskDialog(context, workspace),
              );
            }

            return Scaffold(
              body: Row(
                children: [
                  Container(
                    width: 195,
                    color: GussoniBrand.sidebarColor,
                    child: SafeArea(
                      child: Padding(
                        padding: const EdgeInsets.fromLTRB(12, 14, 12, 14),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.stretch,
                          children: [
                            _SidebarLogo(),
                            const SizedBox(height: 28),
                            Expanded(
                              child: SingleChildScrollView(
                                child: Column(
                                  crossAxisAlignment:
                                      CrossAxisAlignment.stretch,
                                  children: List.generate(railItems.length, (
                                    index,
                                  ) {
                                    final item = railItems[index];
                                    final selected = selectedIndex == index;
                                    return Column(
                                      crossAxisAlignment:
                                          CrossAxisAlignment.stretch,
                                      children: [
                                        Padding(
                                          padding: const EdgeInsets.only(bottom: 2),
                                          child: _SidebarNavButton(
                                            label: item.label,
                                            icon: selected
                                                ? item.activeIcon
                                                : item.icon,
                                            selected: selected,
                                            onTap: () => _selectSection(index),
                                          ),
                                        ),
                                        _TodoSidebarSubmenu(
                                          visible: index == 0 && selected,
                                          todoSub: _todoSub,
                                          onSelect: (i) {
                                            setState(() {
                                              _todoSub = i;
                                              _detailType = null;
                                              _detailEntity = null;
                                            });
                                            _syncCrmSubscription();
                                            _onTaskContextChanged();
                                            _schedulePersistUiState();
                                          },
                                        ),
                                        _FinanzeSidebarSubmenu(
                                          visible: index == 6 && selected,
                                          finanzeSub: _finanzeSub,
                                          onSelect: (i) {
                                            setState(() {
                                              _finanzeSub = i;
                                              _detailType = null;
                                              _detailEntity = null;
                                            });
                                            _syncCrmSubscription();
                                            _syncTeamSubscriptions();
                                            _schedulePersistUiState();
                                          },
                                        ),
                                      ],
                                    );
                                  }),
                                ),
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),
                  Expanded(
                    child: Column(
                      children: [
                        SafeArea(
                          bottom: false,
                          child: Padding(
                            padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
                            child: Row(
                              children: [
                                const Spacer(),
                                OutlinedButton.icon(
                                  onPressed: FirebaseAuth.instance.signOut,
                                  icon: const Icon(Icons.logout),
                                  label: const Text('Logout'),
                                ),
                              ],
                            ),
                          ),
                        ),
                        Expanded(child: content),
                      ],
                    ),
                  ),
                ],
              ),
            );
          },
        );
      },
    );
  }
}

// Dettaglio ticket minimale aperto da TicketListCard
class _TicketDetailWrapper extends StatefulWidget {
  const _TicketDetailWrapper({
    required this.ticket,
    required this.workspace,
    required this.currentUserName,
    required this.onUpdateTicket,
    required this.emailSignatureHtml,
  });
  final Ticket ticket;
  final WorkspaceSnapshot workspace;
  final String currentUserName;
  final Future<void> Function(Ticket) onUpdateTicket;
  final String emailSignatureHtml;
  @override
  State<_TicketDetailWrapper> createState() => _TicketDetailWrapperState();
}

class _TicketDetailWrapperState extends State<_TicketDetailWrapper> {
  final _composerCtrl = TextEditingController();
  bool _sending = false;
  late Ticket _ticket;

  @override
  void initState() {
    super.initState();
    _ticket = widget.ticket;
  }

  @override
  void dispose() {
    _composerCtrl.dispose();
    super.dispose();
  }

  String _companyName() =>
      widget.workspace.companies
          .where((c) => c.id == _ticket.companyId)
          .firstOrNull
          ?.name ??
      '';
  Color _statusColor(TicketStatus s) {
    switch (s) {
      case TicketStatus.newTicket:
        return const Color(0xFF0369A1);
      case TicketStatus.open:
        return GussoniBrand.primary;
      case TicketStatus.waitingCustomer:
        return const Color(0xFFD97706);
      case TicketStatus.closed:
        return const Color(0xFF7D89A8);
    }
  }

  String _statusLabel(TicketStatus s) {
    switch (s) {
      case TicketStatus.newTicket:
        return 'Nuovo';
      case TicketStatus.open:
        return 'Aperto';
      case TicketStatus.waitingCustomer:
        return 'In attesa';
      case TicketStatus.closed:
        return 'Chiuso';
    }
  }

  Future<void> _sendNote(bool isPublic) async {
    final body = _composerCtrl.text.trim();
    if (body.isEmpty) return;
    setState(() => _sending = true);
    final entry = TicketEntry(
      id: 'te-${DateTime.now().microsecondsSinceEpoch}',
      type: isPublic
          ? TicketEntryType.outboundEmail
          : TicketEntryType.internalNote,
      body: body,
      createdAt: DateTime.now(),
      authorName: widget.currentUserName,
    );
    final updated = _ticket.copyWith(
      updatedAt: DateTime.now(),
      status: isPublic ? TicketStatus.waitingCustomer : _ticket.status,
      entries: [..._ticket.entries, entry],
    );
    await widget.onUpdateTicket(updated);
    setState(() {
      _ticket = updated;
      _sending = false;
    });
    _composerCtrl.clear();
  }

  @override
  Widget build(BuildContext context) {
    final entries = [..._ticket.entries]
      ..sort((a, b) => a.createdAt.compareTo(b.createdAt));
    final company = _companyName();
    return Column(
      children: [
        // Header
        Container(
          padding: const EdgeInsets.fromLTRB(20, 16, 12, 16),
          decoration: const BoxDecoration(
            color: const Color(0xFF0E1020),
            border: Border(bottom: BorderSide(color: Color(0xFF1E2130))),
          ),
          child: Row(
            children: [
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      _ticket.title,
                      style: const TextStyle(
                        fontSize: 17,
                        fontWeight: FontWeight.w800,
                        color: Color(0xFFE4E8FF),
                      ),
                    ),
                    if (company.isNotEmpty)
                      Text(
                        company,
                        style: const TextStyle(
                          fontSize: 13,
                          color: Color(0xFF7D89A8),
                        ),
                      ),
                  ],
                ),
              ),
              const SizedBox(width: 12),
              Container(
                padding: const EdgeInsets.symmetric(
                  horizontal: 10,
                  vertical: 4,
                ),
                decoration: BoxDecoration(
                  borderRadius: BorderRadius.circular(999),
                  color: _statusColor(_ticket.status).withValues(alpha: 0.10),
                  border: Border.all(
                    color: _statusColor(_ticket.status).withValues(alpha: 0.35),
                  ),
                ),
                child: Text(
                  _statusLabel(_ticket.status),
                  style: TextStyle(
                    fontSize: 12,
                    fontWeight: FontWeight.w700,
                    color: _statusColor(_ticket.status),
                  ),
                ),
              ),
              const SizedBox(width: 8),
              IconButton(
                onPressed: () => Navigator.of(context).pop(),
                icon: const Icon(
                  Icons.close,
                  size: 20,
                  color: Color(0xFF525D78),
                ),
              ),
            ],
          ),
        ),
        // Messages
        Expanded(
          child: ListView.builder(
            padding: const EdgeInsets.all(16),
            itemCount: entries.length,
            itemBuilder: (_, i) {
              final e = entries[i];
              final outbound = e.type == TicketEntryType.outboundEmail;
              final internal = e.type == TicketEntryType.internalNote;
              return Align(
                alignment: outbound
                    ? Alignment.centerRight
                    : Alignment.centerLeft,
                child: Container(
                  margin: const EdgeInsets.only(bottom: 10),
                  constraints: BoxConstraints(
                    maxWidth: MediaQuery.of(context).size.width * 0.6,
                  ),
                  padding: const EdgeInsets.fromLTRB(14, 10, 14, 10),
                  decoration: BoxDecoration(
                    color: internal
                        ? const Color(0xFFFEF9C3)
                        : outbound
                        ? const Color(0xFFDCFCE7)
                        : Colors.white,
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: const Color(0xFF1E2130)),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Text(
                            internal
                                ? '📝 Nota interna'
                                : outbound
                                ? 'Tu'
                                : e.authorName.isNotEmpty
                                ? e.authorName
                                : 'Cliente',
                            style: const TextStyle(
                              fontSize: 11,
                              fontWeight: FontWeight.w800,
                              color: Color(0xFFB8C0D8),
                            ),
                          ),
                          const Spacer(),
                          Text(
                            DateFormat('dd/MM HH:mm').format(e.createdAt),
                            style: const TextStyle(
                              fontSize: 10,
                              color: Color(0xFF525D78),
                            ),
                          ),
                        ],
                      ),
                      const SizedBox(height: 4),
                      Text(
                        e.body,
                        style: const TextStyle(
                          fontSize: 13,
                          color: Color(0xFFB8C0D8),
                          height: 1.4,
                        ),
                      ),
                    ],
                  ),
                ),
              );
            },
          ),
        ),
        // Composer
        Container(
          padding: const EdgeInsets.all(14),
          decoration: const BoxDecoration(
            color: Color(0xFF080A14),
            border: Border(top: BorderSide(color: Color(0xFF1E2130))),
          ),
          child: Row(
            children: [
              Expanded(
                child: TextField(
                  controller: _composerCtrl,
                  maxLines: 3,
                  minLines: 1,
                  decoration: const InputDecoration(
                    hintText: 'Scrivi un messaggio o nota interna...',
                    fillColor: const Color(0xFF0A0C18),
                    filled: true,
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.all(Radius.circular(10)),
                    ),
                    contentPadding: EdgeInsets.symmetric(
                      horizontal: 14,
                      vertical: 10,
                    ),
                  ),
                ),
              ),
              const SizedBox(width: 10),
              Column(
                children: [
                  FilledButton(
                    onPressed: _sending ? null : () => _sendNote(true),
                    child: const Text('Rispondi'),
                  ),
                  const SizedBox(height: 6),
                  OutlinedButton(
                    onPressed: _sending ? null : () => _sendNote(false),
                    child: const Text('Nota interna'),
                  ),
                ],
              ),
            ],
          ),
        ),
      ],
    );
  }
}

class EmptyWorkspaceCard extends StatelessWidget {
  const EmptyWorkspaceCard({
    super.key,
    this.isLoading = true,
    this.errorMessage,
  });

  final bool isLoading;
  final String? errorMessage;

  @override
  Widget build(BuildContext context) {
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(24),
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 520),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              if (isLoading)
                const SizedBox(
                  width: 26,
                  height: 26,
                  child: CircularProgressIndicator(strokeWidth: 2.4),
                )
              else
                Icon(
                  Icons.check_circle_outline,
                  size: 26,
                  color: GussoniBrand.primary,
                ),
              const SizedBox(height: 12),
              Text(
                isLoading
                    ? 'Sto preparando i dati iniziali...'
                    : 'Inizializzazione completata.',
                textAlign: TextAlign.center,
                style: const TextStyle(
                  fontSize: 14,
                  fontWeight: FontWeight.w700,
                  color: Color(0xFFB8C0D8),
                ),
              ),
              if (errorMessage != null) ...[
                const SizedBox(height: 10),
                Text(
                  errorMessage!,
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    fontSize: 12,
                    color: Color(0xFF9F1239),
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }
}

