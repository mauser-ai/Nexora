String _weekdayName(int weekday) {
  switch (weekday) {
    case DateTime.monday:
      return 'Lunedi';
    case DateTime.tuesday:
      return 'Martedi';
    case DateTime.wednesday:
      return 'Mercoledi';
    case DateTime.thursday:
      return 'Giovedi';
    case DateTime.friday:
      return 'Venerdi';
    case DateTime.saturday:
      return 'Sabato';
    case DateTime.sunday:
      return 'Domenica';
    default:
      return 'Sconosciuto';
  }
}

String _shortDate(DateTime date) => '${date.day}/${date.month}/${date.year}';

bool _isSameDay(DateTime left, DateTime right) {
  return left.year == right.year &&
      left.month == right.month &&
      left.day == right.day;
}

final List<double> _gridHours = List<double>.generate(
  24,
  (index) => 8 + (index * 0.5),
);
const double _timeSlotHeight = 22;
const double _pixelsPerHour = _timeSlotHeight * 2;
final double _plannerHeight = _gridHours.length * _timeSlotHeight;

DateTime _startOfWeek(DateTime date) {
  final normalized = DateTime(date.year, date.month, date.day);
  return normalized.subtract(Duration(days: normalized.weekday - 1));
}

String _weekLabel(DateTime startOfWeek) {
  final endOfWeek = startOfWeek.add(const Duration(days: 6));
  return '${_shortDate(startOfWeek)} - ${_shortDate(endOfWeek)}';
}

String _weekdayShortName(int weekday) {
  switch (weekday) {
    case DateTime.monday:
      return 'lun';
    case DateTime.tuesday:
      return 'mar';
    case DateTime.wednesday:
      return 'mer';
    case DateTime.thursday:
      return 'gio';
    case DateTime.friday:
      return 'ven';
    case DateTime.saturday:
      return 'sab';
    case DateTime.sunday:
      return 'dom';
    default:
      return '-';
  }
}

String _monthShortName(int month) {
  switch (month) {
    case 1:
      return 'gen';
    case 2:
      return 'feb';
    case 3:
      return 'mar';
    case 4:
      return 'apr';
    case 5:
      return 'mag';
    case 6:
      return 'giu';
    case 7:
      return 'lug';
    case 8:
      return 'ago';
    case 9:
      return 'set';
    case 10:
      return 'ott';
    case 11:
      return 'nov';
    case 12:
      return 'dic';
    default:
      return '-';
  }
}

String _formatTime(DateTime value) {
  final hour = value.hour.toString().padLeft(2, '0');
  final minute = value.minute.toString().padLeft(2, '0');
  return '$hour:$minute';
}

String _formatHours(double value) {
  final totalMinutes = (value * 60).round();
  final hours = totalMinutes ~/ 60;
  final minutes = totalMinutes % 60;
  return '${hours}h${minutes.toString().padLeft(2, '0')}';
}

String _formatHoursCompact(double value) {
  final totalMinutes = (value * 60).round();
  if (totalMinutes <= 0) {
    return '0h';
  }
  if (totalMinutes < 60) {
    return '$totalMinutes min';
  }
  final hours = totalMinutes ~/ 60;
  final minutes = totalMinutes % 60;
  if (minutes == 0) {
    return '${hours}h';
  }
  return '${hours}h ${minutes}min';
}

bool _isPastDeadline(DateTime slotDate, DateTime deadline) {
  final normalizedSlot = DateTime(slotDate.year, slotDate.month, slotDate.day);
  final normalizedDeadline = DateTime(
    deadline.year,
    deadline.month,
    deadline.day,
  );
  return normalizedSlot.isAfter(normalizedDeadline);
}

Color _taskPlanningColor(WorkTask task) {
  final hash = task.id.codeUnits.fold<int>(
    17,
    (sum, value) => (sum * 31 + value) & 0x7fffffff,
  );
  final hue = (hash % 360).toDouble();
  final saturation = 0.65 + ((hash % 23) / 100); // 0.65 - 0.87
  final lightness = 0.38 + ((hash % 14) / 100); // 0.38 - 0.52
  return HSLColor.fromAHSL(
    1,
    hue,
    saturation.clamp(0.0, 1.0),
    lightness,
  ).toColor();
}

Map<String, _TimelineSlotLayout> _buildSlotLayouts(
  List<TimelineSlot> slots,
  Map<String, double> previewHeights,
) {
  if (slots.isEmpty) {
    return const {};
  }

  final sorted = [...slots]
    ..sort((a, b) {
      final startCompare = a.startHour.compareTo(b.startHour);
      if (startCompare != 0) {
        return startCompare;
      }
      return a.id.compareTo(b.id);
    });

  double endHour(TimelineSlot slot) =>
      slot.startHour + (previewHeights[slot.id] ?? slot.plannedHours);

  final groups = <List<TimelineSlot>>[];
  final active = <TimelineSlot>[];
  var currentGroup = <TimelineSlot>[];

  for (final slot in sorted) {
    active.removeWhere((item) => endHour(item) <= slot.startHour);
    if (active.isEmpty && currentGroup.isNotEmpty) {
      groups.add(currentGroup);
      currentGroup = <TimelineSlot>[];
    }
    currentGroup.add(slot);
    active.add(slot);
  }
  if (currentGroup.isNotEmpty) {
    groups.add(currentGroup);
  }

  final layouts = <String, _TimelineSlotLayout>{};
  for (final group in groups) {
    final laneEnds = <double>[];
    final laneAssignments = <String, int>{};

    for (final slot in group) {
      final slotEnd = endHour(slot);
      var laneIndex = 0;
      while (laneIndex < laneEnds.length &&
          laneEnds[laneIndex] > slot.startHour) {
        laneIndex++;
      }
      if (laneIndex == laneEnds.length) {
        laneEnds.add(slotEnd);
      } else {
        laneEnds[laneIndex] = slotEnd;
      }
      laneAssignments[slot.id] = laneIndex;
    }

    for (final slot in group) {
      layouts[slot.id] = _TimelineSlotLayout(
        lane: laneAssignments[slot.id] ?? 0,
        laneCount: laneEnds.length,
      );
    }
  }

  return layouts;
}

_TaskRegistryStatus _taskRegistryStatus(WorkTask task) {
  if (task.status == TaskStatus.done) {
    return _TaskRegistryStatus.completed;
  }
  return _TaskRegistryStatus.open;
}

bool _isVacationDay(List<VacationPeriod> vacations, DateTime date) {
  return vacations.any((vacation) => vacation.includes(date));
}

Set<DateTime> _blockedDatesFromVacations(List<VacationPeriod> vacations) {
  final blockedDates = <DateTime>{};
  for (final vacation in vacations) {
    var cursor = DateTime(
      vacation.startDate.year,
      vacation.startDate.month,
      vacation.startDate.day,
    );
    final end = DateTime(
      vacation.endDate.year,
      vacation.endDate.month,
      vacation.endDate.day,
    );
    while (!cursor.isAfter(end)) {
      blockedDates.add(cursor);
      cursor = cursor.add(const Duration(days: 1));
    }
  }
  return blockedDates;
}

String _timeLabel(double hourValue) {
  final hour = hourValue.floor();
  final minutes = ((hourValue - hour) * 60).round();
  return '$hour:${minutes == 0 ? '00' : '30'}';
}

Duration _durationFromHours(double hours) {
  return Duration(minutes: (hours * 60).round());
}

DateTime _slotStartDateTime(TimelineSlot slot) {
  final hour = slot.startHour.floor();
  final minute = ((slot.startHour - hour) * 60).round();
  return DateTime(slot.date.year, slot.date.month, slot.date.day, hour, minute);
}

double _startHourFromLocalOffset(
  double localDy, {
  double slotHeight = _timeSlotHeight,
}) {
  final slotIndex = (localDy / slotHeight).floor().clamp(
    0,
    _gridHours.length - 1,
  );
  return _gridHours[slotIndex];
}

double _normalizeStartHourForDay({
  required double startHour,
  required double durationHours,
}) {
  final dayStart = _gridHours.first;
  final dayEnd = _gridHours.last + 0.5;
  final latestStart = (dayEnd - durationHours).clamp(dayStart, dayEnd);
  final normalized = startHour.clamp(dayStart, latestStart).toDouble();
  return (normalized * 2).round() / 2;
}

DateTime? _taskStartDate(WorkspaceSnapshot workspace, String taskId) {
  final slots =
      workspace.plannedSlots.where((slot) => slot.taskId == taskId).toList()
        ..sort((a, b) => a.date.compareTo(b.date));
  return slots.isEmpty ? null : slots.first.date;
}

String _taskStatusLabel(TaskStatus status) {
  switch (status) {
    case TaskStatus.backlog:
      return 'Backlog';
    case TaskStatus.planned:
      return 'Pianificato';
    case TaskStatus.inProgress:
      return 'In corso';
    case TaskStatus.done:
      return 'Completato';
  }
}

String _taskLocationLabel(WorkspaceSnapshot workspace, WorkTask task) {
  final company = _firstWhereOrNull(
    workspace.companies,
    (item) => item.id == task.companyId,
  );
  final project = _firstWhereOrNull(
    workspace.projects,
    (item) => item.id == task.projectId,
  );
  final phase = _firstWhereOrNull(
    workspace.phases,
    (item) => item.id == task.phaseId,
  );

  final parts = <String>[];
  if (company != null) {
    parts.add(company.name);
  }
  if (project != null) {
    parts.add(project.name);
  }
  if (phase != null) {
    parts.add(phase.name);
  }
  return parts.isEmpty ? 'Task non associato' : parts.join(' -> ');
}

T? _firstWhereOrNull<T>(Iterable<T> items, bool Function(T item) test) {
  for (final item in items) {
    if (test(item)) {
      return item;
    }
  }
  return null;
}

double _parseNumber(String raw) {
  return double.tryParse(raw.replaceAll(',', '.').trim()) ?? 0;
}

String _isoDate(DateTime value) {
  final year = value.year.toString().padLeft(4, '0');
  final month = value.month.toString().padLeft(2, '0');
  final day = value.day.toString().padLeft(2, '0');
  return '$year-$month-$day';
}

String _xmlEscape(String value) {
  return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&apos;');
}

String _toMoney(double value) => value.toStringAsFixed(2);

String buildFatturaPaXml({
  required InvoiceDraft invoice,
  required Map<String, dynamic> invoiceDetails,
  required BillingProfile seller,
  required Company customer,
}) {
  final issueDate =
      (invoiceDetails['issueDate'] as String?) ?? _isoDate(DateTime.now());
  final dueDate = (invoiceDetails['dueDate'] as String?) ?? issueDate;
  final description =
      (invoiceDetails['description'] as String?)?.trim().isNotEmpty == true
      ? invoiceDetails['description'] as String
      : 'Prestazioni professionali';
  final quantity = (invoiceDetails['quantity'] as num?)?.toDouble() ?? 1.0;
  final unitPrice =
      (invoiceDetails['unitPrice'] as num?)?.toDouble() ?? invoice.amount;
  final vatRate = (invoiceDetails['vatRate'] as num?)?.toDouble() ?? 22.0;
  final recipientCode =
      (invoiceDetails['recipientCode'] as String?)?.trim().isNotEmpty == true
      ? (invoiceDetails['recipientCode'] as String).trim()
      : (customer.sdiCode.isNotEmpty ? customer.sdiCode : '0000000');
  final recipientPec =
      (invoiceDetails['recipientPec'] as String?)?.trim().isNotEmpty == true
      ? (invoiceDetails['recipientPec'] as String).trim()
      : customer.pec;
  final paymentMethod =
      (invoiceDetails['paymentMethod'] as String?)?.trim().isNotEmpty == true
      ? (invoiceDetails['paymentMethod'] as String).trim()
      : 'MP05';

  final imponibile = quantity * unitPrice;
  final imposta = imponibile * (vatRate / 100);
  final totale = imponibile + imposta;
  final progressivo = invoice.id
      .replaceAll(RegExp(r'[^0-9A-Za-z]'), '')
      .padRight(5, '0')
      .substring(0, 5);
  final customerTax = customer.vatNumber.replaceAll('IT', '').trim();
  final sellerVat = seller.vatNumber.replaceAll('IT', '').trim();

  return '''<?xml version="1.0" encoding="UTF-8"?>
<p:FatturaElettronica versione="FPR12" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:p="http://ivaservizi.agenziaentrate.gov.it/docs/xsd/fatture/v1.2">
  <FatturaElettronicaHeader>
    <DatiTrasmissione>
      <IdTrasmittente>
        <IdPaese>${_xmlEscape(seller.countryCode.isEmpty ? 'IT' : seller.countryCode)}</IdPaese>
        <IdCodice>${_xmlEscape(sellerVat)}</IdCodice>
      </IdTrasmittente>
      <ProgressivoInvio>${_xmlEscape(progressivo)}</ProgressivoInvio>
      <FormatoTrasmissione>FPR12</FormatoTrasmissione>
      <CodiceDestinatario>${_xmlEscape(recipientCode)}</CodiceDestinatario>
${recipientPec.isEmpty ? '' : '      <PECDestinatario>${_xmlEscape(recipientPec)}</PECDestinatario>'}
    </DatiTrasmissione>
    <CedentePrestatore>
      <DatiAnagrafici>
        <IdFiscaleIVA>
          <IdPaese>${_xmlEscape(seller.countryCode.isEmpty ? 'IT' : seller.countryCode)}</IdPaese>
          <IdCodice>${_xmlEscape(sellerVat)}</IdCodice>
        </IdFiscaleIVA>
        <CodiceFiscale>${_xmlEscape(seller.taxCode)}</CodiceFiscale>
        <Anagrafica>
          <Denominazione>${_xmlEscape(seller.businessName)}</Denominazione>
        </Anagrafica>
        <RegimeFiscale>${_xmlEscape(seller.regimeFiscale)}</RegimeFiscale>
      </DatiAnagrafici>
      <Sede>
        <Indirizzo>${_xmlEscape(seller.addressLine)}</Indirizzo>
        <CAP>${_xmlEscape(seller.postalCode)}</CAP>
        <Comune>${_xmlEscape(seller.city)}</Comune>
        <Nazione>${_xmlEscape(seller.countryCode.isEmpty ? 'IT' : seller.countryCode)}</Nazione>
      </Sede>
    </CedentePrestatore>
    <CessionarioCommittente>
      <DatiAnagrafici>
        <IdFiscaleIVA>
          <IdPaese>IT</IdPaese>
          <IdCodice>${_xmlEscape(customerTax)}</IdCodice>
        </IdFiscaleIVA>
        <CodiceFiscale>${_xmlEscape(customer.taxCode.isEmpty ? customerTax : customer.taxCode)}</CodiceFiscale>
        <Anagrafica>
          <Denominazione>${_xmlEscape(customer.name)}</Denominazione>
        </Anagrafica>
      </DatiAnagrafici>
      <Sede>
        <Indirizzo>${_xmlEscape(customer.addressLine)}</Indirizzo>
        <CAP>${_xmlEscape(customer.postalCode)}</CAP>
        <Comune>${_xmlEscape(customer.city)}</Comune>
        <Nazione>IT</Nazione>
      </Sede>
    </CessionarioCommittente>
  </FatturaElettronicaHeader>
  <FatturaElettronicaBody>
    <DatiGenerali>
      <DatiGeneraliDocumento>
        <TipoDocumento>TD01</TipoDocumento>
        <Divisa>EUR</Divisa>
        <Data>$issueDate</Data>
        <Numero>${_xmlEscape(invoice.number)}</Numero>
        <ImportoTotaleDocumento>${_toMoney(totale)}</ImportoTotaleDocumento>
      </DatiGeneraliDocumento>
    </DatiGenerali>
    <DatiBeniServizi>
      <DettaglioLinee>
        <NumeroLinea>1</NumeroLinea>
        <Descrizione>${_xmlEscape(description)}</Descrizione>
        <Quantita>${_toMoney(quantity)}</Quantita>
        <PrezzoUnitario>${_toMoney(unitPrice)}</PrezzoUnitario>
        <PrezzoTotale>${_toMoney(imponibile)}</PrezzoTotale>
        <AliquotaIVA>${_toMoney(vatRate)}</AliquotaIVA>
      </DettaglioLinee>
      <DatiRiepilogo>
        <AliquotaIVA>${_toMoney(vatRate)}</AliquotaIVA>
        <ImponibileImporto>${_toMoney(imponibile)}</ImponibileImporto>
        <Imposta>${_toMoney(imposta)}</Imposta>
        <EsigibilitaIVA>I</EsigibilitaIVA>
      </DatiRiepilogo>
    </DatiBeniServizi>
    <DatiPagamento>
      <CondizioniPagamento>TP02</CondizioniPagamento>
      <DettaglioPagamento>
        <ModalitaPagamento>${_xmlEscape(paymentMethod)}</ModalitaPagamento>
        <DataScadenzaPagamento>$dueDate</DataScadenzaPagamento>
        <ImportoPagamento>${_toMoney(totale)}</ImportoPagamento>
      </DettaglioPagamento>
    </DatiPagamento>
  </FatturaElettronicaBody>
</p:FatturaElettronica>
''';
}
