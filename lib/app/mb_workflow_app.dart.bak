class CompanyPortfolioCard extends StatefulWidget {
  const CompanyPortfolioCard({
    super.key,
    required this.workspace,
    required this.onEditCompany,
  });

  final WorkspaceSnapshot workspace;
  final void Function(Company company) onEditCompany;

  @override
  State<CompanyPortfolioCard> createState() => _CompanyPortfolioCardState();
}

class _CompanyPortfolioCardState extends State<CompanyPortfolioCard> {
  static const _rowsPerPage = 10;
  int _page = 0;

  @override
  void didUpdateWidget(covariant CompanyPortfolioCard oldWidget) {
    super.didUpdateWidget(oldWidget);
    final maxPage = _maxPage;
    if (_page > maxPage) {
      _page = maxPage;
    }
  }

  int get _maxPage {
    if (widget.workspace.companies.isEmpty) {
      return 0;
    }
    return (widget.workspace.companies.length - 1) ~/ _rowsPerPage;
  }

  @override
  Widget build(BuildContext context) {
    final companies = widget.workspace.companies;
    final tasksByCompany = <String, List<WorkTask>>{};
    for (final task in widget.workspace.tasks) {
      tasksByCompany.putIfAbsent(task.companyId, () => []).add(task);
    }
    final trackHoursByTaskId = <String, double>{};
    for (final track in widget.workspace.timeTracks) {
      if (track.taskId.isEmpty) {
        continue;
      }
      trackHoursByTaskId.update(
        track.taskId,
        (value) => value + track.hours,
        ifAbsent: () => track.hours,
      );
    }
    final start = _page * _rowsPerPage;
    final end = (start + _rowsPerPage).clamp(0, companies.length);
    final pageItems = companies.sublist(start, end);

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Aziende',
              style: Theme.of(
                context,
              ).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 12),
            LayoutBuilder(
              builder: (context, constraints) => SingleChildScrollView(
                scrollDirection: Axis.horizontal,
                child: ConstrainedBox(
                  constraints: BoxConstraints(
                    minWidth: constraints.maxWidth < 1120
                        ? 1120
                        : constraints.maxWidth,
                  ),
                  child: DataTable(
                    columns: const [
                      DataColumn(label: Text('Azienda')),
                      DataColumn(label: Text('Partita IVA')),
                      DataColumn(label: Text('Citta')),
                      DataColumn(label: Text('Referente')),
                      DataColumn(label: Text('Previsto')),
                      DataColumn(label: Text('Pianificato')),
                      DataColumn(label: Text('Speso')),
                      DataColumn(label: Text('Azioni')),
                    ],
                    rows: pageItems.map((company) {
                      final tasks =
                          tasksByCompany[company.id] ?? const <WorkTask>[];
                      final taskIds = tasks.map((task) => task.id).toSet();
                      final estimated = tasks.fold<double>(
                        0,
                        (sum, task) => sum + task.estimatedHours,
                      );
                      final planned = widget.workspace.plannedSlots
                          .fold<double>(
                            0,
                            (sum, slot) => taskIds.contains(slot.taskId)
                                ? sum + slot.plannedHours
                                : sum,
                          );
                      final spent = tasks.fold<double>(0, (sum, task) {
                        final tracked = trackHoursByTaskId[task.id];
                        if (tracked != null && tracked > 0) {
                          return sum + tracked;
                        }
                        return sum + task.loggedHours;
                      });
                      return DataRow(
                        cells: [
                          DataCell(Text(company.name)),
                          DataCell(
                            Text(
                              company.vatNumber.isEmpty
                                  ? '-'
                                  : company.vatNumber,
                            ),
                          ),
                          DataCell(
                            Text(company.city.isEmpty ? '-' : company.city),
                          ),
                          DataCell(
                            Text(
                              company.contactPerson.isEmpty
                                  ? '-'
                                  : company.contactPerson,
                            ),
                          ),
                          DataCell(Text('${estimated.toStringAsFixed(1)}h')),
                          DataCell(Text('${planned.toStringAsFixed(1)}h')),
                          DataCell(Text('${spent.toStringAsFixed(1)}h')),
                          DataCell(
                            IconButton(
                              tooltip: 'Modifica azienda',
                              onPressed: () => widget.onEditCompany(company),
                              icon: const Icon(Icons.more_vert),
                            ),
                          ),
                        ],
                      );
                    }).toList(),
                  ),
                ),
              ),
            ),
            const SizedBox(height: 8),
            _TablePager(
              page: _page,
              rowsPerPage: _rowsPerPage,
              totalItems: companies.length,
              onPrev: _page == 0
                  ? null
                  : () =>
                        setState(() => _page = (_page - 1).clamp(0, _maxPage)),
              onNext: _page >= _maxPage
                  ? null
                  : () =>
                        setState(() => _page = (_page + 1).clamp(0, _maxPage)),
            ),
          ],
        ),
      ),
    );
  }
}

class ProjectPortfolioCard extends StatefulWidget {
  const ProjectPortfolioCard({
    super.key,
    required this.workspace,
    required this.onAddProject,
    required this.onEditProject,
    required this.onAddPhase,
    required this.onAddTaskToPhase,
    required this.onAddTaskToProject,
    required this.onEditTask,
  });

  final WorkspaceSnapshot workspace;
  final VoidCallback onAddProject;
  final void Function(Project project) onEditProject;
  final void Function(Project project) onAddPhase;
  final void Function(Project project, ProjectPhase phase) onAddTaskToPhase;
  final void Function(Project project) onAddTaskToProject;
  final void Function(WorkTask task) onEditTask;

  @override
  State<ProjectPortfolioCard> createState() => _ProjectPortfolioCardState();
}

class _ProjectPortfolioCardState extends State<ProjectPortfolioCard> {
  static const _rowsPerPage = 10;
  int _page = 0;
  String? _selectedProjectId;

  @override
  void didUpdateWidget(covariant ProjectPortfolioCard oldWidget) {
    super.didUpdateWidget(oldWidget);
    final maxPage = _maxPage;
    if (_page > maxPage) {
      _page = maxPage;
    }
  }

  int get _maxPage {
    if (widget.workspace.projects.isEmpty) {
      return 0;
    }
    return (widget.workspace.projects.length - 1) ~/ _rowsPerPage;
  }

  @override
  Widget build(BuildContext context) {
    final projects = widget.workspace.projects;
    final companiesById = {
      for (final company in widget.workspace.companies)
        company.id: company.name,
    };
    final tracksByTaskId = <String, double>{};
    for (final track in widget.workspace.timeTracks) {
      if (track.taskId.isEmpty) {
        continue;
      }
      tracksByTaskId.update(
        track.taskId,
        (value) => value + track.hours,
        ifAbsent: () => track.hours,
      );
    }
    final start = _page * _rowsPerPage;
    final end = (start + _rowsPerPage).clamp(0, projects.length);
    final pageItems = projects.sublist(start, end);
    final selectedProject = _selectedProjectId == null
        ? null
        : _firstWhereOrNull(
            projects,
            (project) => project.id == _selectedProjectId,
          );

    if (selectedProject != null) {
      return _ProjectDetailCard(
        workspace: widget.workspace,
        project: selectedProject,
        onBack: () => setState(() => _selectedProjectId = null),
        onAddPhase: () => widget.onAddPhase(selectedProject),
        onAddTaskToProject: () => widget.onAddTaskToProject(selectedProject),
        onAddTaskToPhase: (phase) =>
            widget.onAddTaskToPhase(selectedProject, phase),
        onEditTask: widget.onEditTask,
      );
    }

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Expanded(
                  child: Text(
                    'Progetti',
                    style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ),
                FilledButton.icon(
                  onPressed: widget.onAddProject,
                  icon: const Icon(Icons.add),
                  label: const Text('Aggiungi progetto'),
                ),
              ],
            ),
            const SizedBox(height: 12),
            LayoutBuilder(
              builder: (context, constraints) => SingleChildScrollView(
                scrollDirection: Axis.horizontal,
                child: ConstrainedBox(
                  constraints: BoxConstraints(
                    minWidth: constraints.maxWidth < 1080
                        ? 1080
                        : constraints.maxWidth,
                  ),
                  child: DataTable(
                    columns: const [
                      DataColumn(label: Text('Nome progetto')),
                      DataColumn(label: Text('Cliente')),
                      DataColumn(label: Text('Stato')),
                      DataColumn(label: Text('Previsto')),
                      DataColumn(label: Text('Pianificato')),
                      DataColumn(label: Text('Speso')),
                      DataColumn(label: Text('Azioni')),
                    ],
                    rows: pageItems.map((project) {
                      final projectTasks = widget.workspace.tasks
                          .where((task) => task.projectId == project.id)
                          .toList();
                      final projectTaskIds = projectTasks
                          .map((task) => task.id)
                          .toSet();
                      final estimated = projectTasks.fold<double>(
                        0,
                        (sum, task) => sum + task.estimatedHours,
                      );
                      final planned = widget.workspace.plannedSlots
                          .fold<double>(
                            0,
                            (sum, slot) => projectTaskIds.contains(slot.taskId)
                                ? sum + slot.plannedHours
                                : sum,
                          );
                      final spent = projectTasks.fold<double>(0, (sum, task) {
                        final tracked = tracksByTaskId[task.id];
                        if (tracked != null && tracked > 0) {
                          return sum + tracked;
                        }
                        return sum + task.loggedHours;
                      });
                      return DataRow(
                        cells: [
                          DataCell(
                            InkWell(
                              onTap: () => setState(
                                () => _selectedProjectId = project.id,
                              ),
                              child: Text(
                                project.name,
                                style: const TextStyle(
                                  decoration: TextDecoration.underline,
                                ),
                              ),
                            ),
                          ),
                          DataCell(
                            Text(companiesById[project.companyId] ?? '-'),
                          ),
                          DataCell(Text(project.status)),
                          DataCell(Text('${estimated.toStringAsFixed(1)}h')),
                          DataCell(Text('${planned.toStringAsFixed(1)}h')),
                          DataCell(Text('${spent.toStringAsFixed(1)}h')),
                          DataCell(
                            IconButton(
                              tooltip: 'Modifica progetto',
                              onPressed: () => widget.onEditProject(project),
                              icon: const Icon(Icons.more_vert),
                            ),
                          ),
                        ],
                      );
                    }).toList(),
                  ),
                ),
              ),
            ),
            const SizedBox(height: 8),
            _TablePager(
              page: _page,
              rowsPerPage: _rowsPerPage,
              totalItems: projects.length,
              onPrev: _page == 0
                  ? null
                  : () =>
                        setState(() => _page = (_page - 1).clamp(0, _maxPage)),
              onNext: _page >= _maxPage
                  ? null
                  : () =>
                        setState(() => _page = (_page + 1).clamp(0, _maxPage)),
            ),
          ],
        ),
      ),
    );
  }
}

class _ProjectDetailCard extends StatelessWidget {
  const _ProjectDetailCard({
    required this.workspace,
    required this.project,
    required this.onBack,
    required this.onAddPhase,
    required this.onAddTaskToProject,
    required this.onAddTaskToPhase,
    required this.onEditTask,
  });

  final WorkspaceSnapshot workspace;
  final Project project;
  final VoidCallback onBack;
  final VoidCallback onAddPhase;
  final VoidCallback onAddTaskToProject;
  final void Function(ProjectPhase phase) onAddTaskToPhase;
  final void Function(WorkTask task) onEditTask;

  @override
  Widget build(BuildContext context) {
    final phases =
        workspace.phases
            .where((phase) => phase.projectId == project.id)
            .toList()
          ..sort((a, b) => a.order.compareTo(b.order));
    final tasks =
        workspace.tasks.where((task) => task.projectId == project.id).toList()
          ..sort((a, b) => a.deadline.compareTo(b.deadline));
    final tracksByTaskId = <String, double>{};
    for (final track in workspace.timeTracks) {
      if (track.taskId.isEmpty) {
        continue;
      }
      tracksByTaskId.update(
        track.taskId,
        (value) => value + track.hours,
        ifAbsent: () => track.hours,
      );
    }
    final plannedByTaskId = <String, double>{};
    for (final slot in workspace.plannedSlots) {
      plannedByTaskId.update(
        slot.taskId,
        (value) => value + slot.plannedHours,
        ifAbsent: () => slot.plannedHours,
      );
    }

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                IconButton(
                  tooltip: 'Indietro ai progetti',
                  onPressed: onBack,
                  icon: const Icon(Icons.arrow_back),
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: Text(
                    project.name,
                    style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ),
                OutlinedButton.icon(
                  onPressed: onAddPhase,
                  icon: const Icon(Icons.playlist_add),
                  label: const Text('Aggiungi fase'),
                ),
                const SizedBox(width: 8),
                FilledButton.icon(
                  onPressed: onAddTaskToProject,
                  icon: const Icon(Icons.add_task),
                  label: const Text('Aggiungi task'),
                ),
              ],
            ),
            const SizedBox(height: 14),
            if (phases.isEmpty)
              const Text(
                'Nessuna fase nel progetto. Aggiungi una fase per iniziare.',
              )
            else
              ...phases.map((phase) {
                final phaseTasks = tasks
                    .where((task) => task.phaseId == phase.id)
                    .toList();
                final estimated = phaseTasks.fold<double>(
                  0,
                  (sum, task) => sum + task.estimatedHours,
                );
                final planned = phaseTasks.fold<double>(
                  0,
                  (sum, task) => sum + (plannedByTaskId[task.id] ?? 0),
                );
                final spent = phaseTasks.fold<double>(0, (sum, task) {
                  final tracked = tracksByTaskId[task.id];
                  if (tracked != null && tracked > 0) {
                    return sum + tracked;
                  }
                  return sum + task.loggedHours;
                });
                return Container(
                  margin: const EdgeInsets.only(bottom: 10),
                  decoration: BoxDecoration(
                    color: const Color(0xFFFFFFFF),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: const Color(0xFF1E2130)),
                  ),
                  child: Theme(
                    data: Theme.of(
                      context,
                    ).copyWith(dividerColor: Colors.transparent),
                    child: ExpansionTile(
                      controlAffinity: ListTileControlAffinity.leading,
                      tilePadding: const EdgeInsets.symmetric(
                        horizontal: 14,
                        vertical: 4,
                      ),
                      collapsedShape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(12),
                      ),
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(12),
                      ),
                      title: Text(
                        phase.name,
                        style: Theme.of(context).textTheme.titleLarge?.copyWith(
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                      subtitle: Text(
                        'Previsto ${estimated.toStringAsFixed(1)}h • Pianificato ${planned.toStringAsFixed(1)}h • Speso ${spent.toStringAsFixed(1)}h',
                      ),
                      children: [
                        Padding(
                          padding: const EdgeInsets.fromLTRB(14, 0, 14, 8),
                          child: Align(
                            alignment: Alignment.centerRight,
                            child: OutlinedButton.icon(
                              onPressed: () => onAddTaskToPhase(phase),
                              icon: const Icon(Icons.add_task, size: 18),
                              label: const Text('Aggiungi task'),
                            ),
                          ),
                        ),
                        if (phaseTasks.isEmpty)
                          const Padding(
                            padding: EdgeInsets.fromLTRB(16, 4, 16, 16),
                            child: Align(
                              alignment: Alignment.centerLeft,
                              child: Text('Nessun task in questa fase.'),
                            ),
                          )
                        else
                          ...phaseTasks.map(
                            (task) => ListTile(
                              dense: true,
                              title: Text(task.name),
                              subtitle: Text(
                                'Previsto ${task.estimatedHours.toStringAsFixed(1)}h • '
                                'Pianificato ${(plannedByTaskId[task.id] ?? 0).toStringAsFixed(1)}h • '
                                'Speso ${((tracksByTaskId[task.id] ?? 0) > 0 ? (tracksByTaskId[task.id] ?? 0) : task.loggedHours).toStringAsFixed(1)}h • '
                                'Scadenza ${_shortDate(task.deadline)}',
                              ),
                              trailing: IconButton(
                                tooltip: 'Modifica task',
                                onPressed: () => onEditTask(task),
                                icon: const Icon(Icons.edit_outlined),
                              ),
                            ),
                          ),
                      ],
                    ),
                  ),
                );
              }),
          ],
        ),
      ),
    );
  }
}

class ProjectFormCard extends StatefulWidget {
  const ProjectFormCard({
    super.key,
    required this.workspace,
    required this.onSubmit,
    this.project,
    this.preselectedCompanyId,
  });

  final WorkspaceSnapshot workspace;
  final Project? project;
  final String? preselectedCompanyId;
  final Future<void> Function(Project project) onSubmit;

  @override
  State<ProjectFormCard> createState() => _ProjectFormCardState();
}

class _ProjectFormCardState extends State<ProjectFormCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _name;
  late final TextEditingController _code;
  String? _companyId;
  String _status = 'active';
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    _name = TextEditingController(text: widget.project?.name ?? '');
    _code = TextEditingController(text: widget.project?.code ?? '');
    _companyId = widget.project?.companyId ?? widget.preselectedCompanyId;
    _status = widget.project?.status ?? 'active';
  }

  @override
  void dispose() {
    _name.dispose();
    _code.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(24),
      child: Form(
        key: _formKey,
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Text(
                  widget.project == null
                      ? 'Aggiungi progetto'
                      : 'Modifica progetto',
                  style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                    fontWeight: FontWeight.w700,
                  ),
                ),
                const Spacer(),
                IconButton(
                  onPressed: _saving ? null : () => Navigator.of(context).pop(),
                  icon: const Icon(Icons.close),
                ),
              ],
            ),
            const SizedBox(height: 16),
            TextFormField(
              controller: _name,
              decoration: const InputDecoration(
                labelText: 'Nome progetto',
                border: OutlineInputBorder(),
              ),
              validator: (value) => value == null || value.trim().isEmpty
                  ? 'Inserisci il nome'
                  : null,
            ),
            const SizedBox(height: 16),
            DropdownButtonFormField<String>(
              value: _companyId,
              decoration: const InputDecoration(
                labelText: 'Cliente',
                border: OutlineInputBorder(),
              ),
              validator: (value) => value == null ? 'Seleziona cliente' : null,
              items: widget.workspace.companies
                  .map(
                    (company) => DropdownMenuItem(
                      value: company.id,
                      child: Text(company.name),
                    ),
                  )
                  .toList(),
              onChanged: _saving
                  ? null
                  : (value) => setState(() => _companyId = value),
            ),
            const SizedBox(height: 16),
            Row(
              children: [
                Expanded(
                  child: TextFormField(
                    controller: _code,
                    decoration: const InputDecoration(
                      labelText: 'Codice progetto (opzionale)',
                      border: OutlineInputBorder(),
                    ),
                  ),
                ),
                const SizedBox(width: 12),
                SizedBox(
                  width: 180,
                  child: DropdownButtonFormField<String>(
                    value: _status,
                    decoration: const InputDecoration(
                      labelText: 'Stato',
                      border: OutlineInputBorder(),
                    ),
                    items: const [
                      DropdownMenuItem(value: 'active', child: Text('active')),
                      DropdownMenuItem(value: 'paused', child: Text('paused')),
                      DropdownMenuItem(value: 'closed', child: Text('closed')),
                    ],
                    onChanged: _saving
                        ? null
                        : (value) =>
                              setState(() => _status = value ?? 'active'),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 16),
            SizedBox(
              width: double.infinity,
              child: FilledButton(
                onPressed: _saving
                    ? null
                    : () async {
                        if (!_formKey.currentState!.validate()) {
                          return;
                        }
                        setState(() => _saving = true);
                        try {
                          final project = Project(
                            id:
                                widget.project?.id ??
                                'prj-${DateTime.now().microsecondsSinceEpoch}',
                            companyId: _companyId!,
                            name: _name.text.trim(),
                            code: _code.text.trim(),
                            status: _status,
                          );
                          await widget.onSubmit(project);
                          if (!mounted) {
                            return;
                          }
                          ScaffoldMessenger.of(context).showSnackBar(
                            SnackBar(
                              content: Text(
                                widget.project == null
                                    ? 'Progetto creato'
                                    : 'Progetto aggiornato',
                              ),
                            ),
                          );
                          Navigator.of(context).pop();
                        } finally {
                          if (mounted) {
                            setState(() => _saving = false);
                          }
                        }
                      },
                child: Text(_saving ? 'Salvataggio...' : 'Salva progetto'),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class PhaseFormCard extends StatefulWidget {
  const PhaseFormCard({
    super.key,
    required this.workspace,
    required this.project,
    required this.onSubmit,
  });

  final WorkspaceSnapshot workspace;
  final Project project;
  final Future<void> Function(ProjectPhase phase) onSubmit;

  @override
  State<PhaseFormCard> createState() => _PhaseFormCardState();
}

class _PhaseFormCardState extends State<PhaseFormCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _name;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    _name = TextEditingController();
  }

  @override
  void dispose() {
    _name.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(20),
      child: Form(
        key: _formKey,
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Text(
                  'Aggiungi fase',
                  style: Theme.of(
                    context,
                  ).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w700),
                ),
                const Spacer(),
                IconButton(
                  onPressed: _saving ? null : () => Navigator.of(context).pop(),
                  icon: const Icon(Icons.close),
                ),
              ],
            ),
            const SizedBox(height: 12),
            Text(
              'Progetto: ${widget.project.name}',
              style: Theme.of(context).textTheme.bodyMedium,
            ),
            const SizedBox(height: 12),
            TextFormField(
              controller: _name,
              decoration: const InputDecoration(
                labelText: 'Nome fase',
                border: OutlineInputBorder(),
              ),
              validator: (value) => value == null || value.trim().isEmpty
                  ? 'Inserisci il nome'
                  : null,
            ),
            const SizedBox(height: 12),
            SizedBox(
              width: double.infinity,
              child: FilledButton(
                onPressed: _saving
                    ? null
                    : () async {
                        if (!_formKey.currentState!.validate()) {
                          return;
                        }
                        final maxOrder = widget.workspace.phases
                            .where(
                              (phase) => phase.projectId == widget.project.id,
                            )
                            .fold<int>(
                              0,
                              (max, phase) =>
                                  phase.order > max ? phase.order : max,
                            );
                        setState(() => _saving = true);
                        try {
                          final phase = ProjectPhase(
                            id: 'ph-${DateTime.now().microsecondsSinceEpoch}',
                            projectId: widget.project.id,
                            name: _name.text.trim(),
                            order: maxOrder + 1,
                          );
                          await widget.onSubmit(phase);
                          if (!mounted) {
                            return;
                          }
                          Navigator.of(context).pop();
                        } finally {
                          if (mounted) {
                            setState(() => _saving = false);
                          }
                        }
                      },
                child: Text(_saving ? 'Salvataggio...' : 'Salva fase'),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _TablePager extends StatelessWidget {
  const _TablePager({
    required this.page,
    required this.rowsPerPage,
    required this.totalItems,
    required this.onPrev,
    required this.onNext,
  });

  final int page;
  final int rowsPerPage;
  final int totalItems;
  final VoidCallback? onPrev;
  final VoidCallback? onNext;

  @override
  Widget build(BuildContext context) {
    if (totalItems == 0) {
      return const Text('Nessun elemento');
    }
    final from = (page * rowsPerPage) + 1;
    final to = ((page + 1) * rowsPerPage).clamp(0, totalItems);
    final totalPages = ((totalItems - 1) ~/ rowsPerPage) + 1;
    return Row(
      mainAxisAlignment: MainAxisAlignment.end,
      children: [
        Text('$from-$to di $totalItems (pag. ${page + 1}/$totalPages)'),
        const SizedBox(width: 8),
        IconButton(
          tooltip: 'Pagina precedente',
          onPressed: onPrev,
          icon: const Icon(Icons.chevron_left),
        ),
        IconButton(
          tooltip: 'Pagina successiva',
          onPressed: onNext,
          icon: const Icon(Icons.chevron_right),
        ),
      ],
    );
  }
}

class CompanyFormCard extends StatefulWidget {
  const CompanyFormCard({super.key, this.company, required this.onSubmit});

  final Company? company;
  final Future<void> Function(Company company) onSubmit;

  @override
  State<CompanyFormCard> createState() => _CompanyFormCardState();
}

class _CompanyFormCardState extends State<CompanyFormCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _name;
  late final TextEditingController _vat;
  late final TextEditingController _taxCode;
  late final TextEditingController _pec;
  late final TextEditingController _sdi;
  late final TextEditingController _email;
  late final TextEditingController _phone;
  late final TextEditingController _website;
  late final TextEditingController _address;
  late final TextEditingController _city;
  late final TextEditingController _postal;
  late final TextEditingController _country;
  late final TextEditingController _contact;
  late final TextEditingController _notes;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    final company = widget.company;
    _name = TextEditingController(text: company?.name ?? '');
    _vat = TextEditingController(text: company?.vatNumber ?? '');
    _taxCode = TextEditingController(text: company?.taxCode ?? '');
    _pec = TextEditingController(text: company?.pec ?? '');
    _sdi = TextEditingController(text: company?.sdiCode ?? '');
    _email = TextEditingController(text: company?.email ?? '');
    _phone = TextEditingController(text: company?.phone ?? '');
    _website = TextEditingController(text: company?.website ?? '');
    _address = TextEditingController(text: company?.addressLine ?? '');
    _city = TextEditingController(text: company?.city ?? '');
    _postal = TextEditingController(text: company?.postalCode ?? '');
    _country = TextEditingController(
      text: company?.country.isNotEmpty == true ? company!.country : 'Italia',
    );
    _contact = TextEditingController(text: company?.contactPerson ?? '');
    _notes = TextEditingController(text: company?.notes ?? '');
  }

  @override
  void dispose() {
    for (final controller in [
      _name,
      _vat,
      _taxCode,
      _pec,
      _sdi,
      _email,
      _phone,
      _website,
      _address,
      _city,
      _postal,
      _country,
      _contact,
      _notes,
    ]) {
      controller.dispose();
    }
    super.dispose();
  }

  Future<void> _submit() async {
    if (!_formKey.currentState!.validate()) {
      return;
    }
    setState(() => _saving = true);
    try {
      final company = Company(
        id:
            widget.company?.id ??
            'cmp-${DateTime.now().microsecondsSinceEpoch}',
        name: _name.text.trim(),
        vatNumber: _vat.text.trim(),
        taxCode: _taxCode.text.trim(),
        pec: _pec.text.trim(),
        sdiCode: _sdi.text.trim(),
        email: _email.text.trim(),
        phone: _phone.text.trim(),
        website: _website.text.trim(),
        addressLine: _address.text.trim(),
        city: _city.text.trim(),
        postalCode: _postal.text.trim(),
        country: _country.text.trim(),
        contactPerson: _contact.text.trim(),
        notes: _notes.text.trim(),
      );
      await widget.onSubmit(company);
      for (final controller in [
        _name,
        _vat,
        _taxCode,
        _pec,
        _sdi,
        _email,
        _phone,
        _website,
        _address,
        _city,
        _postal,
        _contact,
        _notes,
      ]) {
        controller.clear();
      }
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              widget.company == null
                  ? 'Azienda salvata in Firestore'
                  : 'Azienda aggiornata',
            ),
          ),
        );
        Navigator.of(context).pop();
      }
    } finally {
      if (mounted) {
        setState(() => _saving = false);
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Form(
          key: _formKey,
          child: SingleChildScrollView(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  widget.company == null ? 'Nuova azienda' : 'Modifica azienda',
                  style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                    fontWeight: FontWeight.w700,
                  ),
                ),
                const SizedBox(height: 8),
                const Text(
                  'Anagrafica cliente con campi fiscali e contatto principale.',
                ),
                const SizedBox(height: 16),
                LayoutBuilder(
                  builder: (context, constraints) {
                    final compact = constraints.maxWidth < 640;
                    if (compact) {
                      return Column(
                        children: [
                          _FormField(
                            controller: _name,
                            label: 'Ragione sociale',
                            required: true,
                          ),
                          _FormField(
                            controller: _vat,
                            label: 'Partita IVA',
                            required: true,
                          ),
                          _FormField(
                            controller: _taxCode,
                            label: 'Codice fiscale',
                          ),
                          _FormField(controller: _pec, label: 'PEC'),
                          _FormField(controller: _sdi, label: 'Codice SDI'),
                          _FormField(
                            controller: _email,
                            label: 'Email amministrativa',
                          ),
                          _FormField(controller: _phone, label: 'Telefono'),
                          _FormField(controller: _website, label: 'Sito web'),
                          _FormField(controller: _contact, label: 'Referente'),
                          _FormField(controller: _address, label: 'Indirizzo'),
                          _FormField(controller: _city, label: 'Citta'),
                          _FormField(controller: _postal, label: 'CAP'),
                          _FormField(controller: _country, label: 'Paese'),
                        ],
                      );
                    }

                    return Column(
                      children: [
                        _twoFieldRow(
                          _name,
                          'Ragione sociale',
                          _vat,
                          'Partita IVA',
                          leftRequired: true,
                          rightRequired: true,
                        ),
                        _twoFieldRow(
                          _taxCode,
                          'Codice fiscale',
                          _sdi,
                          'Codice SDI',
                        ),
                        _twoFieldRow(
                          _pec,
                          'PEC',
                          _email,
                          'Email amministrativa',
                        ),
                        _twoFieldRow(_phone, 'Telefono', _website, 'Sito web'),
                        _twoFieldRow(
                          _contact,
                          'Referente',
                          _address,
                          'Indirizzo',
                        ),
                        _threeFieldRow(
                          _city,
                          'Citta',
                          _postal,
                          'CAP',
                          _country,
                          'Paese',
                        ),
                      ],
                    );
                  },
                ),
                _FormField(controller: _notes, label: 'Note CRM', maxLines: 3),
                const SizedBox(height: 12),
                SizedBox(
                  width: double.infinity,
                  child: FilledButton(
                    onPressed: _saving ? null : _submit,
                    child: Text(
                      _saving
                          ? 'Salvataggio...'
                          : widget.company == null
                          ? 'Salva azienda'
                          : 'Aggiorna azienda',
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _twoFieldRow(
    TextEditingController leftController,
    String leftLabel,
    TextEditingController rightController,
    String rightLabel, {
    bool leftRequired = false,
    bool rightRequired = false,
  }) {
    return Row(
      children: [
        Expanded(
          child: _FormField(
            controller: leftController,
            label: leftLabel,
            required: leftRequired,
          ),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: _FormField(
            controller: rightController,
            label: rightLabel,
            required: rightRequired,
          ),
        ),
      ],
    );
  }

  Widget _threeFieldRow(
    TextEditingController firstController,
    String firstLabel,
    TextEditingController secondController,
    String secondLabel,
    TextEditingController thirdController,
    String thirdLabel,
  ) {
    return Row(
      children: [
        Expanded(
          flex: 3,
          child: _FormField(controller: firstController, label: firstLabel),
        ),
        const SizedBox(width: 12),
        Expanded(
          flex: 2,
          child: _FormField(controller: secondController, label: secondLabel),
        ),
        const SizedBox(width: 12),
        Expanded(
          flex: 2,
          child: _FormField(controller: thirdController, label: thirdLabel),
        ),
      ],
    );
  }
}

class _FormField extends StatelessWidget {
  const _FormField({
    required this.controller,
    required this.label,
    this.required = false,
    this.maxLines = 1,
  });

  final TextEditingController controller;
  final String label;
  final bool required;
  final int maxLines;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 12),
      child: TextFormField(
        controller: controller,
        maxLines: maxLines,
        validator: required
            ? (value) {
                if (value == null || value.trim().isEmpty) {
                  return 'Campo obbligatorio';
                }
                return null;
              }
            : null,
        decoration: InputDecoration(
          labelText: label,
          border: const OutlineInputBorder(),
        ),
      ),
    );
  }
}

class CrmHierarchyCard extends StatelessWidget {
  const CrmHierarchyCard({
    super.key,
    required this.workspace,
    this.expandedMode = false,
  });

  final WorkspaceSnapshot workspace;
  final bool expandedMode;

  @override
  Widget build(BuildContext context) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'CRM hierarchy',
              style: Theme.of(
                context,
              ).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 16),
            ...workspace.companies.map((company) {
              final projects = workspace.projects
                  .where((item) => item.companyId == company.id)
                  .toList();
              return Container(
                margin: const EdgeInsets.only(bottom: 16),
                padding: const EdgeInsets.all(16),
                decoration: BoxDecoration(
                  color: const Color(0xFFFFFFFF),
                  borderRadius: BorderRadius.circular(20),
                  border: Border.all(color: const Color(0xFFE0D4C2)),
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      company.name,
                      style: Theme.of(context).textTheme.titleLarge?.copyWith(
                        fontWeight: FontWeight.w700,
                      ),
                    ),
                    const SizedBox(height: 8),
                    Text(
                      'VAT ${company.vatNumber} | SDI ${company.sdiCode} | PEC ${company.pec.isEmpty ? '-' : company.pec}',
                    ),
                    const SizedBox(height: 6),
                    Text(
                      '${company.addressLine}${company.addressLine.isNotEmpty ? ', ' : ''}${company.city} ${company.postalCode} ${company.country}',
                    ),
                    Text(
                      'Referente ${company.contactPerson.isEmpty ? '-' : company.contactPerson} | Email ${company.email.isEmpty ? '-' : company.email} | Tel ${company.phone.isEmpty ? '-' : company.phone}',
                    ),
                    const SizedBox(height: 12),
                    ...projects.map((project) {
                      final phases =
                          workspace.phases
                              .where((item) => item.projectId == project.id)
                              .toList()
                            ..sort((a, b) => a.order.compareTo(b.order));
                      return Padding(
                        padding: const EdgeInsets.only(bottom: 12),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text('Project ${project.code} - ${project.name}'),
                            const SizedBox(height: 8),
                            ...phases.map((phase) {
                              final tasks = workspace.tasks
                                  .where((task) => task.phaseId == phase.id)
                                  .toList();
                              return Padding(
                                padding: const EdgeInsets.only(
                                  left: 12,
                                  bottom: 8,
                                ),
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Text('Phase ${phase.order}. ${phase.name}'),
                                    const SizedBox(height: 6),
                                    ...tasks.map(
                                      (task) => Padding(
                                        padding: const EdgeInsets.only(
                                          left: 12,
                                          bottom: 4,
                                        ),
                                        child: Row(
                                          children: [
                                            Icon(
                                              task.status == TaskStatus.done
                                                  ? Icons.check_box
                                                  : Icons
                                                        .check_box_outline_blank,
                                              size: 18,
                                              color: GussoniBrand.primary,
                                            ),
                                            const SizedBox(width: 8),
                                            Expanded(
                                              child: Text(
                                                '${task.name} | est. ${task.estimatedHours}h | deadline ${_shortDate(task.deadline)}',
                                              ),
                                            ),
                                          ],
                                        ),
                                      ),
                                    ),
                                  ],
                                ),
                              );
                            }),
                          ],
                        ),
                      );
                    }),
                  ],
                ),
              );
            }),
            if (!expandedMode)
              Text(
                'Percorso Firestore utente: users/{uid}/companies, projects, phases, tasks',
                style: Theme.of(context).textTheme.bodySmall,
              ),
          ],
        ),
      ),
    );
  }
}

class GoogleCalendarSyncCard extends StatelessWidget {
  const GoogleCalendarSyncCard({
    super.key,
    required this.connected,
    required this.connectedEmail,
    required this.busy,
    required this.onConnect,
    required this.onDisconnect,
    required this.onSyncNow,
  });

  final bool connected;
  final String? connectedEmail;
  final bool busy;
  final Future<void> Function() onConnect;
  final Future<void> Function() onDisconnect;
  final Future<void> Function() onSyncNow;

  @override
  Widget build(BuildContext context) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Google Calendar',
              style: Theme.of(
                context,
              ).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 8),
            Text(
              connected
                  ? 'Account collegato${connectedEmail == null ? '' : ': $connectedEmail'}'
                  : 'Collega un account Google per sincronizzare gli slot della pianificazione su Calendar.',
            ),
            const SizedBox(height: 14),
            Wrap(
              spacing: 12,
              runSpacing: 12,
              children: [
                if (!connected)
                  FilledButton.icon(
                    onPressed: busy ? null : () => onConnect(),
                    icon: const Icon(Icons.link),
                    label: const Text('Collega Google'),
                  )
                else
                  OutlinedButton.icon(
                    onPressed: busy ? null : () => onDisconnect(),
                    icon: const Icon(Icons.link_off),
                    label: const Text('Disconnetti'),
                  ),
                FilledButton.icon(
                  onPressed: busy || !connected ? null : () => onSyncNow(),
                  icon: const Icon(Icons.sync),
                  label: const Text('Sincronizza adesso'),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}

class EmailSignatureSettingsCard extends StatefulWidget {
  const EmailSignatureSettingsCard({
    super.key,
    required this.initialHtml,
    required this.onSave,
  });

  final String initialHtml;
  final Future<void> Function(String html) onSave;

  @override
  State<EmailSignatureSettingsCard> createState() =>
      _EmailSignatureSettingsCardState();
}

class _EmailSignatureSettingsCardState
    extends State<EmailSignatureSettingsCard> {
  late final TextEditingController _htmlController;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    _htmlController = TextEditingController(text: widget.initialHtml);
  }

  @override
  void didUpdateWidget(covariant EmailSignatureSettingsCard oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.initialHtml != widget.initialHtml &&
        !_saving &&
        _htmlController.text != widget.initialHtml) {
      _htmlController.text = widget.initialHtml;
    }
  }

  @override
  void dispose() {
    _htmlController.dispose();
    super.dispose();
  }

  Future<void> _save() async {
    setState(() => _saving = true);
    try {
      await widget.onSave(_htmlController.text);
      if (mounted) {
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(const SnackBar(content: Text('Firma HTML salvata.')));
      }
    } finally {
      if (mounted) {
        setState(() => _saving = false);
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Firma email HTML',
              style: Theme.of(
                context,
              ).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 8),
            const Text(
              'Questa firma verra aggiunta in fondo a tutte le email inviate dai ticket.',
            ),
            const SizedBox(height: 12),
            TextField(
              controller: _htmlController,
              minLines: 8,
              maxLines: 16,
              style: const TextStyle(fontFamily: 'monospace'),
              decoration: const InputDecoration(
                border: OutlineInputBorder(),
                hintText:
                    '<table><tr><td><strong>Matteo Broggini</strong><br/>...</td></tr></table>',
              ),
            ),
            const SizedBox(height: 8),
            const Text(
              'Tip: usa HTML inline (style="...") per massima compatibilita client email.',
              style: TextStyle(fontSize: 12, color: Color(0xFF7D89A8)),
            ),
            const SizedBox(height: 12),
            Align(
              alignment: Alignment.centerRight,
              child: FilledButton.icon(
                onPressed: _saving ? null : _save,
                icon: const Icon(Icons.save_outlined),
                label: const Text('Salva firma'),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

