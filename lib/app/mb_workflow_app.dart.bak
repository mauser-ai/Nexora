class AuthGate extends StatelessWidget {
  const AuthGate({super.key});

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<User?>(
      stream: FirebaseAuth.instance.authStateChanges(),
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Scaffold(
            body: Center(child: CircularProgressIndicator()),
          );
        }

        if (snapshot.hasData) {
          final user = snapshot.data!;
          if (user.uid == kAdminUid) {
            return AdminPanel(user: user);
          }
          return DashboardPage(user: user);
        }

        return const LoginPage();
      },
    );
  }
}

class LoginPage extends StatefulWidget {
  const LoginPage({super.key});

  @override
  State<LoginPage> createState() => _LoginPageState();
}

class _LoginPageState extends State<LoginPage> {
  final _emailController = TextEditingController();
  final _passwordController = TextEditingController();
  String? _errorMessage;
  bool _isLoading = false;

  Future<void> _login() async {
    final email = _emailController.text.trim();
    final password = _passwordController.text.trim();
    if (email.isEmpty || password.isEmpty) {
      setState(() => _errorMessage = 'Inserisci email e password.');
      return;
    }
    setState(() { _isLoading = true; _errorMessage = null; });
    try {
      await FirebaseAuth.instance.signInWithEmailAndPassword(email: email, password: password);
      AnalyticsService.instance.logLogin('password');
    } on FirebaseAuthException catch (e) {
      setState(() {
        _errorMessage = switch (e.code) {
          'user-not-found' => 'Nessun account trovato. Contatta l\'amministratore.',
          'wrong-password' || 'invalid-credential' => 'Password non corretta.',
          'invalid-email' => 'Email non valida.',
          'user-disabled' => 'Account disabilitato.',
          _ => e.message ?? 'Errore di autenticazione.',
        };
      });
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  @override
  void dispose() {
    _emailController.dispose();
    _passwordController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final accent = GussoniBrand.primary;

    // ── Left column – branding ──
    final intro = Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // Eyebrow badge
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 7),
          decoration: BoxDecoration(
            border: Border.all(color: accent.withOpacity(.3)),
            borderRadius: BorderRadius.circular(4),
            color: accent.withOpacity(.06),
          ),
          child: Text(
            '🚀  NEXORA · NEXT-GEN CRM',
            style: TextStyle(color: accent, fontSize: 10, fontWeight: FontWeight.w700, letterSpacing: 2),
          ),
        ),
        const SizedBox(height: 28),
        ShaderMask(
          shaderCallback: (bounds) => LinearGradient(
            colors: [accent, const Color(0xFF00CFFF)],
            begin: Alignment.centerLeft, end: Alignment.centerRight,
          ).createShader(bounds),
          child: const Text('NEXORA',
            style: TextStyle(fontSize: 52, fontWeight: FontWeight.w900,
              color: Colors.white, letterSpacing: -2, height: 1)),
        ),
        const SizedBox(height: 8),
        const Text('Il CRM di nuova generazione',
          style: TextStyle(fontSize: 18, color: Color(0xFF7D89A8), letterSpacing: -.3)),
        const SizedBox(height: 20),
        const Text(
          'CRM, task planning, segnatempo, preventivi e fatturazione FatturaPA in un unico workspace collaborativo.',
          style: TextStyle(fontSize: 14, color: Color(0xFF525D78), height: 1.7),
        ),
        const SizedBox(height: 32),
        ...[
          ('Multi-team con ruoli e permessi', Icons.people_outline_rounded),
          ('Pipeline vendite con kanban', Icons.trending_up_outlined),
          ('Segnatempo collaborativo', Icons.schedule_outlined),
          ('Preventivi e fatture FatturaPA XML', Icons.receipt_long_outlined),
        ].map((item) => Padding(
          padding: const EdgeInsets.only(bottom: 10),
          child: Row(children: [
            Container(
              width: 6, height: 6,
              margin: const EdgeInsets.only(right: 12),
              decoration: BoxDecoration(shape: BoxShape.circle, color: accent,
                boxShadow: [BoxShadow(color: accent.withOpacity(.5), blurRadius: 6)]),
            ),
            Text(item.$1, style: TextStyle(fontSize: 14, color: Colors.white.withOpacity(.65))),
          ]),
        )),
      ],
    );

    // ── Right column – auth form ──
    final form = Container(
      decoration: BoxDecoration(
        color: const Color(0xFF0A0C18),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: accent.withOpacity(.2)),
        boxShadow: [
          BoxShadow(color: accent.withOpacity(.08), blurRadius: 40, spreadRadius: 0),
          const BoxShadow(color: Color(0x40000000), blurRadius: 20, offset: Offset(0, 8)),
        ],
      ),
      padding: const EdgeInsets.all(36),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          // Logo row
          Center(
            child: Image.asset(
              GussoniBrand.logoWhitePath,
              height: 52,
              fit: BoxFit.contain,
            ),
          ),
          const SizedBox(height: 28),
          const Text(
            'Accedi alla piattaforma',
            style: TextStyle(fontSize: 20, fontWeight: FontWeight.w800, color: Color(0xFFE4E8FF)),
          ),
          const SizedBox(height: 6),
          const Text(
            'Inserisci le tue credenziali',
            style: TextStyle(fontSize: 13, color: Color(0xFF525D78)),
          ),
          const SizedBox(height: 24),
          _AuthField(
            controller: _emailController, label: 'Email', hint: 'nome@azienda.it',
            icon: Icons.alternate_email, keyboardType: TextInputType.emailAddress,
          ),
          const SizedBox(height: 14),
          _AuthField(
            controller: _passwordController, label: 'Password', hint: '',
            icon: Icons.lock_outline, obscure: true,
          ),
          // Error
          if (_errorMessage != null) ...[
            const SizedBox(height: 14),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
              decoration: BoxDecoration(
                color: const Color(0xFF1A0A0A),
                borderRadius: BorderRadius.circular(6),
                border: Border.all(color: const Color(0xFF7F1D1D).withOpacity(.6)),
              ),
              child: Row(
                children: [
                  const Icon(Icons.error_outline, size: 15, color: Color(0xFFEF4444)),
                  const SizedBox(width: 8),
