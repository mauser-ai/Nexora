  Future<void> _saveInvoice(
    InvoiceDraft invoice, {
    required DateTime issueDate,
    required DateTime dueDate,
    required String description,
    required double quantity,
    required double unitPrice,
    required double vatRate,
    required String recipientCode,
    required String recipientPec,
    required String paymentMethod,
  }) async {
    final net = quantity * unitPrice;
    final vat = net * (vatRate / 100);
    final total = net + vat;
    await _repository.saveInvoice(
      widget.user.uid,
      invoice: invoice.copyWith(amount: total),
      details: {
        'issueDate': _isoDate(issueDate),
        'dueDate': _isoDate(dueDate),
        'description': description,
        'quantity': quantity,
        'unitPrice': unitPrice,
        'vatRate': vatRate,
        'recipientCode': recipientCode,
        'recipientPec': recipientPec,
        'paymentMethod': paymentMethod,
      },
    );
  }

