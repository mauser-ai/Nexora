            value,
            style: Theme.of(
              context,
            ).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w700),
          ),
        ],
      ),
    );
  }
}

class _StatsBars extends StatelessWidget {
  const _StatsBars({
    required this.title,
    required this.entries,
    required this.labelById,
  });

  final String title;
  final List<MapEntry<String, double>> entries;
  final String Function(String id) labelById;

  @override
  Widget build(BuildContext context) {
    final maxValue = entries.isEmpty
        ? 1.0
        : entries.map((entry) => entry.value).reduce((a, b) => a > b ? a : b);
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: const Color(0xFFFFFFFF),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: const Color(0xFF1E2130)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            title,
            style: Theme.of(
              context,
            ).textTheme.titleMedium?.copyWith(fontWeight: FontWeight.w700),
          ),
          const SizedBox(height: 10),
          if (entries.isEmpty)
            const Text('Nessun dato nel filtro selezionato.')
          else
            ...entries.map((entry) {
              final fraction = (entry.value / maxValue).clamp(0.0, 1.0);
              return Padding(
                padding: const EdgeInsets.only(bottom: 8),
                child: Row(
                  children: [
                    Expanded(
                      flex: 3,
                      child: Text(
                        labelById(entry.key),
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                    Expanded(
                      flex: 5,
                      child: Stack(
                        children: [
                          Container(
                            height: 8,
                            decoration: BoxDecoration(
                              color: const Color(0xFF1E2130),
                              borderRadius: BorderRadius.circular(999),
                            ),
                          ),
                          FractionallySizedBox(
                            widthFactor: fraction,
                            child: Container(
                              height: 8,
                              decoration: BoxDecoration(
                                color: GussoniBrand.primary,
                                borderRadius: BorderRadius.circular(999),
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                    const SizedBox(width: 8),
                    SizedBox(width: 60, child: Text(_formatHours(entry.value))),
                  ],
                ),
              );
            }),
        ],
      ),
    );
  }
}

class BillingProfileSettingsCard extends StatefulWidget {
  const BillingProfileSettingsCard({
    super.key,
    required this.profile,
    required this.onSave,
  });

  final BillingProfile profile;
  final Future<void> Function(BillingProfile profile) onSave;

  @override
  State<BillingProfileSettingsCard> createState() =>
      _BillingProfileSettingsCardState();
}

class _BillingProfileSettingsCardState
    extends State<BillingProfileSettingsCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _businessName;
  late final TextEditingController _vat;
  late final TextEditingController _taxCode;
  late final TextEditingController _address;
  late final TextEditingController _cap;
  late final TextEditingController _city;
  late final TextEditingController _countryCode;
  late final TextEditingController _regime;
  late final TextEditingController _reaOffice;
  late final TextEditingController _reaNumber;
  late final TextEditingController _email;
  late final TextEditingController _pec;
  late final TextEditingController _phone;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    _businessName = TextEditingController(text: widget.profile.businessName);
    _vat = TextEditingController(text: widget.profile.vatNumber);
    _taxCode = TextEditingController(text: widget.profile.taxCode);
    _address = TextEditingController(text: widget.profile.addressLine);
    _cap = TextEditingController(text: widget.profile.postalCode);
    _city = TextEditingController(text: widget.profile.city);
    _countryCode = TextEditingController(text: widget.profile.countryCode);
    _regime = TextEditingController(text: widget.profile.regimeFiscale);
    _reaOffice = TextEditingController(text: widget.profile.reaOffice);
    _reaNumber = TextEditingController(text: widget.profile.reaNumber);
    _email = TextEditingController(text: widget.profile.email);
    _pec = TextEditingController(text: widget.profile.pec);
    _phone = TextEditingController(text: widget.profile.phone);
  }

  @override
  void dispose() {
    _businessName.dispose();
    _vat.dispose();
    _taxCode.dispose();
    _address.dispose();
    _cap.dispose();
    _city.dispose();
    _countryCode.dispose();
    _regime.dispose();
    _reaOffice.dispose();
    _reaNumber.dispose();
    _email.dispose();
    _pec.dispose();
    _phone.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Form(
          key: _formKey,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                'Dati emittente fattura',
                style: Theme.of(
                  context,
                ).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w700),
              ),
              const SizedBox(height: 12),
              Wrap(
                spacing: 12,
                runSpacing: 12,
                children: [
                  _formField(_businessName, 'Ragione sociale', 280),
                  _formField(_vat, 'Partita IVA', 180),
                  _formField(_taxCode, 'Codice fiscale', 180),
                  _formField(_address, 'Indirizzo', 280),
                  _formField(_cap, 'CAP', 100),
                  _formField(_city, 'Comune', 160),
                  _formField(_countryCode, 'Nazione (ISO2)', 120),
                  _formField(_regime, 'Regime fiscale (es RF01)', 180),
                  _formField(_reaOffice, 'REA ufficio', 120),
                  _formField(_reaNumber, 'REA numero', 150),
                  _formField(_email, 'Email', 220),
                  _formField(_pec, 'PEC', 220),
                  _formField(_phone, 'Telefono', 170),
                ],
              ),
              const SizedBox(height: 12),
              Align(
                alignment: Alignment.centerRight,
                child: FilledButton(
                  onPressed: _saving
                      ? null
                      : () async {
                          if (!_formKey.currentState!.validate()) {
                            return;
                          }
                          setState(() => _saving = true);
                          try {
                            final profile = BillingProfile(
                              businessName: _businessName.text.trim(),
                              vatNumber: _vat.text.trim(),
                              taxCode: _taxCode.text.trim(),
                              addressLine: _address.text.trim(),
                              postalCode: _cap.text.trim(),
                              city: _city.text.trim(),
                              countryCode: _countryCode.text
                                  .trim()
                                  .toUpperCase(),
                              regimeFiscale: _regime.text.trim().toUpperCase(),
                              reaOffice: _reaOffice.text.trim().toUpperCase(),
                              reaNumber: _reaNumber.text.trim(),
                              email: _email.text.trim(),
                              pec: _pec.text.trim(),
                              phone: _phone.text.trim(),
                            );
                            await widget.onSave(profile);
                            if (!context.mounted) {
                              return;
                            }
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text('Dati emittente salvati.'),
                              ),
                            );
                          } finally {
                            if (mounted) {
                              setState(() => _saving = false);
                            }
                          }
                        },
                  child: Text(
                    _saving ? 'Salvataggio...' : 'Salva dati emittente',
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _formField(
    TextEditingController controller,
    String label,
    double width,
  ) {
    return SizedBox(
      width: width,
      child: TextFormField(
        controller: controller,
        decoration: InputDecoration(
          labelText: label,
          border: const OutlineInputBorder(),
        ),
        validator: (value) {
          if ((label == 'Ragione sociale' ||
                  label == 'Partita IVA' ||
                  label == 'Codice fiscale' ||
                  label == 'Indirizzo' ||
                  label == 'CAP' ||
                  label == 'Comune' ||
                  label == 'Nazione (ISO2)' ||
                  label == 'Regime fiscale (es RF01)') &&
              (value == null || value.trim().isEmpty)) {
            return 'Obbligatorio';
          }
          return null;
        },
      ),
    );
  }
}

class YouDoxSettingsCard extends StatefulWidget {
