                        ),
                      ),
                      // 4 – Opportunità
                    ] else if (selectedIndex == 3) ...[
                      const _SectionTitle(
                        title: 'Opportunità',
                        subtitle:
                            'Pipeline vendite kanban – gestisci deal per stage.',
