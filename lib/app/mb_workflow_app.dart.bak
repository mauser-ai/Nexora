                              setState(() => _obscurePassword = !_obscurePassword),
                        ),
                      ),
                      validator: (v) =>
                          (v == null || v.trim().isEmpty) ? 'Obbligatorio' : null,
                    ),
                  ),
                  SizedBox(
                    width: 340,
                    child: TextFormField(
                      controller: _clientId,
                      decoration: const InputDecoration(
                        labelText: 'Client ID YouDOX',
                        border: OutlineInputBorder(),
                      ),
                      validator: (v) =>
                          (v == null || v.trim().isEmpty) ? 'Obbligatorio' : null,
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 12),
              Align(
                alignment: Alignment.centerRight,
                child: FilledButton(
                  onPressed: _saving
                      ? null
                      : () async {
                          if (!_formKey.currentState!.validate()) return;
                          setState(() => _saving = true);
                          try {
                            await widget.onSave(
                              YouDoxConfig(
                                username: _username.text.trim(),
                                password: _password.text.trim(),
                                clientId: _clientId.text.trim(),
                              ),
                            );
                            if (!context.mounted) return;
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text('Configurazione YouDOX salvata.'),
                              ),
                            );
                          } finally {
                            if (mounted) setState(() => _saving = false);
                          }
                        },
                  child: Text(_saving ? 'Salvataggio...' : 'Salva configurazione YouDOX'),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class InvoiceCenterCard extends StatelessWidget {
  const InvoiceCenterCard({
    super.key,
    required this.workspace,
    required this.onCreateInvoice,
    required this.onEditInvoice,
    required this.onDeleteInvoice,
    required this.onExportXml,
  });

  final WorkspaceSnapshot workspace;
  final VoidCallback onCreateInvoice;
  final void Function(InvoiceDraft invoice) onEditInvoice;
  final Future<void> Function(InvoiceDraft invoice) onDeleteInvoice;
  final Future<void> Function(InvoiceDraft invoice) onExportXml;

  @override
  Widget build(BuildContext context) {
    final companyById = {
      for (final company in workspace.companies) company.id: company.name,
    };

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Expanded(
                  child: Text(
                    'Fatture elettroniche',
                    style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ),
                FilledButton.icon(
                  onPressed: onCreateInvoice,
                  icon: const Icon(Icons.add),
                  label: const Text('Nuova fattura'),
                ),
              ],
            ),
            const SizedBox(height: 12),
            if (!workspace.billingProfile.isConfigured)
              Container(
                width: double.infinity,
                margin: const EdgeInsets.only(bottom: 12),
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: const Color(0xFFFFFFFF),
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: const Color(0xFF1E2130)),
                ),
                child: const Text(
                  'Compila prima i dati emittente in Impostazioni per esportare XML FatturaPA.',
                ),
              ),
            if (workspace.invoiceDrafts.isEmpty)
              const Text('Nessuna fattura disponibile.')
            else
              ...workspace.invoiceDrafts.map((invoice) {
                final companyName = companyById[invoice.companyId] ?? '-';
                return Container(
                  margin: const EdgeInsets.only(bottom: 10),
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: const Color(0xFFFFFFFF),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: const Color(0xFF1E2130)),
                  ),
                  child: Row(
                    children: [
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(
                              '${invoice.number} • $companyName',
                              style: Theme.of(context).textTheme.titleMedium
                                  ?.copyWith(fontWeight: FontWeight.w700),
                            ),
                            const SizedBox(height: 4),
                            Text(
                              'Totale € ${invoice.amount.toStringAsFixed(2)} • Stato ${invoice.status.name}',
                            ),
                          ],
                        ),
                      ),
                      IconButton(
                        tooltip: 'Modifica',
                        onPressed: () => onEditInvoice(invoice),
                        icon: const Icon(Icons.edit_outlined),
                      ),
                      IconButton(
                        tooltip: 'Esporta XML',
                        onPressed: () => onExportXml(invoice),
                        icon: const Icon(Icons.file_download_outlined),
                      ),
                      IconButton(
                        tooltip: 'Elimina',
                        onPressed: () async {
                          final confirmed = await showDialog<bool>(
                            context: context,
                            builder: (context) => AlertDialog(
                              title: const Text('Elimina fattura'),
                              content: Text(
                                'Vuoi eliminare ${invoice.number}?',
                              ),
                              actions: [
                                TextButton(
                                  onPressed: () =>
                                      Navigator.of(context).pop(false),
                                  child: const Text('Annulla'),
                                ),
                                FilledButton(
                                  onPressed: () =>
                                      Navigator.of(context).pop(true),
                                  style: FilledButton.styleFrom(
                                    backgroundColor: const Color(0xFF9F1239),
                                  ),
                                  child: const Text('Elimina'),
                                ),
                              ],
                            ),
                          );
                          if (confirmed == true) {
                            await onDeleteInvoice(invoice);
                          }
                        },
                        icon: const Icon(Icons.delete_outline),
                      ),
                    ],
                  ),
                );
              }),
          ],
        ),
      ),
    );
  }
}

class InvoiceEditorCard extends StatefulWidget {
  const InvoiceEditorCard({
    super.key,
    required this.workspace,
    required this.onSubmit,
    this.initialInvoice,
    this.preselectedCompanyId,
  });

  final WorkspaceSnapshot workspace;
  final InvoiceDraft? initialInvoice;
  final String? preselectedCompanyId;
  final Future<void> Function(
    InvoiceDraft invoice, {
    required DateTime issueDate,
    required DateTime dueDate,
    required String description,
    required double quantity,
    required double unitPrice,
    required double vatRate,
    required String recipientCode,
    required String recipientPec,
    required String paymentMethod,
  })
  onSubmit;

  @override
  State<InvoiceEditorCard> createState() => _InvoiceEditorCardState();
}

class _InvoiceEditorCardState extends State<InvoiceEditorCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _number;
  late final TextEditingController _description;
  late final TextEditingController _quantity;
  late final TextEditingController _unitPrice;
  late final TextEditingController _vatRate;
  late final TextEditingController _recipientCode;
  late final TextEditingController _recipientPec;
  String _paymentMethod = 'MP05';
  String? _companyId;
  DateTime _issueDate = DateTime.now();
  DateTime _dueDate = DateTime.now().add(const Duration(days: 30));
  InvoiceStatus _status = InvoiceStatus.draft;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    _number = TextEditingController(
      text:
          widget.initialInvoice?.number ?? '2026/${DateTime.now().millisecond}',
    );
    _description = TextEditingController(text: 'Prestazioni professionali');
    _quantity = TextEditingController(text: '1');
    _unitPrice = TextEditingController(
      text: widget.initialInvoice == null
          ? '0'
          : widget.initialInvoice!.amount.toStringAsFixed(2),
    );
    _vatRate = TextEditingController(text: '22');
    _recipientCode = TextEditingController(text: '0000000');
    _recipientPec = TextEditingController(text: '');
    _companyId =
        widget.initialInvoice?.companyId ?? widget.preselectedCompanyId;
    _status = widget.initialInvoice?.status ?? InvoiceStatus.draft;
  }

  @override
  void dispose() {
    _number.dispose();
    _description.dispose();
    _quantity.dispose();
    _unitPrice.dispose();
    _vatRate.dispose();
    _recipientCode.dispose();
    _recipientPec.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(20),
      child: Form(
        key: _formKey,
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Text(
                  widget.initialInvoice == null
                      ? 'Nuova fattura'
                      : 'Modifica fattura',
                  style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                    fontWeight: FontWeight.w700,
                  ),
                ),
                const Spacer(),
                IconButton(
                  onPressed: _saving ? null : () => Navigator.of(context).pop(),
                  icon: const Icon(Icons.close),
                ),
              ],
            ),
            const SizedBox(height: 12),
            Wrap(
              spacing: 12,
              runSpacing: 12,
              children: [
                SizedBox(
                  width: 260,
                  child: DropdownButtonFormField<String>(
                    value: _companyId,
                    decoration: const InputDecoration(
                      labelText: 'Cliente',
                      border: OutlineInputBorder(),
                    ),
                    validator: (value) =>
                        value == null ? 'Seleziona cliente' : null,
                    items: widget.workspace.companies
                        .map(
                          (company) => DropdownMenuItem(
                            value: company.id,
                            child: Text(company.name),
                          ),
                        )
                        .toList(),
                    onChanged: (value) => setState(() => _companyId = value),
                  ),
                ),
                _invoiceField(_number, 'Numero', 180),
                _invoiceField(_description, 'Descrizione riga', 260),
                _invoiceField(_quantity, 'Quantita', 120),
                _invoiceField(_unitPrice, 'Prezzo unitario', 140),
                _invoiceField(_vatRate, 'IVA %', 100),
                _invoiceField(_recipientCode, 'Codice destinatario', 170),
                _invoiceField(_recipientPec, 'PEC destinatario', 220),
                SizedBox(
                  width: 150,
                  child: DropdownButtonFormField<String>(
                    value: _paymentMethod,
                    decoration: const InputDecoration(
                      labelText: 'Pagamento',
                      border: OutlineInputBorder(),
                    ),
                    items: const [
                      DropdownMenuItem(value: 'MP05', child: Text('Bonifico')),
                      DropdownMenuItem(value: 'MP01', child: Text('Contanti')),
                      DropdownMenuItem(value: 'MP08', child: Text('Carta')),
                    ],
                    onChanged: (value) =>
                        setState(() => _paymentMethod = value ?? 'MP05'),
                  ),
                ),
                SizedBox(
                  width: 170,
                  child: DropdownButtonFormField<InvoiceStatus>(
                    value: _status,
                    decoration: const InputDecoration(
                      labelText: 'Stato',
                      border: OutlineInputBorder(),
                    ),
                    items: InvoiceStatus.values
                        .map(
                          (value) => DropdownMenuItem(
                            value: value,
                            child: Text(value.name),
                          ),
                        )
                        .toList(),
                    onChanged: (value) =>
                        setState(() => _status = value ?? _status),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            Wrap(
              spacing: 12,
              runSpacing: 12,
              children: [
                OutlinedButton.icon(
                  onPressed: () async {
                    final picked = await showDatePicker(
                      context: context,
                      initialDate: _issueDate,
                      firstDate: DateTime(2020),
                      lastDate: DateTime(2100),
                    );
                    if (picked != null) {
                      setState(() => _issueDate = picked);
                    }
                  },
                  icon: const Icon(Icons.calendar_today_outlined),
                  label: Text('Data ${_shortDate(_issueDate)}'),
                ),
                OutlinedButton.icon(
                  onPressed: () async {
                    final picked = await showDatePicker(
                      context: context,
                      initialDate: _dueDate,
                      firstDate: DateTime(2020),
                      lastDate: DateTime(2100),
                    );
                    if (picked != null) {
                      setState(() => _dueDate = picked);
                    }
                  },
                  icon: const Icon(Icons.event_outlined),
                  label: Text('Scadenza ${_shortDate(_dueDate)}'),
                ),
              ],
            ),
            const SizedBox(height: 12),
            Align(
              alignment: Alignment.centerRight,
              child: FilledButton(
                onPressed: _saving
                    ? null
                    : () async {
                        final messenger = ScaffoldMessenger.of(context);
                        final navigator = Navigator.of(context);
                        if (!_formKey.currentState!.validate()) {
                          return;
                        }
                        final quantity = _parseNumber(_quantity.text);
                        final unitPrice = _parseNumber(_unitPrice.text);
                        final vatRate = _parseNumber(_vatRate.text);
                        if (quantity <= 0 || unitPrice < 0 || vatRate < 0) {
                          messenger.showSnackBar(
                            const SnackBar(
                              content: Text('Valori numerici non validi.'),
                            ),
                          );
                          return;
                        }
                        setState(() => _saving = true);
                        try {
                          final net = quantity * unitPrice;
                          final total = net + (net * vatRate / 100);
                          final invoice = InvoiceDraft(
                            id:
                                widget.initialInvoice?.id ??
                                'inv-${DateTime.now().microsecondsSinceEpoch}',
                            companyId: _companyId!,
                            number: _number.text.trim(),
                            amount: total,
                            status: _status,
                          );
                          await widget.onSubmit(
                            invoice,
                            issueDate: _issueDate,
                            dueDate: _dueDate,
                            description: _description.text.trim(),
                            quantity: quantity,
                            unitPrice: unitPrice,
                            vatRate: vatRate,
                            recipientCode: _recipientCode.text.trim(),
                            recipientPec: _recipientPec.text.trim(),
                            paymentMethod: _paymentMethod,
                          );
                          if (!mounted) {
                            return;
                          }
                          messenger.showSnackBar(
                            const SnackBar(content: Text('Fattura salvata.')),
                          );
                          navigator.pop();
                        } finally {
                          if (mounted) {
                            setState(() => _saving = false);
                          }
                        }
                      },
                child: Text(_saving ? 'Salvataggio...' : 'Salva fattura'),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _invoiceField(
    TextEditingController controller,
    String label,
    double width,
  ) {
    return SizedBox(
      width: width,
      child: TextFormField(
        controller: controller,
        decoration: InputDecoration(
          labelText: label,
          border: const OutlineInputBorder(),
        ),
        validator: (value) {
          if ((label == 'Numero' ||
                  label == 'Descrizione riga' ||
                  label == 'Codice destinatario') &&
              (value == null || value.trim().isEmpty)) {
            return 'Obbligatorio';
          }
          return null;
        },
      ),
    );
  }
}

class TimelinePlannerCard extends StatefulWidget {
  const TimelinePlannerCard({
    super.key,
    required this.workspace,
    required this.currentUserId,
    required this.onAddTask,
    required this.onMoveSlot,
    required this.onResizeSlot,
    required this.onToggleTaskDone,
    required this.onEditTask,
    required this.onLogTime,
    required this.onLogTimeForDay,
    required this.onDeleteTimelineSlot,
    required this.visibleWeekStart,
    required this.onShiftWeek,
    required this.onScheduleTask,
    required this.onMoveTaskPlannedDay,
    required this.onDeleteTaskPlannedDay,
    required this.onAddTimeOnTaskDay,
    required this.selectedPlanningTaskId,
    required this.onSelectedPlanningTaskIdChanged,
    required this.onCommitResize,
    required this.onResizeStateChanged,
    this.expandToFill = false,
    this.showIntro = true,
    this.initialCalendarEnabled = false,
  });

  final WorkspaceSnapshot workspace;
  final String currentUserId;
  final VoidCallback onAddTask;
  final Future<void> Function(
    TimelineSlot slot,
    DateTime newDate,
    double startHour,
  )
  onMoveSlot;
  final Future<void> Function(TimelineSlot slot, double delta) onResizeSlot;
  final Future<void> Function(WorkTask task, bool done) onToggleTaskDone;
  final void Function(WorkTask task) onEditTask;
  final void Function(WorkTask task) onLogTime;
  final void Function(WorkTask task, DateTime day) onLogTimeForDay;
  final Future<void> Function(TimelineSlot slot) onDeleteTimelineSlot;
  final DateTime visibleWeekStart;
  final void Function(int delta) onShiftWeek;
  final Future<void> Function(
    WorkTask task,
    DateTime date,
    double startHour,
    double durationHours,
  )
  onScheduleTask;
  final Future<void> Function(WorkTask task, DateTime fromDay, DateTime toDay)
  onMoveTaskPlannedDay;
  final Future<void> Function(WorkTask task, DateTime day)
  onDeleteTaskPlannedDay;
  final Future<void> Function(WorkTask task, DateTime day, double deltaHours)
  onAddTimeOnTaskDay;
  final String? selectedPlanningTaskId;
  final ValueChanged<String?> onSelectedPlanningTaskIdChanged;
  final Future<void> Function(TimelineSlot slot, double delta) onCommitResize;
  final void Function(bool value) onResizeStateChanged;
  final bool expandToFill;
  final bool showIntro;
  final bool
  initialCalendarEnabled; // true → parte in modalità Calendario:Attivo

  @override
  State<TimelinePlannerCard> createState() => _TimelinePlannerCardState();
}

class _TimelinePlannerCardState extends State<TimelinePlannerCard> {
  final Map<String, double> _previewSlotHeights = {};
  bool _isSlotResizing = false;
  DateTime? _drawingDay;
  double? _drawingStartDy;
  double? _drawingCurrentDy;

  void _previewResizeSlot(TimelineSlot slot, double delta) {
    setState(() {
      final current = _previewSlotHeights[slot.id] ?? slot.plannedHours;
      _previewSlotHeights[slot.id] = (current + delta).clamp(0.5, 200.0);
    });
  }

  Future<void> _commitResizePreview(TimelineSlot slot, double delta) async {
    setState(() {
      _previewSlotHeights.remove(slot.id);
    });
    await widget.onCommitResize(slot, delta);
  }

  double _selectionStartHour(double startDy, double endDy) {
    final topDy = startDy <= endDy ? startDy : endDy;
    return _startHourFromLocalOffset(topDy);
  }

  double _selectionDurationHours(double startDy, double endDy) {
    final minDy = startDy <= endDy ? startDy : endDy;
    final maxDy = startDy <= endDy ? endDy : startDy;
    final startHour = _startHourFromLocalOffset(minDy);
    final endHour = _startHourFromLocalOffset(maxDy);
    final raw = ((endHour - startHour) + 0.5).clamp(0.5, 12.0).toDouble();
    return ((raw * 2).round() / 2).clamp(0.5, 12.0).toDouble();
  }

  Future<void> _openSchedulePopup({
    required DateTime day,
    required double startHour,
    required double durationHours,
  }) async {
    final ownOpenTasks =
        widget.workspace.tasks
            .where(
              (task) =>
                  task.assigneeId == widget.currentUserId &&
                  task.status != TaskStatus.done,
            )
            .toList()
          ..sort((a, b) => a.deadline.compareTo(b.deadline));
    final selectedTask = _firstWhereOrNull(
      ownOpenTasks,
      (task) => task.id == widget.selectedPlanningTaskId,
    );
    if (selectedTask != null) {
      await widget.onScheduleTask(selectedTask, day, startHour, durationHours);
      return;
    }
    if (widget.selectedPlanningTaskId != null) {
      widget.onSelectedPlanningTaskIdChanged(null);
    }

    final action = await showModalBottomSheet<String>(
      context: context,
      showDragHandle: true,
      builder: (context) {
        return SafeArea(
          child: Padding(
            padding: const EdgeInsets.fromLTRB(16, 8, 16, 16),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  'Slot: ${_weekdayShortName(day.weekday)} ${day.day}/${day.month} · ${_timeLabel(startHour)} · ${_formatHoursCompact(durationHours)}',
                  style: const TextStyle(
                    fontSize: 13,
                    fontWeight: FontWeight.w600,
                    color: Color(0xFFB8C0D8),
                  ),
                ),
                const SizedBox(height: 10),
                ListTile(
                  leading: const Icon(Icons.add_task_outlined),
                  title: const Text('Pianifica nuovo task'),
                  onTap: () => Navigator.of(context).pop('new'),
                ),
                ListTile(
                  leading: const Icon(Icons.playlist_add_check_circle_outlined),
                  title: const Text(
                    'Seleziona task esistente (assegnati a me)',
                  ),
                  onTap: () => Navigator.of(context).pop('existing'),
                ),
              ],
            ),
          ),
        );
      },
    );

    if (!mounted || action == null) {
      return;
    }

    if (action == 'new') {
      widget.onAddTask();
      return;
    }

    if (ownOpenTasks.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Non hai task aperti assegnati al momento.'),
        ),
      );
      return;
    }

    final selectedTaskId = await showDialog<String>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Seleziona task'),
        content: SizedBox(
          width: 560,
          height: 420,
          child: ListView.separated(
            itemCount: ownOpenTasks.length,
            separatorBuilder: (_, __) => const Divider(height: 1),
            itemBuilder: (context, index) {
              final task = ownOpenTasks[index];
              final company = _firstWhereOrNull(
                widget.workspace.companies,
                (item) => item.id == task.companyId,
              );
              return ListTile(
                dense: true,
                title: Text(
                  task.name,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
                subtitle: Text(
                  '${company?.name ?? 'Azienda'} · Scad. ${_shortDate(task.deadline)}',
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
                onTap: () => Navigator.of(context).pop(task.id),
              );
            },
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Annulla'),
          ),
        ],
      ),
    );

    if (!mounted || selectedTaskId == null) {
      return;
    }

    final task = ownOpenTasks.firstWhere((item) => item.id == selectedTaskId);
    widget.onSelectedPlanningTaskIdChanged(task.id);
    await widget.onScheduleTask(task, day, startHour, durationHours);
  }

  Widget _buildHourlyCalendarView(
    BuildContext context,
    List<DateTime> weekDays,
    Map<String, double> effectiveTaskPlannedHours,
  ) {
    const dayWidth = 300.0;
    const dayGap = 12.0;

    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFFFFFFFF),
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: const Color(0xFF1E2130)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(14, 12, 14, 8),
            child: Row(
              children: [
                const Expanded(
                  child: Text(
                    'Pianificato per giorno',
                    style: TextStyle(
                      fontWeight: FontWeight.w700,
                      color: Color(0xFFE4E8FF),
                    ),
                  ),
                ),
              ],
            ),
          ),
          const Divider(height: 1, color: Color(0xFF1E2130)),
          Expanded(
            child: SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              padding: const EdgeInsets.fromLTRB(12, 8, 12, 12),
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  for (var index = 0; index < weekDays.length; index++)
                    _buildPlannerDayColumn(
                      context,
                      weekDays[index],
                      dayWidth,
                      index == weekDays.length - 1 ? 0 : dayGap,
                      effectiveTaskPlannedHours,
                    ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPlannerDayColumn(
    BuildContext context,
    DateTime date,
    double dayWidth,
    double rightGap,
    Map<String, double> effectiveTaskPlannedHours,
  ) {
    final daySlots = widget.workspace.plannedSlots
        .where((slot) => _isSameDay(slot.date, date))
        .toList();
    final slotLayouts = _buildSlotLayouts(daySlots, _previewSlotHeights);

    return SizedBox(
      width: dayWidth,
      child: Padding(
        padding: EdgeInsets.only(right: rightGap),
        child: Container(
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: const Color(0xFFFFFFFF),
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: const Color(0xFF1E2130)),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                '${_weekdayName(date.weekday)} ${date.day}/${date.month}',
                style: Theme.of(
                  context,
                ).textTheme.titleMedium?.copyWith(fontWeight: FontWeight.w700),
              ),
              const SizedBox(height: 4),
              const SizedBox(height: 12),
              Expanded(
                child: SingleChildScrollView(
                  child: Builder(
                    builder: (gridContext) {
                      return GestureDetector(
                        behavior: HitTestBehavior.opaque,
                        onPanStart: (details) {
                          if (_isSlotResizing) {
                            return;
                          }
                          setState(() {
                            _drawingDay = date;
                            _drawingStartDy = details.localPosition.dy;
                            _drawingCurrentDy = details.localPosition.dy;
                          });
                        },
                        onPanUpdate: (details) {
                          if (_drawingDay == null ||
                              !_isSameDay(_drawingDay!, date)) {
                            return;
                          }
                          setState(() {
                            _drawingCurrentDy = details.localPosition.dy;
                          });
                        },
                        onPanEnd: (_) async {
                          if (_drawingDay == null ||
                              !_isSameDay(_drawingDay!, date) ||
                              _drawingStartDy == null ||
                              _drawingCurrentDy == null) {
                            return;
                          }
                          final startDy = _drawingStartDy!;
                          final endDy = _drawingCurrentDy!;
                          setState(() {
                            _drawingDay = null;
                            _drawingStartDy = null;
                            _drawingCurrentDy = null;
                          });
                          final startHour = _selectionStartHour(startDy, endDy);
                          final durationHours = _selectionDurationHours(
                            startDy,
                            endDy,
                          );
                          await _openSchedulePopup(
                            day: date,
                            startHour: startHour,
                            durationHours: durationHours,
                          );
                        },
                        onPanCancel: () {
                          setState(() {
                            _drawingDay = null;
                            _drawingStartDy = null;
                            _drawingCurrentDy = null;
                          });
                        },
                        child: Container(
                          decoration: BoxDecoration(
                            borderRadius: BorderRadius.circular(16),
                            border: Border.all(color: const Color(0xFF1E2130)),
                          ),
                          child: SizedBox(
                            height: _plannerHeight,
                            child: LayoutBuilder(
                              builder: (context, gridConstraints) {
                                final gridWidth = gridConstraints.maxWidth;
                                final isDrawingCurrentDay =
                                    _drawingDay != null &&
                                    _isSameDay(_drawingDay!, date) &&
                                    _drawingStartDy != null &&
                                    _drawingCurrentDy != null;
                                final selectionTop = isDrawingCurrentDay
                                    ? (_drawingStartDy! <= _drawingCurrentDy!
                                              ? _drawingStartDy!
                                              : _drawingCurrentDy!)
                                          .clamp(0.0, _plannerHeight)
                                          .toDouble()
                                    : 0.0;
                                final selectionBottom = isDrawingCurrentDay
                                    ? (_drawingStartDy! > _drawingCurrentDy!
                                              ? _drawingStartDy!
                                              : _drawingCurrentDy!)
                                          .clamp(0.0, _plannerHeight)
                                          .toDouble()
                                    : 0.0;
                                final selectionHeight = isDrawingCurrentDay
                                    ? (selectionBottom - selectionTop)
                                          .clamp(8.0, _plannerHeight)
                                          .toDouble()
                                    : 0.0;
                                return Stack(
                                  children: [
                                    Positioned.fill(
                                      child: Column(
                                        children: List.generate(
                                          _gridHours.length,
                                          (index) => Container(
                                            height: _timeSlotHeight,
                                            decoration: const BoxDecoration(
                                              border: Border(
                                                bottom: BorderSide(
                                                  color: Color(0xFF1E2130),
                                                ),
                                              ),
                                            ),
                                            child: Align(
                                              alignment: Alignment.topLeft,
                                              child: Padding(
                                                padding: const EdgeInsets.only(
                                                  left: 8,
                                                  top: 4,
                                                ),
                                                child: Text(
                                                  _timeLabel(_gridHours[index]),
                                                  style: Theme.of(context)
                                                      .textTheme
                                                      .labelSmall
                                                      ?.copyWith(
                                                        color: const Color(
                                                          0xFF9CA3AF,
                                                        ),
                                                      ),
                                                ),
                                              ),
                                            ),
                                          ),
                                        ),
                                      ),
                                    ),
                                    ...daySlots.map((slot) {
                                      final task = widget.workspace.tasks
                                          .firstWhere(
                                            (item) => item.id == slot.taskId,
                                          );
                                      final displayHours =
                                          _previewSlotHeights[slot.id] ??
                                          slot.plannedHours;
                                      final layout =
                                          slotLayouts[slot.id] ??
                                          const _TimelineSlotLayout(
                                            lane: 0,
                                            laneCount: 1,
                                          );
                                      final top =
                                          ((slot.startHour - _gridHours.first) *
                                                  _pixelsPerHour)
                                              .clamp(0.0, _plannerHeight - 40)
                                              .toDouble();
                                      final height =
                                          (displayHours * _pixelsPerHour)
                                              .clamp(44.0, _plannerHeight)
                                              .toDouble();
                                      const leftRail = 44.0;
                                      const edgePadding = 8.0;
                                      const laneGap = 6.0;
                                      final usableWidth =
                                          (gridWidth -
                                                  leftRail -
                                                  (edgePadding * 2))
                                              .clamp(72.0, 600.0);
                                      final laneWidth =
                                          ((usableWidth -
                                                      ((layout.laneCount - 1) *
                                                          laneGap)) /
                                                  layout.laneCount)
                                              .clamp(60.0, usableWidth)
                                              .toDouble();
                                      final left =
                                          leftRail +
                                          (layout.lane * (laneWidth + laneGap));
                                      return Positioned(
                                        left: left,
                                        width: laneWidth,
                                        top: top,
                                        height: height,
                                        child: _TaskSlotChip(
                                          task: task,
                                          slot: slot,
                                          displayHours: displayHours,
                                          totalPlannedHours:
                                              effectiveTaskPlannedHours[task
                                                  .id] ??
                                              0,
                                          backgroundColor: _taskPlanningColor(
                                            task,
                                          ),
                                          onEditTask: widget.onEditTask,
                                          onLogTime: widget.onLogTime,
                                          onDeleteTimelineSlot:
                                              widget.onDeleteTimelineSlot,
                                          onToggleTaskDone:
                                              widget.onToggleTaskDone,
                                          onResizeStateChanged: (value) {
                                            setState(() {
                                              _isSlotResizing = value;
                                            });
                                            widget.onResizeStateChanged(value);
                                          },
                                          onPreviewResize: _previewResizeSlot,
                                          onCommitResize: _commitResizePreview,
                                        ),
                                      );
                                    }),
                                    if (isDrawingCurrentDay)
                                      Positioned(
                                        left: 44,
                                        right: 8,
                                        top: selectionTop,
                                        height: selectionHeight,
                                        child: IgnorePointer(
                                          child: Container(
                                            decoration: BoxDecoration(
                                              color: const Color(
                                                0xFF034F3B,
                                              ).withValues(alpha: 0.22),
                                              borderRadius:
                                                  BorderRadius.circular(10),
                                              border: Border.all(
                                                color: GussoniBrand.primary,
                                                width: 1.4,
                                              ),
                                            ),
                                          ),
                                        ),
                                      ),
                                  ],
                                );
                              },
                            ),
                          ),
                        ),
                      );
                    },
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final weekDays = List.generate(
      7,
      (index) => widget.visibleWeekStart.add(Duration(days: index)),
    );
    final effectiveTaskPlannedHours = <String, double>{};
    for (final slot in widget.workspace.plannedSlots) {
      effectiveTaskPlannedHours.update(
        slot.taskId,
        (value) => value + slot.plannedHours,
        ifAbsent: () => slot.plannedHours,
      );
    }

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            LayoutBuilder(
              builder: (context, constraints) {
                final controls = Wrap(
                  spacing: 16,
                  runSpacing: 12,
                  crossAxisAlignment: WrapCrossAlignment.center,
                  children: [
                    if (widget.showIntro)
                      ConstrainedBox(
                        constraints: const BoxConstraints(maxWidth: 640),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(
                              'Timeline planner',
                              style: Theme.of(context).textTheme.headlineSmall
                                  ?.copyWith(fontWeight: FontWeight.w700),
                            ),
                            const SizedBox(height: 8),
                            const Text(
                              'Naviga settimana per settimana. Se aumenti la durata, la pianificazione salta i giorni OFF e continua sul primo giorno lavorativo utile.',
                            ),
                          ],
                        ),
                      ),
                    OutlinedButton.icon(
                      onPressed: () => widget.onShiftWeek(-1),
                      icon: const Icon(Icons.chevron_left),
                      label: const Text('Settimana prec.'),
                    ),
                    Text(_weekLabel(widget.visibleWeekStart)),
                    OutlinedButton.icon(
                      onPressed: () => widget.onShiftWeek(1),
                      icon: const Icon(Icons.chevron_right),
                      label: const Text('Settimana succ.'),
                    ),
                    if (widget.selectedPlanningTaskId != null)
                      Builder(
                        builder: (context) {
                          final planningTask = _firstWhereOrNull(
                            widget.workspace.tasks,
                            (task) => task.id == widget.selectedPlanningTaskId,
                          );
                          if (planningTask == null ||
                              planningTask.status == TaskStatus.done) {
                            WidgetsBinding.instance.addPostFrameCallback((_) {
                              if (mounted) {
                                widget.onSelectedPlanningTaskIdChanged(null);
                              }
                            });
                            return const SizedBox.shrink();
                          }
                          return Container(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 10,
                              vertical: 7,
                            ),
                            decoration: BoxDecoration(
                              color: const Color(0xFFF0FDF4),
                              borderRadius: BorderRadius.circular(999),
                              border: Border.all(
                                color: GussoniBrand.primary,
                              ),
                            ),
                            child: Row(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                Icon(
                                  Icons.task_alt_outlined,
                                  size: 14,
                                  color: GussoniBrand.primary,
                                ),
                                const SizedBox(width: 6),
                                Text(
                                  'Task in memoria: ${planningTask.name}',
                                  style: TextStyle(
                                    fontSize: 12,
                                    fontWeight: FontWeight.w700,
                                    color: GussoniBrand.primary,
                                  ),
                                ),
                                const SizedBox(width: 8),
                                InkWell(
                                  onTap: () => widget
                                      .onSelectedPlanningTaskIdChanged(null),
                                  child: Icon(
                                    Icons.close,
                                    size: 14,
                                    color: GussoniBrand.primary,
                                  ),
                                ),
                              ],
                            ),
                          );
                        },
                      ),
                  ],
                );
                final addTaskButton = FilledButton.icon(
                  onPressed: widget.onAddTask,
                  icon: const Icon(Icons.add_task),
                  label: const Text('Aggiungi task'),
                );
                if (constraints.maxWidth < 1120) {
                  return Wrap(
                    spacing: 16,
                    runSpacing: 12,
                    crossAxisAlignment: WrapCrossAlignment.center,
                    children: [controls, addTaskButton],
                  );
                }
                return Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(child: controls),
                    const SizedBox(width: 12),
                    addTaskButton,
                  ],
                );
              },
            ),
            const SizedBox(height: 20),
            if (widget.expandToFill)
              Expanded(
                child: _buildHourlyCalendarView(
                  context,
                  weekDays,
                  effectiveTaskPlannedHours,
                ),
              )
            else
              SizedBox(
                height: 620,
                child: _buildHourlyCalendarView(
                  context,
                  weekDays,
                  effectiveTaskPlannedHours,
                ),
              ),
          ],
        ),
      ),
    );
  }
}

class _TaskSlotChip extends StatefulWidget {
  const _TaskSlotChip({
    required this.task,
    required this.slot,
    required this.displayHours,
    required this.totalPlannedHours,
    required this.backgroundColor,
    required this.onEditTask,
    required this.onLogTime,
    required this.onDeleteTimelineSlot,
    required this.onToggleTaskDone,
    required this.onResizeStateChanged,
    required this.onPreviewResize,
    required this.onCommitResize,
  });

  final WorkTask task;
  final TimelineSlot slot;
  final double displayHours;
  final double totalPlannedHours;
  final Color backgroundColor;
  final void Function(WorkTask task) onEditTask;
  final void Function(WorkTask task) onLogTime;
  final Future<void> Function(TimelineSlot slot) onDeleteTimelineSlot;
  final Future<void> Function(WorkTask task, bool done) onToggleTaskDone;
  final void Function(bool value) onResizeStateChanged;
  final void Function(TimelineSlot slot, double delta) onPreviewResize;
  final Future<void> Function(TimelineSlot slot, double delta) onCommitResize;

  @override
  State<_TaskSlotChip> createState() => _TaskSlotChipState();
}

class _TaskSlotChipState extends State<_TaskSlotChip> {
  double _dragAccumulator = 0;
  late double _localDisplayHours;
  late double _pendingDelta;
  bool _isResizing = false;
  int? _resizePointer;
  double? _lastPointerY;

  Future<void> _openContextMenu(TapDownDetails details) async {
    final isDone = widget.task.status == TaskStatus.done;
    final overlay = Overlay.of(context).context.findRenderObject();
    if (overlay is! RenderBox) {
      return;
    }

    final selected = await showMenu<_TimelineSlotAction>(
      context: context,
      position: RelativeRect.fromRect(
        Rect.fromPoints(details.globalPosition, details.globalPosition),
        Offset.zero & overlay.size,
      ),
      items: [
        const PopupMenuItem(
          value: _TimelineSlotAction.removePlanned,
          child: Text('Rimuovi evento pianificato'),
        ),
        const PopupMenuItem(
          value: _TimelineSlotAction.editTask,
          child: Text('Modifica task'),
        ),
        const PopupMenuItem(
          value: _TimelineSlotAction.logTime,
          child: Text('Segna tempo'),
        ),
        PopupMenuItem(
          value: _TimelineSlotAction.markDone,
          child: Text(isDone ? 'Riapri' : 'Segna task come fatto'),
        ),
      ],
    );

    if (!mounted || selected == null) {
      return;
    }

    switch (selected) {
      case _TimelineSlotAction.removePlanned:
        await widget.onDeleteTimelineSlot(widget.slot);
        break;
      case _TimelineSlotAction.editTask:
        widget.onEditTask(widget.task);
        break;
      case _TimelineSlotAction.logTime:
        widget.onLogTime(widget.task);
        break;
      case _TimelineSlotAction.markDone:
        final confirmed = await showDialog<bool>(
          context: context,
          builder: (context) => AlertDialog(
            title: Text(isDone ? 'Riapri task' : 'Segna task come fatto'),
            content: Text(
              isDone
                  ? 'Confermi di riaprire "${widget.task.name}"?'
                  : 'Confermi che "${widget.task.name}" e completato?',
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.of(context).pop(false),
                child: const Text('Annulla'),
              ),
              FilledButton(
                onPressed: () => Navigator.of(context).pop(true),
                child: Text(isDone ? 'Riapri' : 'Conferma'),
              ),
            ],
          ),
        );
        if (confirmed == true) {
          await widget.onToggleTaskDone(widget.task, !isDone);
        }
        break;
    }
  }

  @override
  void didUpdateWidget(covariant _TaskSlotChip oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.slot.id != widget.slot.id) {
      _dragAccumulator = 0;
      _pendingDelta = 0;
      _localDisplayHours = widget.displayHours;
      if (_isResizing) {
        _isResizing = false;
        _resizePointer = null;
        _lastPointerY = null;
        widget.onResizeStateChanged(false);
      }
      return;
    }
    if (oldWidget.displayHours != widget.displayHours && _pendingDelta == 0) {
      _localDisplayHours = widget.displayHours;
    }
  }

  @override
  void dispose() {
    super.dispose();
  }

  void _handleResizeDrag(double deltaY) {
    _dragAccumulator += deltaY;

    while (_dragAccumulator >= _timeSlotHeight) {
      _dragAccumulator -= _timeSlotHeight;
      setState(() {
        _localDisplayHours = (_localDisplayHours + 0.5).clamp(0.5, 200.0);
        _pendingDelta = _localDisplayHours - widget.slot.plannedHours;
      });
    }

    while (_dragAccumulator <= -_timeSlotHeight) {
      _dragAccumulator += _timeSlotHeight;
      setState(() {
        _localDisplayHours = (_localDisplayHours - 0.5).clamp(0.5, 200.0);
        _pendingDelta = _localDisplayHours - widget.slot.plannedHours;
      });
    }
  }

  @override
  void initState() {
    super.initState();
    _localDisplayHours = widget.displayHours;
    _pendingDelta = 0;
  }

  @override
  Widget build(BuildContext context) {
    final isDone = widget.task.status == TaskStatus.done;
    final titleStyle = const TextStyle(
      color: const Color(0xFF0E1020),
      fontWeight: FontWeight.w700,
      fontSize: 11,
      height: 1.05,
    );
    final metaStyle = const TextStyle(
      color: Colors.white70,
      fontSize: 10,
      height: 1.0,
    );

    return Container(
      clipBehavior: Clip.hardEdge,
      padding: const EdgeInsets.fromLTRB(10, 10, 10, 0),
      decoration: BoxDecoration(
        color: _isPastDeadline(widget.slot.date, widget.task.deadline)
            ? const Color(0xFF9F1239)
            : widget.backgroundColor,
        borderRadius: BorderRadius.circular(18),
      ),
      child: Stack(
        children: [
          Positioned.fill(
            bottom: 10,
            child: LayoutBuilder(
              builder: (context, constraints) {
                final dense = constraints.maxHeight < 72;
                final ultraCompact = constraints.maxHeight < 38;
                final header = _TaskSlotHeader(
                  taskName: widget.task.name,
                  totalPlannedHours: _effectivePlannedTotal,
                  estimatedHours: widget.task.estimatedHours,
                  titleStyle: titleStyle,
                  metaStyle: metaStyle,
                  dense: dense,
                  ultraCompact: ultraCompact,
                );
                return AbsorbPointer(
                  absorbing: _isResizing,
                  child: GestureDetector(
                    behavior: HitTestBehavior.opaque,
                    onSecondaryTapDown: _openContextMenu,
                    child: header,
                  ),
                );
              },
            ),
          ),
          if (isDone)
            Positioned.fill(
              bottom: 10,
              child: IgnorePointer(
                ignoring: true,
                child: Container(
                  decoration: BoxDecoration(
                    color: Colors.black.withValues(alpha: 0.24),
                    borderRadius: BorderRadius.circular(16),
                  ),
                ),
              ),
            ),
          if (isDone)
            Positioned(
              top: 6,
              right: 6,
              child: IgnorePointer(
                child: Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 6,
                    vertical: 3,
                  ),
                  decoration: BoxDecoration(
                    color: const Color(0xFFECFDF3),
                    borderRadius: BorderRadius.circular(999),
                    border: Border.all(color: const Color(0xFF10B981)),
                  ),
                  child: const Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(Icons.check, size: 10, color: Color(0xFF047857)),
                      SizedBox(width: 3),
                      Text(
                        'fatto',
                        style: TextStyle(
                          fontSize: 9,
                          fontWeight: FontWeight.w700,
                          color: Color(0xFF065F46),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          Positioned(
            left: 0,
            right: 0,
            bottom: 0,
            child: MouseRegion(
              cursor: SystemMouseCursors.resizeUpDown,
              child: Listener(
                behavior: HitTestBehavior.opaque,
                onPointerDown: (event) {
                  if (event.buttons != kPrimaryMouseButton &&
                      event.kind == PointerDeviceKind.mouse) {
                    return;
                  }
                  _dragAccumulator = 0;
                  _resizePointer = event.pointer;
                  _lastPointerY = event.position.dy;
                  if (!_isResizing) {
                    setState(() => _isResizing = true);
                    widget.onResizeStateChanged(true);
                  }
                },
                onPointerMove: (event) {
                  if (!_isResizing ||
                      _resizePointer != event.pointer ||
                      _lastPointerY == null) {
                    return;
                  }
                  final deltaY = event.position.dy - _lastPointerY!;
                  _lastPointerY = event.position.dy;
                  _handleResizeDrag(deltaY);
                },
                child: SizedBox(
                  height: 10,
                  width: double.infinity,
                  child: Listener(
                    behavior: HitTestBehavior.opaque,
                    onPointerUp: (_) async {
                      if (_isResizing) {
                        setState(() => _isResizing = false);
                        _resizePointer = null;
                        _lastPointerY = null;
                        widget.onResizeStateChanged(false);
                      }
                      final delta = _pendingDelta;
                      _pendingDelta = 0;
                      _dragAccumulator = 0;
                      if (delta.abs() < 0.1) {
                        return;
                      }
                      await widget.onCommitResize(widget.slot, delta);
                    },
                    onPointerCancel: (_) {
                      _dragAccumulator = 0;
                      _pendingDelta = 0;
                      _localDisplayHours = widget.displayHours;
                      _resizePointer = null;
                      _lastPointerY = null;
                      if (_isResizing) {
                        setState(() => _isResizing = false);
                        widget.onResizeStateChanged(false);
                      }
                    },
                    child: const SizedBox.expand(),
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  double get _effectivePlannedTotal =>
      (widget.totalPlannedHours - widget.slot.plannedHours + _localDisplayHours)
          .clamp(0.5, 200.0)
          .toDouble();
}

enum _TimelineSlotAction { removePlanned, editTask, logTime, markDone }

enum _TaskDayMenuAction {
  movePrev,
  moveNext,
  logTime,
  adjustTime,
  removeDayPlan,
}

class _TaskDayDragData {
  const _TaskDayDragData({required this.task, required this.day});

  final WorkTask task;
  final DateTime day;
}

class _TaskDailyPlanningBoard extends StatelessWidget {
  const _TaskDailyPlanningBoard({
    required this.workspace,
    required this.tasks,
    required this.weekDays,
    required this.calendarEnabled,
    required this.onToggleCalendar,
    required this.onScheduleTask,
    required this.onLogTimeForDay,
    required this.onMoveTaskPlannedDay,
    required this.onDeleteTaskPlannedDay,
    required this.onAddTimeOnTaskDay,
  });

  final WorkspaceSnapshot workspace;
  final List<WorkTask> tasks;
  final List<DateTime> weekDays;
  final bool calendarEnabled;
  final ValueChanged<bool> onToggleCalendar;
  final Future<void> Function(
    WorkTask task,
    DateTime date,
    double startHour,
    double durationHours,
  )
  onScheduleTask;
  final void Function(WorkTask task, DateTime day) onLogTimeForDay;
  final Future<void> Function(WorkTask task, DateTime fromDay, DateTime toDay)
  onMoveTaskPlannedDay;
  final Future<void> Function(WorkTask task, DateTime day)
  onDeleteTaskPlannedDay;
  final Future<void> Function(WorkTask task, DateTime day, double deltaHours)
  onAddTimeOnTaskDay;

  Future<double?> _showManualDayDeltaDialog(
    BuildContext context, {
    required WorkTask task,
    required DateTime day,
    required double currentHours,
  }) async {
    final allTaskSlots = workspace.plannedSlots
        .where((slot) => slot.taskId == task.id)
        .toList();
    final totalPlanned = allTaskSlots.fold<double>(
      0,
      (sum, slot) => sum + slot.plannedHours,
    );
    final untilSelectedDay = allTaskSlots
        .where(
          (slot) => !DateTime(
            slot.date.year,
            slot.date.month,
            slot.date.day,
          ).isAfter(DateTime(day.year, day.month, day.day)),
        )
        .fold<double>(0, (sum, slot) => sum + slot.plannedHours);

    double delta = 0;
    final minDelta = -currentHours;
    String formatDelta(double value) {
      if (value == 0) {
        return '0 min';
      }
      final minutes = (value.abs() * 60).round();
      final sign = value > 0 ? '+' : '-';
      if (minutes < 60) {
        return '$sign$minutes min';
      }
      final hours = minutes ~/ 60;
      final remainMinutes = minutes % 60;
      if (remainMinutes == 0) {
        return '$sign${hours}h';
      }
      return '$sign${hours}h ${remainMinutes} min';
    }

    final result = await showDialog<double>(
      context: context,
      builder: (context) => StatefulBuilder(
        builder: (context, setModalState) => AlertDialog(
          title: const Text('Aggiungi o togli tempo'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                task.name,
                style: const TextStyle(fontWeight: FontWeight.w700),
              ),
              const SizedBox(height: 8),
              Text(
                'Pianificato sul giorno: ${_formatHoursCompact(currentHours)}',
              ),
              Text(
                'Pianificato totale task: ${_formatHoursCompact(totalPlanned)}',
              ),
              Text(
                'Pianificato fino a questo giorno: ${_formatHoursCompact(untilSelectedDay)}',
              ),
              const SizedBox(height: 14),
              Row(
                children: [
                  OutlinedButton(
                    onPressed: delta <= minDelta
                        ? null
                        : () {
                            setModalState(() {
                              delta = (delta - 0.5)
                                  .clamp(minDelta, 200)
                                  .toDouble();
                            });
                          },
                    child: const Text('-30 min'),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Center(
                      child: Text(
                        formatDelta(delta),
                        style: const TextStyle(
                          fontWeight: FontWeight.w800,
                          fontSize: 18,
                        ),
                      ),
                    ),
                  ),
                  const SizedBox(width: 12),
                  OutlinedButton(
                    onPressed: () {
                      setModalState(() {
                        delta = (delta + 0.5).clamp(minDelta, 200).toDouble();
                      });
                    },
                    child: const Text('+30 min'),
                  ),
                ],
              ),
              const SizedBox(height: 6),
              const Text(
                'Step: 30 minuti',
                style: TextStyle(fontSize: 12, color: Color(0xFF7D89A8)),
              ),
            ],
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(context).pop(),
              child: const Text('Annulla'),
            ),
            FilledButton(
              onPressed: delta == 0
                  ? null
                  : () => Navigator.of(context).pop(delta),
              child: const Text('Conferma'),
            ),
          ],
        ),
      ),
    );
    return result;
  }

  @override
  Widget build(BuildContext context) {
    if (weekDays.isEmpty) {
      return const SizedBox.shrink();
    }
    final plannedByTaskAndDay = <String, double>{};
    final plannedByDay = <String, double>{};
    final taskById = {for (final task in workspace.tasks) task.id: task};
    final plannedByCompanyAndDay = <String, double>{};
    for (final slot in workspace.plannedSlots) {
      final key =
          '${slot.taskId}-${slot.date.year}-${slot.date.month}-${slot.date.day}';
      plannedByTaskAndDay.update(
        key,
        (value) => value + slot.plannedHours,
        ifAbsent: () => slot.plannedHours,
      );
      final dayKey = '${slot.date.year}-${slot.date.month}-${slot.date.day}';
      plannedByDay.update(
        dayKey,
        (value) => value + slot.plannedHours,
        ifAbsent: () => slot.plannedHours,
      );
      final task = taskById[slot.taskId];
      if (task != null) {
        final companyDayKey =
            '${task.companyId}::${slot.date.year}-${slot.date.month}-${slot.date.day}';
        plannedByCompanyAndDay.update(
          companyDayKey,
          (value) => value + slot.plannedHours,
          ifAbsent: () => slot.plannedHours,
        );
      }
    }

    final visibleTasks = [...tasks]
      ..sort((a, b) => a.deadline.compareTo(b.deadline));

    if (visibleTasks.isEmpty) {
      return const SizedBox.shrink();
    }

    final tasksByCompanyId = <String, List<WorkTask>>{};
    for (final task in visibleTasks) {
      tasksByCompanyId.putIfAbsent(task.companyId, () => []).add(task);
    }
    final companyWeekTotals = <String, double>{};
    for (final entry in tasksByCompanyId.entries) {
      final companyId = entry.key;
      final total = weekDays.fold<double>(0, (sum, day) {
        final key = '${companyId}::${day.year}-${day.month}-${day.day}';
        return sum + (plannedByCompanyAndDay[key] ?? 0);
      });
      companyWeekTotals[companyId] = total;
    }

    const taskRowHeight = 54.0;
    const companyRowHeight = 34.0;
    const blockedDayBandColor = Color(0xFFF1F5F9);
    final blockedDayByKey = <String, bool>{};
    for (final day in weekDays) {
      final availability = workspace.availability.firstWhere(
        (entry) => entry.weekday == day.weekday,
        orElse: () => const UserAvailability(weekday: 0, hours: 0, isOff: true),
      );
      blockedDayByKey['${day.year}-${day.month}-${day.day}'] =
          availability.isOff || _isVacationDay(workspace.vacations, day);
    }
    final weekTotals = weekDays
        .map(
          (day) => plannedByDay['${day.year}-${day.month}-${day.day}'] ?? 0.0,
        )
        .toList();
    final weekMax = weekTotals.fold<double>(
      6.0,
      (maxValue, value) => value > maxValue ? value : maxValue,
    );

    return LayoutBuilder(
      builder: (context, constraints) {
        final containerWidth = constraints.maxWidth.isFinite
            ? constraints.maxWidth
            : 1280.0;
        final innerWidth = (containerWidth - 24).clamp(980.0, 2800.0);
        final leftColumnWidth = (innerWidth * 0.34).clamp(260.0, 440.0);
        final recapColumnWidth = (innerWidth * 0.14).clamp(150.0, 240.0);
        final daysAreaWidth = (innerWidth - leftColumnWidth - recapColumnWidth)
            .clamp(560.0, 2200.0);
        final dayCellWidth = daysAreaWidth / weekDays.length;
        final boardWidth =
            leftColumnWidth +
            (dayCellWidth * weekDays.length) +
            recapColumnWidth;

        return Container(
          decoration: BoxDecoration(
            color: const Color(0xFFFFFFFF),
            borderRadius: BorderRadius.circular(16),
            border: Border.all(color: const Color(0xFF1E2130)),
          ),
          child: SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      SizedBox(
                        width: boardWidth,
                        child: Row(
                          children: [
                            const Expanded(
                              child: Text(
                                'Pianificato per giorno',
                                style: TextStyle(
                                  fontWeight: FontWeight.w700,
                                  color: Color(0xFFE4E8FF),
                                ),
                              ),
                            ),
                            _PlanningInlineToggle(
                              calendarEnabled: calendarEnabled,
                              onChanged: onToggleCalendar,
                            ),
                          ],
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),
                  SizedBox(
                    height: 64,
                    child: Row(
                      crossAxisAlignment: CrossAxisAlignment.end,
                      children: [
                        SizedBox(width: leftColumnWidth),
                        ...List.generate(weekDays.length, (index) {
                          final day = weekDays[index];
                          final total = weekTotals[index];
                          final height = ((total / weekMax) * 44).clamp(4, 44);
                          final blocked =
                              blockedDayByKey['${day.year}-${day.month}-${day.day}'] ??
                              false;
                          return SizedBox(
                            width: dayCellWidth,
                            child: Container(
                              color: blocked
                                  ? blockedDayBandColor
                                  : Colors.transparent,
                              child: Center(
                                child: Tooltip(
                                  message: () {
                                    final buffer = StringBuffer()
                                      ..writeln(
                                        '${_weekdayName(day.weekday)} ${day.day}/${day.month}: ${_formatHoursCompact(total)} pianificate',
                                      )
                                      ..writeln()
                                      ..writeln('Recap settimana per giorno:');
                                    for (final weekDay in weekDays) {
                                      final weekDayKey =
                                          '${weekDay.year}-${weekDay.month}-${weekDay.day}';
                                      final weekDayHours =
                                          plannedByDay[weekDayKey] ?? 0;
                                      buffer.writeln(
                                        '- ${_weekdayShortName(weekDay.weekday)} ${weekDay.day}: ${_formatHoursCompact(weekDayHours)}',
                                      );
                                    }
                                    buffer
                                      ..writeln()
                                      ..writeln('Recap cliente (settimana):');
                                    final rankedCompanies =
                                        companyWeekTotals.entries
                                            .where((entry) => entry.value > 0)
                                            .toList()
                                          ..sort(
                                            (a, b) =>
                                                b.value.compareTo(a.value),
                                          );
                                    if (rankedCompanies.isEmpty) {
                                      buffer.writeln(
                                        '- Nessuna pianificazione',
                                      );
                                    } else {
                                      for (final companyEntry
                                          in rankedCompanies) {
                                        final company = _firstWhereOrNull(
                                          workspace.companies,
                                          (item) => item.id == companyEntry.key,
                                        );
                                        buffer.writeln(
                                          '- ${company?.name ?? 'Azienda non assegnata'}: ${_formatHoursCompact(companyEntry.value)}',
                                        );
                                      }
                                    }
                                    return buffer.toString().trimRight();
                                  }(),
                                  child: Column(
                                    mainAxisAlignment: MainAxisAlignment.end,
                                    children: [
                                      AnimatedContainer(
                                        duration: const Duration(
                                          milliseconds: 180,
                                        ),
                                        width: 52,
                                        height: height.toDouble(),
                                        decoration: BoxDecoration(
                                          color: GussoniBrand.primary,
                                          borderRadius: BorderRadius.circular(
                                            8,
                                          ),
                                        ),
                                      ),
                                      const SizedBox(height: 4),
                                      Text(
                                        total > 0
                                            ? _formatHoursCompact(total)
                                            : '0h',
                                        style: const TextStyle(
                                          fontSize: 11,
                                          color: Color(0xFF7D89A8),
                                          fontWeight: FontWeight.w600,
                                        ),
                                      ),
                                    ],
                                  ),
                                ),
                              ),
                            ),
                          );
                        }),
                        SizedBox(width: recapColumnWidth),
                      ],
                    ),
                  ),
                  const SizedBox(height: 8),
                  Container(
                    height: 38,
                    decoration: const BoxDecoration(
                      border: Border(
                        bottom: BorderSide(color: Color(0xFF1E2130)),
                      ),
                    ),
                    child: Row(
                      children: [
                        SizedBox(
                          width: leftColumnWidth,
                          child: Text(
                            'Cliente',
                            style: TextStyle(fontWeight: FontWeight.w700),
                          ),
                        ),
                        ...weekDays.map(
                          (day) => SizedBox(
                            width: dayCellWidth,
                            child: Container(
                              color:
                                  (blockedDayByKey['${day.year}-${day.month}-${day.day}'] ??
                                      false)
                                  ? blockedDayBandColor
                                  : Colors.transparent,
                              child: Text(
                                '${_weekdayShortName(day.weekday)} ${day.day}',
                                textAlign: TextAlign.center,
                                style: const TextStyle(
                                  fontWeight: FontWeight.w600,
                                ),
                              ),
                            ),
                          ),
                        ),
                        SizedBox(
                          width: recapColumnWidth,
                          child: Text(
                            'Recap',
                            textAlign: TextAlign.center,
                            style: TextStyle(fontWeight: FontWeight.w700),
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(height: 8),
                  ...tasksByCompanyId.entries.expand((entry) {
                    final companyId = entry.key;
                    final companyTasks = entry.value;
                    final company = _firstWhereOrNull(
                      workspace.companies,
                      (item) => item.id == companyId,
                    );
                    return [
                      SizedBox(
                        height: companyRowHeight,
                        child: Row(
                          children: [
                            SizedBox(
                              width: leftColumnWidth,
                              child: Text(
                                company?.name ?? 'Azienda non assegnata',
                                style: const TextStyle(
                                  fontWeight: FontWeight.w800,
                                  fontSize: 15,
                                ),
                              ),
                            ),
                            ...weekDays.map((day) {
                              final blocked =
                                  blockedDayByKey['${day.year}-${day.month}-${day.day}'] ??
                                  false;
                              return SizedBox(
                                width: dayCellWidth,
                                child: Container(
                                  color: blocked
                                      ? blockedDayBandColor
                                      : Colors.transparent,
                                ),
                              );
                            }),
                            SizedBox(
                              width: recapColumnWidth,
                              child: Builder(
                                builder: (context) {
                                  final companyWeekHours = companyTasks
                                      .fold<double>(
                                        0,
                                        (sum, task) =>
                                            sum +
                                            weekDays.fold<double>(0, (
                                              daySum,
                                              day,
                                            ) {
                                              final key =
                                                  '${task.id}-${day.year}-${day.month}-${day.day}';
                                              return daySum +
                                                  (plannedByTaskAndDay[key] ??
                                                      0);
                                            }),
                                      );
                                  return Text(
                                    '${_formatHoursCompact(companyWeekHours)} sett.',
                                    textAlign: TextAlign.center,
                                    style: const TextStyle(
                                      fontSize: 12,
                                      fontWeight: FontWeight.w700,
                                      color: Color(0xFFB8C0D8),
                                    ),
                                  );
                                },
                              ),
                            ),
                          ],
                        ),
                      ),
                      ...companyTasks.map((task) {
                        final taskColor = _taskPlanningColor(task);
                        final normalizedStart = DateTime(
                          task.startDate.year,
                          task.startDate.month,
                          task.startDate.day,
                        );
                        final normalizedEnd = DateTime(
                          task.deadline.year,
                          task.deadline.month,
                          task.deadline.day,
                        );
                        final weeklyPlanned = weekDays.fold<double>(0, (
                          sum,
                          day,
                        ) {
                          final key =
                              '${task.id}-${day.year}-${day.month}-${day.day}';
                          return sum + (plannedByTaskAndDay[key] ?? 0);
                        });
                        final totalPlanned = workspace.plannedSlots
                            .where((slot) => slot.taskId == task.id)
                            .fold<double>(
                              0,
                              (sum, slot) => sum + slot.plannedHours,
                            );
                        return Container(
                          height: taskRowHeight,
                          margin: const EdgeInsets.only(bottom: 6),
                          child: Row(
                            children: [
                              SizedBox(
                                width: leftColumnWidth,
                                child: Text(
                                  task.name,
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: const TextStyle(
                                    fontWeight: FontWeight.w600,
                                    color: Color(0xFFE4E8FF),
                                  ),
                                ),
                              ),
                              ...weekDays.map((day) {
                                final blocked =
                                    blockedDayByKey['${day.year}-${day.month}-${day.day}'] ??
                                    false;
                                final key =
                                    '${task.id}-${day.year}-${day.month}-${day.day}';
                                final hours = plannedByTaskAndDay[key] ?? 0;
                                final inRange =
                                    !day.isBefore(normalizedStart) &&
                                    !day.isAfter(normalizedEnd);
                                final prev = day.subtract(
                                  const Duration(days: 1),
                                );
                                final next = day.add(const Duration(days: 1));
                                final isRangeStart =
                                    inRange && (prev.isBefore(normalizedStart));
                                final isRangeEnd =
                                    inRange && (next.isAfter(normalizedEnd));
                                return SizedBox(
                                  width: dayCellWidth,
                                  child: Center(
                                    child: DragTarget<Object>(
                                      onWillAcceptWithDetails: (details) {
                                        if (blocked) {
                                          return false;
                                        }
                                        final data = details.data;
                                        final targetDay = DateTime(
                                          day.year,
                                          day.month,
                                          day.day,
                                        );
                                        if (data is WorkTask) {
                                          final taskStart = DateTime(
                                            data.startDate.year,
                                            data.startDate.month,
                                            data.startDate.day,
                                          );
                                          final taskEnd = DateTime(
                                            data.deadline.year,
                                            data.deadline.month,
                                            data.deadline.day,
                                          );
                                          return !targetDay.isBefore(
                                                taskStart,
                                              ) &&
                                              !targetDay.isAfter(taskEnd);
                                        }
                                        if (data is _TaskDayDragData) {
                                          final taskStart = DateTime(
                                            data.task.startDate.year,
                                            data.task.startDate.month,
                                            data.task.startDate.day,
                                          );
                                          final taskEnd = DateTime(
                                            data.task.deadline.year,
                                            data.task.deadline.month,
                                            data.task.deadline.day,
                                          );
                                          if (targetDay.isBefore(taskStart)) {
                                            return false;
                                          }
                                          if (targetDay.isAfter(taskEnd)) {
                                            return false;
                                          }
                                          final from = DateTime(
                                            data.day.year,
                                            data.day.month,
                                            data.day.day,
                                          );
                                          return from != targetDay;
                                        }
                                        return false;
                                      },
                                      onAcceptWithDetails: (details) async {
                                        final dropped = details.data;
                                        if (dropped is WorkTask) {
                                          await onScheduleTask(
                                            dropped,
                                            day,
                                            9,
                                            1,
                                          );
                                        } else if (dropped
                                            is _TaskDayDragData) {
                                          await onMoveTaskPlannedDay(
                                            dropped.task,
                                            dropped.day,
                                            day,
                                          );
                                        }
                                      },
                                      builder: (context, candidateData, rejectedData) {
                                        final highlighted =
                                            candidateData.isNotEmpty;
                                        final cell = GestureDetector(
                                          behavior: HitTestBehavior.opaque,
                                          onSecondaryTapDown: (details) async {
                                            final overlay = Overlay.of(
                                              context,
                                            ).context.findRenderObject();
                                            if (overlay is! RenderBox) {
                                              return;
                                            }
                                            final dayIndex = weekDays.indexOf(
                                              day,
                                            );
                                            final canMovePrev = dayIndex > 0;
                                            final canMoveNext =
                                                dayIndex >= 0 &&
                                                dayIndex < weekDays.length - 1;
                                            final selected =
                                                await showMenu<
                                                  _TaskDayMenuAction
                                                >(
                                                  context: context,
                                                  position:
                                                      RelativeRect.fromRect(
                                                        Rect.fromPoints(
                                                          details
                                                              .globalPosition,
                                                          details
                                                              .globalPosition,
                                                        ),
                                                        Offset.zero &
                                                            overlay.size,
                                                      ),
                                                  items: [
                                                    if (canMovePrev)
                                                      const PopupMenuItem(
                                                        value:
                                                            _TaskDayMenuAction
                                                                .movePrev,
                                                        child: Text(
                                                          'Sposta al giorno precedente',
                                                        ),
                                                      ),
                                                    if (canMoveNext)
                                                      const PopupMenuItem(
                                                        value:
                                                            _TaskDayMenuAction
                                                                .moveNext,
                                                        child: Text(
                                                          'Sposta al giorno successivo',
                                                        ),
                                                      ),
                                                    const PopupMenuItem(
                                                      value: _TaskDayMenuAction
                                                          .logTime,
                                                      child: Text(
                                                        'Segna tempo',
                                                      ),
                                                    ),
                                                    const PopupMenuItem(
                                                      value: _TaskDayMenuAction
                                                          .adjustTime,
                                                      child: Text(
                                                        'Aggiungi/Togli tempo',
                                                      ),
                                                    ),
                                                    const PopupMenuItem(
                                                      value: _TaskDayMenuAction
                                                          .removeDayPlan,
                                                      child: Text(
                                                        'Elimina pianificazione giorno',
                                                      ),
                                                    ),
                                                  ],
                                                );
                                            if (selected == null) {
                                              return;
                                            }
                                            switch (selected) {
                                              case _TaskDayMenuAction.movePrev:
                                                if (canMovePrev) {
                                                  await onMoveTaskPlannedDay(
                                                    task,
                                                    day,
                                                    weekDays[dayIndex - 1],
                                                  );
                                                }
                                                break;
                                              case _TaskDayMenuAction.moveNext:
                                                if (canMoveNext) {
                                                  await onMoveTaskPlannedDay(
                                                    task,
                                                    day,
                                                    weekDays[dayIndex + 1],
                                                  );
                                                }
                                                break;
                                              case _TaskDayMenuAction.logTime:
                                                onLogTimeForDay(task, day);
                                                break;
                                              case _TaskDayMenuAction
                                                  .adjustTime:
                                                final delta =
                                                    await _showManualDayDeltaDialog(
                                                      context,
                                                      task: task,
                                                      day: day,
                                                      currentHours: hours,
                                                    );
                                                if (delta != null &&
                                                    delta != 0) {
                                                  await onAddTimeOnTaskDay(
                                                    task,
                                                    day,
                                                    delta,
                                                  );
                                                }
                                                break;
                                              case _TaskDayMenuAction
                                                  .removeDayPlan:
                                                await onDeleteTaskPlannedDay(
                                                  task,
                                                  day,
                                                );
                                                break;
                                            }
                                          },
                                          child: Container(
                                            width: dayCellWidth - 8,
                                            height: 38,
                                            alignment: Alignment.center,
                                            decoration: BoxDecoration(
                                              color: blocked
                                                  ? blockedDayBandColor
                                                  : inRange
                                                  ? taskColor.withValues(
                                                      alpha: hours > 0
                                                          ? 0.46
                                                          : 0.20,
                                                    )
                                                  : Colors.transparent,
                                              borderRadius:
                                                  BorderRadius.horizontal(
                                                    left: Radius.circular(
                                                      isRangeStart ? 10 : 0,
                                                    ),
                                                    right: Radius.circular(
                                                      isRangeEnd ? 10 : 0,
                                                    ),
                                                  ),
                                              border: highlighted
                                                  ? Border.all(
                                                      color: const Color(
                                                        0xFF034F3B,
                                                      ),
                                                      width: 2,
                                                    )
                                                  : inRange
                                                  ? Border.all(
                                                      color: taskColor
                                                          .withValues(
                                                            alpha: 0.80,
                                                          ),
                                                      width: 1,
                                                    )
                                                  : null,
                                            ),
                                            child: Text(
                                              hours > 0
                                                  ? _formatHoursCompact(hours)
                                                  : '',
                                              style: const TextStyle(
                                                fontSize: 12,
                                                fontWeight: FontWeight.w700,
                                                color: Color(0xFFE4E8FF),
                                              ),
                                            ),
                                          ),
                                        );
                                        if (hours <= 0) {
                                          return cell;
                                        }
                                        return Draggable<Object>(
                                          data: _TaskDayDragData(
                                            task: task,
                                            day: day,
                                          ),
                                          rootOverlay: true,
                                          feedback: Material(
                                            color: Colors.transparent,
                                            child: Container(
                                              width: dayCellWidth - 8,
                                              height: 38,
                                              alignment: Alignment.center,
                                              decoration: BoxDecoration(
                                                color: taskColor.withValues(
                                                  alpha: 0.60,
                                                ),
                                                borderRadius:
                                                    BorderRadius.circular(10),
                                                border: Border.all(
                                                  color: taskColor.withValues(
                                                    alpha: 0.90,
                                                  ),
                                                  width: 1,
                                                ),
                                              ),
                                              child: Text(
                                                _formatHoursCompact(hours),
                                                style: const TextStyle(
                                                  fontSize: 12,
                                                  fontWeight: FontWeight.w700,
                                                  color: Color(0xFFE4E8FF),
                                                ),
                                              ),
                                            ),
                                          ),
                                          childWhenDragging: Opacity(
                                            opacity: 0.30,
                                            child: cell,
                                          ),
                                          child: cell,
                                        );
                                      },
                                    ),
                                  ),
                                );
                              }),
                              SizedBox(
                                width: recapColumnWidth,
                                child: Text(
                                  '${_formatHoursCompact(weeklyPlanned)} sett. | ${_formatHoursCompact(totalPlanned)}/${_formatHoursCompact(task.estimatedHours)}',
                                  textAlign: TextAlign.center,
                                  maxLines: 2,
                                  overflow: TextOverflow.ellipsis,
                                  style: const TextStyle(
                                    fontSize: 11,
                                    fontWeight: FontWeight.w700,
                                    color: Color(0xFFE4E8FF),
                                  ),
                                ),
                              ),
                            ],
                          ),
                        );
                      }),
                      const Divider(color: Color(0xFF1E2130), height: 14),
                    ];
                  }),
                ],
              ),
            ),
          ),
        );
      },
    );
  }
}

class _PlanningInlineToggle extends StatelessWidget {
  const _PlanningInlineToggle({
    required this.calendarEnabled,
    required this.onChanged,
  });

  final bool calendarEnabled;
  final ValueChanged<bool> onChanged;

  @override
  Widget build(BuildContext context) {
    final icon = calendarEnabled
        ? Icons.calendar_view_day_outlined
        : Icons.view_column_outlined;
    final label = calendarEnabled ? 'Attivo' : 'Disattivo';
    final bgColor = calendarEnabled
        ? GussoniBrand.primary.withValues(alpha: 0.12)
        : const Color(0xFF0C0E1A);
    final borderColor = calendarEnabled
        ? GussoniBrand.primary
        : const Color(0xFF1E2130);
    final textColor = calendarEnabled
        ? GussoniBrand.primary
        : const Color(0xFFB8C0D8);
    return InkWell(
      borderRadius: BorderRadius.circular(999),
      onTap: () => onChanged(!calendarEnabled),
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 7),
        decoration: BoxDecoration(
          color: bgColor,
          borderRadius: BorderRadius.circular(999),
          border: Border.all(color: borderColor),
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(icon, size: 16, color: textColor),
            const SizedBox(width: 8),
            Text(
              'Calendario: $label',
              style: TextStyle(
                fontSize: 12,
                fontWeight: FontWeight.w700,
                color: textColor,
              ),
            ),
          ],
        ),
      ),
    );
  }
}

