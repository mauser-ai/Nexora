                                    members: _teamInfo?.activeMembers ?? [],
                                    selectedMemberId: _selectedMemberId,
                                    onMemberChanged: (id) => setState(() {
                                      _selectedMemberId = id ?? widget.user.uid;
                                      _syncTeamSubscriptions();
                                    }),
                                    memberSlots: {
                                      for (final entry in _memberTasksCache.entries)
