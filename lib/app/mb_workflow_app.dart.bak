class VacationSettingsCard extends StatefulWidget {
  const VacationSettingsCard({
    super.key,
    required this.vacations,
    required this.onCreateVacation,
    required this.onDeleteVacation,
  });

  final List<VacationPeriod> vacations;
  final Future<void> Function(VacationPeriod vacation) onCreateVacation;
  final Future<void> Function(VacationPeriod vacation) onDeleteVacation;

  @override
  State<VacationSettingsCard> createState() => _VacationSettingsCardState();
}

class _VacationSettingsCardState extends State<VacationSettingsCard> {
  DateTime? _startDate;
  DateTime? _endDate;
  final _labelController = TextEditingController();

  @override
  void dispose() {
    _labelController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Ferie e blocchi calendario',
              style: Theme.of(
                context,
              ).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 8),
            const Text(
              'Inserisci un range date in cui la timeline non puo accettare task.',
            ),
            const SizedBox(height: 16),
            Row(
              children: [
                Expanded(
                  child: OutlinedButton(
                    onPressed: () async {
                      final picked = await showDatePicker(
                        context: context,
                        initialDate: _startDate ?? DateTime.now(),
                        firstDate: DateTime.now().subtract(
                          const Duration(days: 365),
                        ),
                        lastDate: DateTime.now().add(const Duration(days: 730)),
                      );
                      if (picked != null) {
                        setState(() => _startDate = picked);
                      }
                    },
                    child: Padding(
                      padding: const EdgeInsets.symmetric(vertical: 16),
                      child: Text(
                        _startDate == null
                            ? 'Data inizio'
                            : 'Dal ${_shortDate(_startDate!)}',
                      ),
                    ),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: OutlinedButton(
                    onPressed: () async {
                      final picked = await showDatePicker(
                        context: context,
                        initialDate: _endDate ?? _startDate ?? DateTime.now(),
                        firstDate:
                            _startDate ??
                            DateTime.now().subtract(const Duration(days: 365)),
                        lastDate: DateTime.now().add(const Duration(days: 730)),
                      );
                      if (picked != null) {
                        setState(() => _endDate = picked);
                      }
                    },
                    child: Padding(
                      padding: const EdgeInsets.symmetric(vertical: 16),
                      child: Text(
                        _endDate == null
                            ? 'Data fine'
                            : 'Al ${_shortDate(_endDate!)}',
                      ),
                    ),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            TextField(
              controller: _labelController,
              decoration: const InputDecoration(
                labelText: 'Etichetta facoltativa',
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 12),
            Align(
              alignment: Alignment.centerRight,
              child: FilledButton(
                onPressed: () async {
                  if (_startDate == null || _endDate == null) {
                    return;
                  }
                  final start = _startDate!;
                  final end = _endDate!;
                  final normalizedStart = DateTime(
                    start.year,
                    start.month,
                    start.day,
                  );
                  final normalizedEnd = DateTime(end.year, end.month, end.day);
                  final vacation = VacationPeriod(
                    id: 'vac-${DateTime.now().microsecondsSinceEpoch}',
                    startDate: normalizedStart,
                    endDate: normalizedEnd.isBefore(normalizedStart)
                        ? normalizedStart
                        : normalizedEnd,
                    label: _labelController.text.trim(),
                  );
                  await widget.onCreateVacation(vacation);
                  if (!mounted) {
                    return;
                  }
                  setState(() {
                    _startDate = null;
                    _endDate = null;
                    _labelController.clear();
                  });
                },
                child: const Text('Aggiungi ferie'),
              ),
            ),
            const SizedBox(height: 16),
            ...widget.vacations.map(
              (vacation) => Container(
                margin: const EdgeInsets.only(bottom: 10),
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  color: const Color(0xFFFFFFFF),
                  borderRadius: BorderRadius.circular(16),
                ),
                child: Row(
                  children: [
                    Expanded(
                      child: Text(
                        '${vacation.label.isEmpty ? 'Ferie' : vacation.label} | ${_shortDate(vacation.startDate)} - ${_shortDate(vacation.endDate)}',
                      ),
                    ),
                    IconButton(
                      onPressed: () async {
                        await widget.onDeleteVacation(vacation);
                      },
                      icon: const Icon(Icons.delete_outline),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class NotificationsCard extends StatelessWidget {
  const NotificationsCard({super.key, required this.workspace});

  final WorkspaceSnapshot workspace;

  @override
  Widget build(BuildContext context) {
    final now = DateTime.now();
    final overdue = workspace.tasks
        .where(
          (task) =>
              task.deadline.isBefore(now) && task.status != TaskStatus.done,
        )
        .toList();
    final atRisk = workspace.tasks
        .where(
          (task) =>
              task.remainingHours > 0 &&
              task.deadline.difference(now).inDays <= 2,
        )
        .toList();
    final unplanned = workspace.tasks.where((task) {
      final planned = workspace.plannedSlots
          .where((slot) => slot.taskId == task.id)
          .fold<double>(0, (sum, slot) => sum + slot.plannedHours);
      return task.status != TaskStatus.done && planned < task.remainingHours;
    }).toList();

    final items = <String>[
      if (overdue.isNotEmpty) '${overdue.length} task scaduti e non completati',
      if (atRisk.isNotEmpty) '${atRisk.length} task con deadline entro 48 ore',
      if (unplanned.isNotEmpty)
        '${unplanned.length} task non coperti interamente in timeline',
      if (overdue.isEmpty && atRisk.isEmpty && unplanned.isEmpty)
        'Nessuna anomalia operativa rilevata',
    ];

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Notifiche operative',
              style: Theme.of(
                context,
              ).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 12),
            ...items.map(
              (item) => Padding(
                padding: const EdgeInsets.only(bottom: 8),
                child: Row(
                  children: [
                    const Icon(Icons.notifications_active_outlined, size: 18),
                    const SizedBox(width: 8),
                    Expanded(child: Text(item)),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 8),
            Text(
              'Questa e una notification layer in-app. Le web push via Firebase Messaging richiedono una configurazione separata con service worker e VAPID key.',
              style: Theme.of(context).textTheme.bodySmall,
            ),
          ],
        ),
      ),
    );
  }
}

