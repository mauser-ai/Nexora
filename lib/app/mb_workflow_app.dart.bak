              surface: const Color(0xFF0E1020),
              onSurface: const Color(0xFFE4E8FF),
              surfaceContainerHighest: const Color(0xFF141627),
            ),
            cardTheme: CardThemeData(
              color: const Color(0xFF0E1020),
              shadowColor: Colors.black45,
              elevation: 0,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
                side: const BorderSide(color: Color(0xFF1E2130)),
              ),
            ),
            dividerTheme: const DividerThemeData(color: Color(0xFF1E2130)),
            textSelectionTheme: TextSelectionThemeData(
              cursorColor: brandColor,
              selectionColor: brandColor.withOpacity(.3),
              selectionHandleColor: brandColor,
            ),
            inputDecorationTheme: InputDecorationTheme(
              isDense: true,
              filled: true,
              fillColor: const Color(0xFF0A0C18),
              contentPadding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
              labelStyle: const TextStyle(color: Color(0xFF7D89A8), fontSize: 13),
              hintStyle: const TextStyle(color: Color(0xFF3D4560), fontSize: 13),
              prefixIconColor: const Color(0xFF525D78),
              suffixIconColor: const Color(0xFF525D78),
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(8),
                borderSide: const BorderSide(color: Color(0xFF1E2130)),
              ),
              enabledBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(8),
                borderSide: const BorderSide(color: Color(0xFF1E2130)),
              ),
              focusedBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(8),
                borderSide: BorderSide(color: brandColor, width: 1.5),
              ),
            ),
            filledButtonTheme: FilledButtonThemeData(
              style: FilledButton.styleFrom(
                backgroundColor: brandColor,
