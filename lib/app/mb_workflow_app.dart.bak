  Future<void> _rebuildTimeline(
    WorkspaceSnapshot workspace,
    List<UserAvailability> availability,
    List<VacationPeriod> vacations, {
    Map<String, DateTime>? forcedStarts,
  }) async {
    final alreadyPlanned = <DateTime, double>{};
    final nextSlots = <TimelineSlot>[];
    final taskById = {for (final task in workspace.tasks) task.id: task};
    final preservedSlots = workspace.plannedSlots.where((slot) {
      final task = taskById[slot.taskId];
      if (task == null) {
        return false;
      }
      return _taskRegistryStatus(task) != _TaskRegistryStatus.open;
    }).toList();
    for (final slot in preservedSlots) {
      nextSlots.add(slot);
      alreadyPlanned.update(
        slot.date,
        (value) => value + slot.plannedHours,
        ifAbsent: () => slot.plannedHours,
      );
    }
    final trackedHoursByTaskId = <String, double>{};
    for (final track in workspace.timeTracks) {
      if (track.taskId.isEmpty) {
        continue;
      }
      trackedHoursByTaskId.update(
        track.taskId,
        (value) => value + track.hours,
        ifAbsent: () => track.hours,
      );
    }
    final activeTasks =
        workspace.tasks
            .where(
              (task) => _taskRegistryStatus(task) == _TaskRegistryStatus.open,
            )
            .toList()
          ..sort((a, b) => a.deadline.compareTo(b.deadline));
    final blockedDates = _blockedDatesFromVacations(vacations);

    for (final task in activeTasks) {
      final rawStartDate = forcedStarts?[task.id] ?? task.startDate;
      final startDate = rawStartDate.isAfter(task.deadline)
          ? task.deadline
          : rawStartDate;
      final tracked = trackedHoursByTaskId[task.id] ?? 0;
      final effectiveLogged = tracked > 0 ? tracked : task.loggedHours;
      final effectiveTask = task.copyWith(
        loggedHours: effectiveLogged.clamp(0, task.estimatedHours),
      );
      final result = _planner.distributeTask(
        task: effectiveTask,
        startDate: startDate,
        endDate: task.deadline,
        weeklyAvailability: availability,
        blockedDates: blockedDates,
        alreadyPlannedHours: alreadyPlanned,
      );
      nextSlots.addAll(result.slots);
    }

    await _repository.replaceTimelineSlots(widget.user.uid, nextSlots);
    _syncPlanningAfterChange(workspace.copyWith(plannedSlots: nextSlots));
  }

  void _shiftWeek(int delta) {
    setState(() {
      visibleWeekStart = visibleWeekStart.add(Duration(days: delta * 7));
    });
  }

