class TaskRegistryCard extends StatefulWidget {
  const TaskRegistryCard({
    super.key,
    required this.workspace,
    required this.tasks,
    required this.onToggleTaskDone,
    required this.onEditTask,
    required this.onLogTime,
    required this.onDeleteTask,
  });

  final WorkspaceSnapshot workspace;
  final List<WorkTask> tasks;
  final Future<void> Function(WorkTask task, bool done) onToggleTaskDone;
  final void Function(WorkTask task) onEditTask;
  final void Function(WorkTask task) onLogTime;
  final Future<void> Function(WorkTask task) onDeleteTask;

  @override
  State<TaskRegistryCard> createState() => _TaskRegistryCardState();
}

class _TaskRegistryCardState extends State<TaskRegistryCard> {
  static const _rowsPerPage = 10;
  int _page = 0;

  int get _maxPage {
    if (widget.tasks.isEmpty) {
      return 0;
    }
    return (widget.tasks.length - 1) ~/ _rowsPerPage;
  }

  @override
  void didUpdateWidget(covariant TaskRegistryCard oldWidget) {
    super.didUpdateWidget(oldWidget);
    final maxPage = _maxPage;
    if (_page > maxPage) {
      _page = maxPage;
    }
  }

  @override
  Widget build(BuildContext context) {
    final sortedTasks = [...widget.tasks]
      ..sort((a, b) => a.deadline.compareTo(b.deadline));
    final companyById = {
      for (final company in widget.workspace.companies)
        company.id: company.name,
    };
    final plannedHoursByTaskId = <String, double>{};
    for (final slot in widget.workspace.plannedSlots) {
      plannedHoursByTaskId.update(
        slot.taskId,
        (value) => value + slot.plannedHours,
        ifAbsent: () => slot.plannedHours,
      );
    }
    final spentHoursByTaskId = <String, double>{};
    for (final track in widget.workspace.timeTracks) {
      if (track.taskId.isEmpty) {
        continue;
      }
      spentHoursByTaskId.update(
        track.taskId,
        (value) => value + track.hours,
        ifAbsent: () => track.hours,
      );
    }
    final start = _page * _rowsPerPage;
    final end = (start + _rowsPerPage).clamp(0, sortedTasks.length);
    final pageItems = sortedTasks.sublist(start, end);

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Elenco task',
              style: Theme.of(
                context,
              ).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 12),
            LayoutBuilder(
              builder: (context, constraints) => SingleChildScrollView(
                scrollDirection: Axis.horizontal,
                child: ConstrainedBox(
                  constraints: BoxConstraints(
                    minWidth: constraints.maxWidth < 1160
                        ? 1160
                        : constraints.maxWidth,
                  ),
                  child: DataTable(
                    columns: const [
                      DataColumn(label: Text('Nome task')),
                      DataColumn(label: Text('Azienda')),
                      DataColumn(label: Text('Stato task')),
                      DataColumn(label: Text('Pianificato')),
                      DataColumn(label: Text('Previsto')),
                      DataColumn(label: Text('Speso')),
                      DataColumn(label: Text('Azioni')),
                    ],
                    rows: pageItems.map((task) {
                      final planned = plannedHoursByTaskId[task.id] ?? 0;
                      final companyName = companyById[task.companyId] ?? '-';
                      final tracked = spentHoursByTaskId[task.id];
                      final spent = tracked != null && tracked > 0
                          ? tracked
                          : task.loggedHours;
                      return DataRow(
                        cells: [
                          DataCell(Text(task.name)),
                          DataCell(Text(companyName)),
                          DataCell(Text(_taskStatusLabel(task.status))),
                          DataCell(Text('${planned.toStringAsFixed(1)}h')),
                          DataCell(
                            Text('${task.estimatedHours.toStringAsFixed(1)}h'),
                          ),
                          DataCell(Text('${spent.toStringAsFixed(1)}h')),
                          DataCell(
                            _TaskActionsMenu(
                              task: task,
                              onEditTask: widget.onEditTask,
                              onToggleTaskDone: widget.onToggleTaskDone,
                              onLogTime: widget.onLogTime,
                              onDeleteTask: widget.onDeleteTask,
                            ),
                          ),
                        ],
                      );
                    }).toList(),
                  ),
                ),
              ),
            ),
            const SizedBox(height: 8),
            _TablePager(
              page: _page,
              rowsPerPage: _rowsPerPage,
              totalItems: sortedTasks.length,
              onPrev: _page == 0
                  ? null
                  : () =>
                        setState(() => _page = (_page - 1).clamp(0, _maxPage)),
              onNext: _page >= _maxPage
                  ? null
                  : () =>
                        setState(() => _page = (_page + 1).clamp(0, _maxPage)),
            ),
          ],
        ),
      ),
    );
  }
}

class _TaskActionsMenu extends StatelessWidget {
  const _TaskActionsMenu({
    required this.task,
    required this.onEditTask,
    required this.onToggleTaskDone,
    required this.onLogTime,
    required this.onDeleteTask,
  });

  final WorkTask task;
  final void Function(WorkTask task) onEditTask;
  final Future<void> Function(WorkTask task, bool done) onToggleTaskDone;
  final void Function(WorkTask task) onLogTime;
  final Future<void> Function(WorkTask task) onDeleteTask;

  @override
  Widget build(BuildContext context) {
    final isDone = task.status == TaskStatus.done;
    return PopupMenuButton<_TaskMenuAction>(
      tooltip: 'Azioni task',
      icon: const Icon(Icons.more_vert),
      onSelected: (action) async {
        switch (action) {
          case _TaskMenuAction.edit:
            onEditTask(task);
            break;
          case _TaskMenuAction.done:
            final confirmed = await showDialog<bool>(
              context: context,
              builder: (context) => AlertDialog(
                title: Text(isDone ? 'Riapri task' : 'Segna task come fatto'),
                content: Text(
                  isDone
                      ? 'Confermi di riaprire "${task.name}"?'
                      : 'Confermi che "${task.name}" e completato?',
                ),
                actions: [
                  TextButton(
                    onPressed: () => Navigator.of(context).pop(false),
                    child: const Text('Annulla'),
                  ),
                  FilledButton(
                    onPressed: () => Navigator.of(context).pop(true),
                    child: Text(isDone ? 'Riapri' : 'Conferma'),
                  ),
                ],
              ),
            );
            if (confirmed == true) {
              await onToggleTaskDone(task, !isDone);
            }
            break;
          case _TaskMenuAction.logTime:
            onLogTime(task);
            break;
          case _TaskMenuAction.delete:
            final confirmed = await showDialog<bool>(
              context: context,
              builder: (context) => AlertDialog(
                title: const Text('Elimina task'),
                content: Text('Vuoi eliminare definitivamente "${task.name}"?'),
                actions: [
                  TextButton(
                    onPressed: () => Navigator.of(context).pop(false),
                    child: const Text('Annulla'),
                  ),
                  FilledButton(
                    onPressed: () => Navigator.of(context).pop(true),
                    style: FilledButton.styleFrom(
                      backgroundColor: const Color(0xFF9F1239),
                    ),
                    child: const Text('Elimina'),
                  ),
                ],
              ),
            );
            if (confirmed == true) {
              await onDeleteTask(task);
            }
            break;
        }
      },
      itemBuilder: (context) => [
        const PopupMenuItem(
          value: _TaskMenuAction.edit,
          child: Text('Modifica task'),
        ),
        PopupMenuItem(
          value: _TaskMenuAction.done,
          child: Text(isDone ? 'Riapri' : 'Segna come fatto'),
        ),
        const PopupMenuItem(
          value: _TaskMenuAction.logTime,
          child: Text('Segna tempo'),
        ),
        const PopupMenuItem(
          value: _TaskMenuAction.delete,
          child: Text('Elimina task'),
        ),
      ],
    );
  }
}

enum _TaskMenuAction { edit, done, logTime, delete }

enum _TaskRegistryStatus { open, closed, completed }

class TaskCreationCard extends StatefulWidget {
  const TaskCreationCard({
    super.key,
    required this.workspace,
    required this.userId,
    this.initialTask,
    this.preselectedCompanyId,
    this.preselectedProjectId,
    this.preselectedPhaseId,
    required this.onSubmit,
    this.members = const [],
  });

  final WorkspaceSnapshot workspace;
  final String userId;
  final WorkTask? initialTask;
  final String? preselectedCompanyId;
  final String? preselectedProjectId;
  final String? preselectedPhaseId;
  final Future<void> Function(WorkTask task) onSubmit;
  final List<TeamMember> members;

  @override
  State<TaskCreationCard> createState() => _TaskCreationCardState();
}

class _TaskCreationCardState extends State<TaskCreationCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _name;
  late final TextEditingController _hours;
  late DateTime _startDate;
  late DateTime _deadline;
  String? _companyId;
  String? _projectId;
  String? _phaseId;
  String? _assigneeId;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    _name = TextEditingController(text: widget.initialTask?.name ?? '');
    _hours = TextEditingController(
      text: '${widget.initialTask?.estimatedHours ?? 2}',
    );
    _startDate = widget.initialTask?.startDate ?? DateTime.now();
    _deadline =
        widget.initialTask?.deadline ?? _startDate.add(const Duration(days: 3));
    _companyId = (widget.initialTask?.companyId.isNotEmpty ?? false)
        ? widget.initialTask!.companyId
        : widget.preselectedCompanyId;
    _projectId = (widget.initialTask?.projectId.isNotEmpty ?? false)
        ? widget.initialTask!.projectId
        : widget.preselectedProjectId;
    _phaseId = (widget.initialTask?.phaseId.isNotEmpty ?? false)
        ? widget.initialTask!.phaseId
        : widget.preselectedPhaseId;
    // In modifica mantieni l'assegnatario esistente; in creazione default non assegnato
    final existingAssignee = widget.initialTask?.assigneeId ?? '';
    _assigneeId = existingAssignee.isNotEmpty ? existingAssignee : null;
  }

  @override
  void dispose() {
    _name.dispose();
    _hours.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final projects = widget.workspace.projects
        .where((project) => project.companyId == _companyId)
        .toList();
    final phases =
        widget.workspace.phases
            .where((phase) => phase.projectId == _projectId)
            .toList()
          ..sort((a, b) => a.order.compareTo(b.order));

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Form(
          key: _formKey,
          child: SingleChildScrollView(
            child: LayoutBuilder(
              builder: (context, constraints) {
                final compact = constraints.maxWidth < 760;
                return Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      widget.initialTask == null
                          ? 'Nuovo task'
                          : 'Modifica task',
                      style: Theme.of(context).textTheme.headlineSmall
                          ?.copyWith(fontWeight: FontWeight.w700),
                    ),
                    const SizedBox(height: 8),
                    const Text(
                      'Crea un task associato a un cliente o a una fase di progetto. La durata prevista alimenta subito la timeline.',
                    ),
                    const SizedBox(height: 16),
                    _FormField(
                      controller: _name,
                      label: 'Titolo task',
                      required: true,
                    ),
                    if (compact) ...[
                      DropdownButtonFormField<String>(
                        initialValue: _companyId,
                        isExpanded: true,
                        decoration: const InputDecoration(
                          labelText: 'Cliente',
                          border: OutlineInputBorder(),
                        ),
                        items: widget.workspace.companies
                            .map(
                              (company) => DropdownMenuItem(
                                value: company.id,
                                child: Text(company.name),
                              ),
                            )
                            .toList(),
                        onChanged: (value) {
                          setState(() {
                            _companyId = value;
                            _projectId = null;
                            _phaseId = null;
                          });
                        },
                        validator: (value) =>
                            value == null ? 'Seleziona un cliente' : null,
                      ),
                      const SizedBox(height: 12),
                      DropdownButtonFormField<String>(
                        initialValue: _projectId,
                        isExpanded: true,
                        decoration: const InputDecoration(
                          labelText: 'Progetto',
                          border: OutlineInputBorder(),
                        ),
                        items: projects
                            .map(
                              (project) => DropdownMenuItem(
                                value: project.id,
                                child: Text(project.name),
                              ),
                            )
                            .toList(),
                        onChanged: (value) {
                          setState(() {
                            _projectId = value;
                            _phaseId = null;
                          });
                        },
                      ),
                      const SizedBox(height: 12),
                      DropdownButtonFormField<String>(
                        initialValue: _phaseId,
                        isExpanded: true,
                        decoration: const InputDecoration(
                          labelText: 'Fase',
                          border: OutlineInputBorder(),
                        ),
                        items: phases
                            .map(
                              (phase) => DropdownMenuItem(
                                value: phase.id,
                                child: Text(phase.name),
                              ),
                            )
                            .toList(),
                        onChanged: (value) => setState(() => _phaseId = value),
                      ),
                    ] else
                      Row(
                        children: [
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              initialValue: _companyId,
                              isExpanded: true,
                              decoration: const InputDecoration(
                                labelText: 'Cliente',
                                border: OutlineInputBorder(),
                              ),
                              items: widget.workspace.companies
                                  .map(
                                    (company) => DropdownMenuItem(
                                      value: company.id,
                                      child: Text(company.name),
                                    ),
                                  )
                                  .toList(),
                              onChanged: (value) {
                                setState(() {
                                  _companyId = value;
                                  _projectId = null;
                                  _phaseId = null;
                                });
                              },
                              validator: (value) =>
                                  value == null ? 'Seleziona un cliente' : null,
                            ),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              initialValue: _projectId,
                              isExpanded: true,
                              decoration: const InputDecoration(
                                labelText: 'Progetto',
                                border: OutlineInputBorder(),
                              ),
                              items: projects
                                  .map(
                                    (project) => DropdownMenuItem(
                                      value: project.id,
                                      child: Text(project.name),
                                    ),
                                  )
                                  .toList(),
                              onChanged: (value) {
                                setState(() {
                                  _projectId = value;
                                  _phaseId = null;
                                });
                              },
                            ),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              initialValue: _phaseId,
                              isExpanded: true,
                              decoration: const InputDecoration(
                                labelText: 'Fase',
                                border: OutlineInputBorder(),
                              ),
                              items: phases
                                  .map(
                                    (phase) => DropdownMenuItem(
                                      value: phase.id,
                                      child: Text(phase.name),
                                    ),
                                  )
                                  .toList(),
                              onChanged: (value) =>
                                  setState(() => _phaseId = value),
                            ),
                          ),
                        ],
                      ),
                    const SizedBox(height: 12),
                    if (compact) ...[
                      TextFormField(
                        controller: _hours,
                        decoration: const InputDecoration(
                          labelText: 'Durata prevista (ore)',
                          border: OutlineInputBorder(),
                        ),
                        keyboardType: const TextInputType.numberWithOptions(
                          decimal: true,
                        ),
                        validator: (value) {
                          final parsed = double.tryParse(
                            (value ?? '').replaceAll(',', '.'),
                          );
                          if (parsed == null || parsed <= 0) {
                            return 'Inserisci ore valide';
                          }
                          return null;
                        },
                      ),
                      const SizedBox(height: 12),
                      SizedBox(
                        width: double.infinity,
                        child: OutlinedButton(
                          onPressed: () async {
                            final picked = await showDatePicker(
                              context: context,
                              initialDate: _startDate,
                              firstDate: DateTime.now().subtract(
                                const Duration(days: 365),
                              ),
                              lastDate: DateTime.now().add(
                                const Duration(days: 365),
                              ),
                            );
                            if (picked != null) {
                              setState(() {
                                _startDate = picked;
                                if (_deadline.isBefore(_startDate)) {
                                  _deadline = _startDate;
                                }
                              });
                            }
                          },
                          child: Padding(
                            padding: const EdgeInsets.symmetric(vertical: 14),
                            child: Text('Inizio ${_shortDate(_startDate)}'),
                          ),
                        ),
                      ),
                      const SizedBox(height: 10),
                      SizedBox(
                        width: double.infinity,
                        child: OutlinedButton(
                          onPressed: () async {
                            final picked = await showDatePicker(
                              context: context,
                              initialDate: _deadline,
                              firstDate: _startDate,
                              lastDate: DateTime.now().add(
                                const Duration(days: 365),
                              ),
                            );
                            if (picked != null) {
                              setState(() => _deadline = picked);
                            }
                          },
                          child: Padding(
                            padding: const EdgeInsets.symmetric(vertical: 14),
                            child: Text('Scadenza ${_shortDate(_deadline)}'),
                          ),
                        ),
                      ),
                    ] else
                      Row(
                        children: [
                          Expanded(
                            child: TextFormField(
                              controller: _hours,
                              decoration: const InputDecoration(
                                labelText: 'Durata prevista (ore)',
                                border: OutlineInputBorder(),
                              ),
                              keyboardType:
                                  const TextInputType.numberWithOptions(
                                    decimal: true,
                                  ),
                              validator: (value) {
                                final parsed = double.tryParse(
                                  (value ?? '').replaceAll(',', '.'),
                                );
                                if (parsed == null || parsed <= 0) {
                                  return 'Inserisci ore valide';
                                }
                                return null;
                              },
                            ),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: OutlinedButton(
                              onPressed: () async {
                                final picked = await showDatePicker(
                                  context: context,
                                  initialDate: _startDate,
                                  firstDate: DateTime.now().subtract(
                                    const Duration(days: 365),
                                  ),
                                  lastDate: DateTime.now().add(
                                    const Duration(days: 365),
                                  ),
                                );
                                if (picked != null) {
                                  setState(() {
                                    _startDate = picked;
                                    if (_deadline.isBefore(_startDate)) {
                                      _deadline = _startDate;
                                    }
                                  });
                                }
                              },
                              child: Padding(
                                padding: const EdgeInsets.symmetric(
                                  vertical: 16,
                                ),
                                child: Text('Inizio ${_shortDate(_startDate)}'),
                              ),
                            ),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: OutlinedButton(
                              onPressed: () async {
                                final picked = await showDatePicker(
                                  context: context,
                                  initialDate: _deadline,
                                  firstDate: _startDate,
                                  lastDate: DateTime.now().add(
                                    const Duration(days: 365),
                                  ),
                                );
                                if (picked != null) {
                                  setState(() => _deadline = picked);
                                }
                              },
                              child: Padding(
                                padding: const EdgeInsets.symmetric(
                                  vertical: 16,
                                ),
                                child: Text(
                                  'Scadenza ${_shortDate(_deadline)}',
                                ),
                              ),
                            ),
                          ),
                        ],
                      ),
                    if (widget.members.isNotEmpty) ...[
                      const SizedBox(height: 12),
                      DropdownButtonFormField<String>(
                        value: _assigneeId,
                        isExpanded: true,
                        decoration: const InputDecoration(
                          labelText: 'Assegnato a',
                          border: OutlineInputBorder(),
                        ),
                        items: [
                          const DropdownMenuItem<String>(
                            value: null,
                            child: Text('Non assegnato'),
                          ),
                          ...widget.members.map(
                            (m) => DropdownMenuItem<String>(
                              value: m.userId,
                              child: Text(
                                m.displayName.isNotEmpty ? m.displayName : m.email,
                              ),
                            ),
                          ),
                        ],
                        onChanged: (v) => setState(() => _assigneeId = v),
                      ),
                    ],
                    const SizedBox(height: 12),
                    SizedBox(
                      width: double.infinity,
                      child: FilledButton(
                        onPressed: _saving
                            ? null
                            : () async {
                                final messenger = ScaffoldMessenger.of(context);
                                final navigator = Navigator.of(context);
                                if (!_formKey.currentState!.validate()) {
                                  return;
                                }
                                if (_deadline.isBefore(_startDate)) {
                                  messenger.showSnackBar(
                                    const SnackBar(
                                      content: Text(
                                        'La data di scadenza deve essere uguale o successiva alla data di inizio.',
                                      ),
                                    ),
                                  );
                                  return;
                                }
                                setState(() => _saving = true);
                                try {
                                  final estimatedHours = double.parse(
                                    _hours.text.replaceAll(',', '.'),
                                  );
                                  final task = WorkTask(
                                    id:
                                        widget.initialTask?.id ??
                                        'tsk-${DateTime.now().microsecondsSinceEpoch}',
                                    companyId: _companyId!,
                                    projectId: _projectId ?? '',
                                    phaseId: _phaseId ?? '',
                                    assigneeId: _assigneeId ?? '',
                                    name: _name.text.trim(),
                                    estimatedHours: estimatedHours,
                                    loggedHours:
                                        widget.initialTask?.loggedHours ?? 0,
                                    startDate: _startDate,
                                    deadline: _deadline,
                                    status:
                                        widget.initialTask?.status ??
                                        TaskStatus.planned,
                                    billable:
                                        widget.initialTask?.billable ?? true,
                                  );
                                  await widget.onSubmit(task);
                                  if (mounted) {
                                    messenger.showSnackBar(
                                      SnackBar(
                                        content: Text(
                                          widget.initialTask == null
                                              ? 'Task creato'
                                              : 'Task aggiornato',
                                        ),
                                      ),
                                    );
                                    navigator.pop();
                                  }
                                } finally {
                                  if (mounted) {
                                    setState(() => _saving = false);
                                  }
                                }
                              },
                        child: Text(
                          _saving
                              ? 'Salvataggio...'
                              : widget.initialTask == null
                              ? 'Salva task'
                              : 'Aggiorna task',
                        ),
                      ),
                    ),
                  ],
                );
              },
            ),
          ),
        ),
      ),
    );
  }
}

class TimeTrackCreationCard extends StatefulWidget {
  const TimeTrackCreationCard({
    super.key,
    required this.workspace,
    required this.onSubmit,
    this.initialTask,
    this.initialDate,
    this.initialTrack,
  });

  final WorkspaceSnapshot workspace;
  final Future<void> Function(TimeTrack track) onSubmit;
  final WorkTask? initialTask;
  final DateTime? initialDate;
  final TimeTrack? initialTrack;

  @override
  State<TimeTrackCreationCard> createState() => _TimeTrackCreationCardState();
}

class _TimeTrackCreationCardState extends State<TimeTrackCreationCard> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _nameController;
  late final TextEditingController _startTimeController;
  late final TextEditingController _endTimeController;
  String? _taskId;
  String? _companyId;
  String? _projectId;
  late DateTime _selectedDate;
  bool _saving = false;

  @override
  void initState() {
    super.initState();
    final baseTrack = widget.initialTrack;
    _taskId = baseTrack != null
        ? (baseTrack.taskId.isNotEmpty ? baseTrack.taskId : null)
        : ((widget.initialTask?.id.isNotEmpty ?? false)
              ? widget.initialTask!.id
              : null);
    _companyId = baseTrack != null
        ? (baseTrack.companyId.isNotEmpty ? baseTrack.companyId : null)
        : ((widget.initialTask?.companyId.isNotEmpty ?? false)
              ? widget.initialTask!.companyId
              : null);
    _projectId = baseTrack != null
        ? (baseTrack.projectId.isNotEmpty ? baseTrack.projectId : null)
        : ((widget.initialTask?.projectId.isNotEmpty ?? false)
              ? widget.initialTask!.projectId
              : null);
    _selectedDate = DateTime(
      (baseTrack?.startAt ?? widget.initialDate ?? DateTime.now()).year,
      (baseTrack?.startAt ?? widget.initialDate ?? DateTime.now()).month,
      (baseTrack?.startAt ?? widget.initialDate ?? DateTime.now()).day,
    );
    final startDateTime = baseTrack?.startAt;
    final endDateTime = baseTrack?.endAt;
    _startTimeController = TextEditingController(
      text:
          _twoDigits(startDateTime?.hour ?? 9) +
          ':' +
          _twoDigits(startDateTime?.minute ?? 0),
    );
    _endTimeController = TextEditingController(
      text:
          _twoDigits(endDateTime?.hour ?? 10) +
          ':' +
          _twoDigits(endDateTime?.minute ?? 0),
    );
    _nameController = TextEditingController(
      text: baseTrack?.name ?? widget.initialTask?.name ?? '',
    );
  }

  @override
  void dispose() {
    _nameController.dispose();
    _startTimeController.dispose();
    _endTimeController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final taskItems = [...widget.workspace.tasks]
      ..sort((a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase()));
    final projectItems =
        widget.workspace.projects
            .where(
              (project) =>
                  _companyId == null || project.companyId == _companyId,
            )
            .toList()
          ..sort(
            (a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase()),
          );

    final companyNamesById = {
      for (final company in widget.workspace.companies)
        company.id: company.name,
    };

    return Padding(
      padding: const EdgeInsets.all(24),
      child: Form(
        key: _formKey,
        child: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  Text(
                    'Aggiungi segnatempo',
                    style: Theme.of(context).textTheme.headlineSmall?.copyWith(
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                  const Spacer(),
                  IconButton(
                    onPressed: _saving
                        ? null
                        : () => Navigator.of(context).pop(),
                    icon: const Icon(Icons.close),
                  ),
                ],
              ),
              const SizedBox(height: 16),
              DropdownButtonFormField<String>(
                value: _taskId,
                isExpanded: true,
                decoration: const InputDecoration(
                  labelText: 'Nome task',
                  border: OutlineInputBorder(),
                ),
                items: [
                  const DropdownMenuItem<String>(
                    value: null,
                    child: Text('Nessun task associato'),
                  ),
                  ...taskItems.map(
                    (task) => DropdownMenuItem<String>(
                      value: task.id,
                      child: Text(task.name),
                    ),
                  ),
                ],
                onChanged: _saving
                    ? null
                    : (value) {
                        setState(() {
                          _taskId = value;
                          final selectedTask = _firstWhereOrNull(
                            widget.workspace.tasks,
                            (task) => task.id == value,
                          );
                          if (selectedTask != null) {
                            _nameController.text = selectedTask.name;
                            _companyId = selectedTask.companyId.isNotEmpty
                                ? selectedTask.companyId
                                : null;
                            _projectId = selectedTask.projectId.isNotEmpty
                                ? selectedTask.projectId
                                : null;
                          }
                        });
                      },
              ),
              const SizedBox(height: 16),
              TextFormField(
                controller: _nameController,
                enabled: !_saving,
                decoration: const InputDecoration(
                  labelText: 'Nome',
                  border: OutlineInputBorder(),
                ),
                validator: (value) {
                  if (value == null || value.trim().isEmpty) {
                    return 'Inserisci il nome';
                  }
                  return null;
                },
              ),
              const SizedBox(height: 16),
              DropdownButtonFormField<String>(
                value: _companyId,
                isExpanded: true,
                decoration: const InputDecoration(
                  labelText: 'Cliente',
                  border: OutlineInputBorder(),
                ),
                items: [
                  const DropdownMenuItem<String>(
                    value: null,
                    child: Text('Nessun cliente'),
                  ),
                  ...widget.workspace.companies.map(
                    (company) => DropdownMenuItem<String>(
                      value: company.id,
                      child: Text(company.name),
                    ),
                  ),
                ],
                onChanged: _saving
                    ? null
                    : (value) {
                        setState(() {
                          _companyId = value;
                          if (_projectId != null &&
                              widget.workspace.projects.every(
                                (project) =>
                                    project.id != _projectId ||
                                    project.companyId != _companyId,
                              )) {
                            _projectId = null;
                          }
                        });
                      },
              ),
              const SizedBox(height: 16),
              DropdownButtonFormField<String>(
                value: _projectId,
                isExpanded: true,
                decoration: const InputDecoration(
                  labelText: 'Progetto (opzionale)',
                  border: OutlineInputBorder(),
                ),
                items: [
                  const DropdownMenuItem<String>(
                    value: null,
                    child: Text('Nessun progetto'),
                  ),
                  ...projectItems.map(
                    (project) => DropdownMenuItem<String>(
                      value: project.id,
                      child: Text(project.name),
                    ),
                  ),
                ],
                onChanged: _saving
                    ? null
                    : (value) => setState(() => _projectId = value),
              ),
              const SizedBox(height: 16),
              Wrap(
                spacing: 12,
                runSpacing: 12,
                crossAxisAlignment: WrapCrossAlignment.center,
                children: [
                  OutlinedButton.icon(
                    onPressed: _saving
                        ? null
                        : () async {
                            final picked = await showDatePicker(
                              context: context,
                              initialDate: _selectedDate,
                              firstDate: DateTime(2020),
                              lastDate: DateTime(2100),
                            );
                            if (picked == null) {
                              return;
                            }
                            setState(() {
                              _selectedDate = DateTime(
                                picked.year,
                                picked.month,
                                picked.day,
                              );
                            });
                          },
                    icon: const Icon(Icons.calendar_today_outlined),
                    label: Text('Data ${_shortDate(_selectedDate)}'),
                  ),
                  SizedBox(
                    width: 140,
                    child: TextFormField(
                      controller: _startTimeController,
                      enabled: !_saving,
                      keyboardType: TextInputType.datetime,
                      inputFormatters: [
                        FilteringTextInputFormatter.allow(RegExp(r'[0-9:]')),
                      ],
                      decoration: const InputDecoration(
                        labelText: 'Inizio (HH:mm)',
                        border: OutlineInputBorder(),
                      ),
                      validator: (value) {
                        if (_parseTimeOfDay(value) == null) {
                          return 'Formato HH:mm';
                        }
                        return null;
                      },
                    ),
                  ),
                  SizedBox(
                    width: 140,
                    child: TextFormField(
                      controller: _endTimeController,
                      enabled: !_saving,
                      keyboardType: TextInputType.datetime,
                      inputFormatters: [
                        FilteringTextInputFormatter.allow(RegExp(r'[0-9:]')),
                      ],
                      decoration: const InputDecoration(
                        labelText: 'Fine (HH:mm)',
                        border: OutlineInputBorder(),
                      ),
                      validator: (value) {
                        if (_parseTimeOfDay(value) == null) {
                          return 'Formato HH:mm';
                        }
                        return null;
                      },
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 20),
              LayoutBuilder(
                builder: (context, constraints) {
                  final compact = constraints.maxWidth < 560;
                  return compact
                      ? Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            if (_companyId != null &&
                                companyNamesById[_companyId] != null) ...[
                              Text(
                                companyNamesById[_companyId]!,
                                style: Theme.of(context).textTheme.bodyMedium
                                    ?.copyWith(color: const Color(0xFF7D89A8)),
                              ),
                              const SizedBox(height: 10),
                            ],
                            SizedBox(
                              width: double.infinity,
                              child: FilledButton(
                                onPressed: _saving
                                    ? null
                                    : () async {
                                        final messenger = ScaffoldMessenger.of(
                                          context,
                                        );
                                        final navigator = Navigator.of(context);
                                        if (!_formKey.currentState!
                                            .validate()) {
                                          return;
                                        }
                                        final startTime = _parseTimeOfDay(
                                          _startTimeController.text,
                                        );
                                        final endTime = _parseTimeOfDay(
                                          _endTimeController.text,
                                        );
                                        if (startTime == null ||
                                            endTime == null) {
                                          messenger.showSnackBar(
                                            const SnackBar(
                                              content: Text(
                                                'Inserisci orari validi in formato HH:mm.',
                                              ),
                                            ),
                                          );
                                          return;
                                        }
                                        final startAt = DateTime(
                                          _selectedDate.year,
                                          _selectedDate.month,
                                          _selectedDate.day,
                                          startTime.hour,
                                          startTime.minute,
                                        );
                                        final endAt = DateTime(
                                          _selectedDate.year,
                                          _selectedDate.month,
                                          _selectedDate.day,
                                          endTime.hour,
                                          endTime.minute,
                                        );
                                        if (!endAt.isAfter(startAt)) {
                                          messenger.showSnackBar(
                                            const SnackBar(
                                              content: Text(
                                                'L’orario di fine deve essere successivo all’inizio.',
                                              ),
                                            ),
                                          );
                                          return;
                                        }
                                        setState(() => _saving = true);
                                        try {
                                          final track = TimeTrack(
                                            id:
                                                widget.initialTrack?.id ??
                                                'tt-${DateTime.now().microsecondsSinceEpoch}',
                                            taskId: _taskId ?? '',
                                            name: _nameController.text.trim(),
                                            companyId: _companyId ?? '',
                                            projectId: _projectId ?? '',
                                            startAt: startAt,
                                            endAt: endAt,
                                          );
                                          await widget.onSubmit(track);
                                          if (!mounted) {
                                            return;
                                          }
                                          messenger.showSnackBar(
                                            SnackBar(
                                              content: Text(
                                                widget.initialTrack == null
                                                    ? 'Segnatempo creato.'
                                                    : 'Segnatempo aggiornato.',
                                              ),
                                            ),
                                          );
                                          navigator.pop();
                                        } finally {
                                          if (mounted) {
                                            setState(() => _saving = false);
                                          }
                                        }
                                      },
                                child: Text(
                                  _saving ? 'Salvataggio...' : 'Salva',
                                ),
                              ),
                            ),
                          ],
                        )
                      : Row(
                          children: [
                            if (_companyId != null &&
                                companyNamesById[_companyId] != null)
                              Expanded(
                                child: Text(
                                  companyNamesById[_companyId]!,
                                  style: Theme.of(context).textTheme.bodyMedium
                                      ?.copyWith(
                                        color: const Color(0xFF7D89A8),
                                      ),
                                ),
                              )
                            else
                              const Spacer(),
                            FilledButton(
                              onPressed: _saving
                                  ? null
                                  : () async {
                                      final messenger = ScaffoldMessenger.of(
                                        context,
                                      );
                                      final navigator = Navigator.of(context);
                                      if (!_formKey.currentState!.validate()) {
                                        return;
                                      }
                                      final startTime = _parseTimeOfDay(
                                        _startTimeController.text,
                                      );
                                      final endTime = _parseTimeOfDay(
                                        _endTimeController.text,
                                      );
                                      if (startTime == null ||
                                          endTime == null) {
                                        messenger.showSnackBar(
                                          const SnackBar(
                                            content: Text(
                                              'Inserisci orari validi in formato HH:mm.',
                                            ),
                                          ),
                                        );
                                        return;
                                      }
                                      final startAt = DateTime(
                                        _selectedDate.year,
                                        _selectedDate.month,
                                        _selectedDate.day,
                                        startTime.hour,
                                        startTime.minute,
                                      );
                                      final endAt = DateTime(
                                        _selectedDate.year,
                                        _selectedDate.month,
                                        _selectedDate.day,
                                        endTime.hour,
                                        endTime.minute,
                                      );
                                      if (!endAt.isAfter(startAt)) {
                                        messenger.showSnackBar(
                                          const SnackBar(
                                            content: Text(
                                              'L’orario di fine deve essere successivo all’inizio.',
                                            ),
                                          ),
                                        );
                                        return;
                                      }
                                      setState(() => _saving = true);
                                      try {
                                        final track = TimeTrack(
                                          id:
                                              widget.initialTrack?.id ??
                                              'tt-${DateTime.now().microsecondsSinceEpoch}',
                                          taskId: _taskId ?? '',
                                          name: _nameController.text.trim(),
                                          companyId: _companyId ?? '',
                                          projectId: _projectId ?? '',
                                          startAt: startAt,
                                          endAt: endAt,
                                        );
                                        await widget.onSubmit(track);
                                        if (!mounted) {
                                          return;
                                        }
                                        messenger.showSnackBar(
                                          SnackBar(
                                            content: Text(
                                              widget.initialTrack == null
                                                  ? 'Segnatempo creato.'
                                                  : 'Segnatempo aggiornato.',
                                            ),
                                          ),
                                        );
                                        navigator.pop();
                                      } finally {
                                        if (mounted) {
                                          setState(() => _saving = false);
                                        }
                                      }
                                    },
                              child: Text(_saving ? 'Salvataggio...' : 'Salva'),
                            ),
                          ],
                        );
                },
              ),
            ],
          ),
        ),
      ),
    );
  }

  TimeOfDay? _parseTimeOfDay(String? value) {
    if (value == null) {
      return null;
    }
    final match = RegExp(
      r'^([01]?\d|2[0-3]):([0-5]\d)$',
    ).firstMatch(value.trim());
    if (match == null) {
      return null;
    }
    final hour = int.parse(match.group(1)!);
    final minute = int.parse(match.group(2)!);
    return TimeOfDay(hour: hour, minute: minute);
  }

  String _twoDigits(int value) => value.toString().padLeft(2, '0');
}

class TimeTrackingBoard extends StatelessWidget {
  const TimeTrackingBoard({
    super.key,
    required this.workspace,
    required this.visibleWeekStart,
    required this.onShiftWeek,
    // nullable per read-only mode (visualizzazione altri membri del team)
    this.onAddTrackForDay,
    this.onEditTrack,
    this.onDeleteTrack,
  });

  final WorkspaceSnapshot workspace;
  final DateTime visibleWeekStart;
  final void Function(int delta) onShiftWeek;
  final Future<void> Function(DateTime day)? onAddTrackForDay;
  final Future<void> Function(TimeTrack track)? onDeleteTrack;
  final void Function(TimeTrack track)? onEditTrack;

  bool get _readOnly => onAddTrackForDay == null;

  @override
  Widget build(BuildContext context) {
    final days = List.generate(
      7,
      (index) => visibleWeekStart.add(Duration(days: index)),
    );
    final tracksByDay = <DateTime, List<TimeTrack>>{};
    for (final track in workspace.timeTracks) {
      final day = DateTime(
        track.startAt.year,
        track.startAt.month,
        track.startAt.day,
      );
      tracksByDay.putIfAbsent(day, () => []).add(track);
    }
    final companyNamesById = {
      for (final company in workspace.companies) company.id: company.name,
    };
    final projectNamesById = {
      for (final project in workspace.projects) project.id: project.name,
    };
    final totalWeekHours = days.fold<double>(0, (total, day) {
      final dayTracks = tracksByDay[day] ?? const <TimeTrack>[];
      return total +
          dayTracks.fold<double>(0, (sum, track) => sum + track.hours);
    });

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Wrap(
              spacing: 12,
              runSpacing: 12,
              crossAxisAlignment: WrapCrossAlignment.center,
              children: [
                IconButton(
                  onPressed: () => onShiftWeek(-1),
                  icon: const Icon(Icons.chevron_left),
                ),
                Text(
                  _weekLabel(visibleWeekStart),
                  style: Theme.of(
                    context,
                  ).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w700),
                ),
                IconButton(
                  onPressed: () => onShiftWeek(1),
                  icon: const Icon(Icons.chevron_right),
                ),
                const SizedBox(width: 8),
                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 14,
                    vertical: 10,
                  ),
                  decoration: BoxDecoration(
                    color: GussoniBrand.primary,
                    borderRadius: BorderRadius.circular(18),
                  ),
                  child: Text(
                    'Tempo segnato ${_formatHours(totalWeekHours)}',
                    style: const TextStyle(color: Colors.white),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 16),
            ...days.map((day) {
              final dayTracks = [...(tracksByDay[day] ?? const <TimeTrack>[])]
                ..sort((a, b) => a.startAt.compareTo(b.startAt));
              final dayTotal = dayTracks.fold<double>(
                0,
                (sum, track) => sum + track.hours,
              );
              final today = _isSameDay(day, DateTime.now());
              return Container(
                margin: const EdgeInsets.only(bottom: 8),
                decoration: BoxDecoration(
                  color: const Color(0xFF0E1020),
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(
                    color: today
                        ? GussoniBrand.primary.withOpacity(.35)
                        : const Color(0xFF1E2130),
                  ),
                ),
                child: Theme(
                  data: Theme.of(context).copyWith(
                    dividerColor: Colors.transparent,
                    expansionTileTheme: ExpansionTileThemeData(
                      backgroundColor: Colors.transparent,
                      collapsedBackgroundColor: Colors.transparent,
                      iconColor: GussoniBrand.primary.withOpacity(.6),
                      collapsedIconColor: const Color(0xFF525D78),
                    ),
                  ),
                  child: ExpansionTile(
                    controlAffinity: ListTileControlAffinity.leading,
                    tilePadding: const EdgeInsets.symmetric(
                      horizontal: 14,
                      vertical: 2,
                    ),
                    collapsedShape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12),
                    ),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12),
                    ),
                    title: Row(
                      children: [
                        Expanded(
                          child: Row(
                            children: [
                              Text(
                                '${_weekdayShortName(day.weekday)} ${day.day} ${_monthShortName(day.month)}',
                                style: Theme.of(context).textTheme.titleLarge
                                    ?.copyWith(fontWeight: FontWeight.w600),
                              ),
                              if (today) ...[
                                const SizedBox(width: 8),
                                Container(
                                  padding: const EdgeInsets.symmetric(
                                    horizontal: 8,
                                    vertical: 2,
                                  ),
                                  decoration: BoxDecoration(
                                    borderRadius: BorderRadius.circular(999),
                                    border: Border.all(
                                      color: GussoniBrand.primary.withOpacity(.5),
                                    ),
                                    color: GussoniBrand.primary.withOpacity(.1),
                                  ),
                                  child: Text('Oggi',
                                    style: TextStyle(
                                      fontSize: 11,
                                      fontWeight: FontWeight.w700,
                                      color: GussoniBrand.primary,
                                    )),
                                ),
                              ],
                            ],
                          ),
                        ),
                        const SizedBox(width: 12),
                        Flexible(
                          flex: 2,
                          child: _DayTimelineProgress(
                            day: day,
                            tracks: dayTracks,
                            totalHours: dayTotal,
                          ),
                        ),
                      ],
                    ),
                    trailing: IconButton(
                      tooltip: 'Aggiungi segnatempo',
                      onPressed: onAddTrackForDay == null
                          ? null
                          : () => onAddTrackForDay!(day),
                      icon: const Icon(Icons.add_circle_outline),
                    ),
                    children: [
                      if (dayTracks.isEmpty)
                        const Padding(
                          padding: EdgeInsets.fromLTRB(16, 8, 16, 16),
                          child: Text(
                            'Non hai ancora aggiunto un segnatempo a questo giorno',
                            style: TextStyle(color: Color(0xFF525D78)),
                          ),
                        )
                      else
                        Padding(
                          padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
                          child: Column(
                            children: dayTracks.map((track) {
                              final companyName =
                                  companyNamesById[track.companyId] ?? '-';
                              final projectName = track.projectId.isEmpty
                                  ? '-'
                                  : (projectNamesById[track.projectId] ?? '-');
                              return Container(
                                margin: const EdgeInsets.only(top: 8),
                                padding: const EdgeInsets.all(12),
                                decoration: BoxDecoration(
                                  color: const Color(0xFF0E1020),
                                  borderRadius: BorderRadius.circular(12),
                                  border: Border.all(
                                    color: const Color(0xFF1E2130),
                                  ),
                                ),
                                child: Row(
                                  children: [
                                    Expanded(
                                      child: Column(
                                        crossAxisAlignment:
                                            CrossAxisAlignment.start,
                                        children: [
                                          Text(
                                            track.name,
                                            style: Theme.of(context)
                                                .textTheme
                                                .titleMedium
                                                ?.copyWith(
                                                  fontWeight: FontWeight.w600,
                                                ),
                                          ),
                                          const SizedBox(height: 4),
                                          Text(
                                            '$companyName • $projectName',
                                            style: const TextStyle(
                                              color: Color(0xFF7D89A8),
                                            ),
                                          ),
                                        ],
                                      ),
                                    ),
                                    const SizedBox(width: 8),
                                    Text(
                                      '${_formatTime(track.startAt)} - ${_formatTime(track.endAt)}',
                                    ),
                                    const SizedBox(width: 12),
                                    Text(
                                      _formatHours(track.hours),
                                      style: Theme.of(context)
                                          .textTheme
                                          .titleMedium
                                          ?.copyWith(
                                            fontWeight: FontWeight.w700,
                                          ),
                                    ),
                                    const SizedBox(width: 4),
                                    PopupMenuButton<_TimeTrackRowAction>(
                                      tooltip: 'Azioni segnatempo',
                                      itemBuilder: (context) => const [
                                        PopupMenuItem(
                                          value: _TimeTrackRowAction.edit,
                                          child: Text('Modifica'),
                                        ),
                                        PopupMenuItem(
                                          value: _TimeTrackRowAction.delete,
                                          child: Text('Elimina'),
                                        ),
                                      ],
                                      onSelected: (action) async {
                                        if (action ==
                                            _TimeTrackRowAction.edit) {
                                          onEditTrack?.call(track);
                                          return;
                                        }
                                        final confirm = await showDialog<bool>(
                                          context: context,
                                          builder: (context) => AlertDialog(
                                            title: const Text(
                                              'Elimina segnatempo',
                                            ),
                                            content: Text(
                                              'Confermi eliminazione di "${track.name}"?',
                                            ),
                                            actions: [
                                              TextButton(
                                                onPressed: () => Navigator.of(
                                                  context,
                                                ).pop(false),
                                                child: const Text('Annulla'),
                                              ),
                                              FilledButton(
                                                onPressed: () => Navigator.of(
                                                  context,
                                                ).pop(true),
                                                style: FilledButton.styleFrom(
                                                  backgroundColor: const Color(
                                                    0xFF9F1239,
                                                  ),
                                                ),
                                                child: const Text('Elimina'),
                                              ),
                                            ],
                                          ),
                                        );
                                        if (confirm == true) {
                                          if (onDeleteTrack != null)
                                            await onDeleteTrack!(track);
                                        }
                                      },
                                    ),
                                  ],
                                ),
                              );
                            }).toList(),
                          ),
                        ),
                    ],
                  ),
                ),
              );
            }),
          ],
        ),
      ),
    );
  }
}

class _DayTimelineProgress extends StatelessWidget {
  const _DayTimelineProgress({
    required this.day,
    required this.tracks,
    required this.totalHours,
  });

  final DateTime day;
  final List<TimeTrack> tracks;
  final double totalHours;

  static const double _windowStartHour = 8;
  static const double _windowEndHour = 19.5;

  @override
  Widget build(BuildContext context) {
    final clippedSegments = _buildSegments(day, tracks);
    final extremes = _dayExtremes(day, tracks);
    final firstStart = extremes.$1;
    final lastEnd = extremes.$2;
    final spanLabel = firstStart == null || lastEnd == null
        ? '08:00 - 19:30'
        : '${_formatTime(firstStart)} - ${_formatTime(lastEnd)}';

    return Column(
      mainAxisSize: MainAxisSize.min,
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            Expanded(
              child: Text(
                spanLabel,
                overflow: TextOverflow.ellipsis,
                style: const TextStyle(fontSize: 12, color: Color(0xFF7D89A8)),
              ),
            ),
            const SizedBox(width: 8),
            Text(
              _formatHours(totalHours),
              style: TextStyle(
                fontSize: 13,
                fontWeight: FontWeight.w800,
                color: totalHours > 0
                    ? GussoniBrand.primary
                    : const Color(0xFF525D78),
              ),
            ),
          ],
        ),
        const SizedBox(height: 6),
        SizedBox(
          height: 5,
          child: LayoutBuilder(
            builder: (context, constraints) {
              return Stack(
                children: [
                  Positioned.fill(
                    child: Container(
                      decoration: BoxDecoration(
                        color: const Color(0xFF1E2130),
                        borderRadius: BorderRadius.circular(999),
                      ),
                    ),
                  ),
                  ...clippedSegments.map((segment) {
                    final left = constraints.maxWidth * segment.startFraction;
                    final width =
                        (constraints.maxWidth * segment.lengthFraction)
                            .clamp(2.0, constraints.maxWidth)
                            .toDouble();
                    return Positioned(
                      left: left,
                      width: width,
                      top: 0,
                      bottom: 0,
                      child: Container(
                        decoration: BoxDecoration(
                          color: GussoniBrand.primary,
                          borderRadius: BorderRadius.circular(999),
                        ),
                      ),
                    );
                  }),
                ],
              );
            },
          ),
        ),
      ],
    );
  }

  List<_DayTrackSegment> _buildSegments(
    DateTime day,
    List<TimeTrack> allTracks,
  ) {
    final startWindow = DateTime(
      day.year,
      day.month,
      day.day,
      _windowStartHour.floor(),
      ((_windowStartHour % 1) * 60).round(),
    );
    final endWindow = DateTime(
      day.year,
      day.month,
      day.day,
      _windowEndHour.floor(),
      ((_windowEndHour % 1) * 60).round(),
    );
    final windowMinutes = endWindow.difference(startWindow).inMinutes;
    if (windowMinutes <= 0) {
      return const [];
    }

    final segments = <_DayTrackSegment>[];
    for (final track in allTracks) {
      final clipStart = track.startAt.isAfter(startWindow)
          ? track.startAt
          : startWindow;
      final clipEnd = track.endAt.isBefore(endWindow) ? track.endAt : endWindow;
      if (!clipEnd.isAfter(clipStart)) {
        continue;
      }
      final startMinutes = clipStart.difference(startWindow).inMinutes;
      final lengthMinutes = clipEnd.difference(clipStart).inMinutes;
      segments.add(
        _DayTrackSegment(
          startFraction: startMinutes / windowMinutes,
          lengthFraction: lengthMinutes / windowMinutes,
        ),
      );
    }
    return segments;
  }

  (DateTime?, DateTime?) _dayExtremes(DateTime day, List<TimeTrack> allTracks) {
    if (allTracks.isEmpty) {
      return (null, null);
    }
    DateTime? first;
    DateTime? last;
    for (final track in allTracks) {
      if (track.startAt.year != day.year ||
          track.startAt.month != day.month ||
          track.startAt.day != day.day) {
        continue;
      }
      if (first == null || track.startAt.isBefore(first)) {
        first = track.startAt;
      }
      if (last == null || track.endAt.isAfter(last)) {
        last = track.endAt;
      }
    }
    return (first, last);
  }
}

class _DayTrackSegment {
  const _DayTrackSegment({
    required this.startFraction,
    required this.lengthFraction,
  });

  final double startFraction;
  final double lengthFraction;
}

enum _TimeTrackRowAction { edit, delete }

class OperationalMonitorStatsCard extends StatelessWidget {
  const OperationalMonitorStatsCard({
    super.key,
    required this.workspace,
    required this.crmData,
  });

  final WorkspaceSnapshot workspace;
  final CrmData crmData;

  DateTime _invoiceDateGuess(InvoiceDraft invoice) {
    final number = invoice.number;
    final yearMonth = RegExp(r'(20\d{2})[^\d]?([01]?\d)').firstMatch(number);
    if (yearMonth != null) {
      final year = int.tryParse(yearMonth.group(1) ?? '');
      final month = int.tryParse(yearMonth.group(2) ?? '');
      if (year != null && month != null && month >= 1 && month <= 12) {
        return DateTime(year, month, 1);
      }
    }
    final compact = RegExp(r'(20\d{2})(0[1-9]|1[0-2])').firstMatch(number);
    if (compact != null) {
      final year = int.tryParse(compact.group(1) ?? '');
      final month = int.tryParse(compact.group(2) ?? '');
      if (year != null && month != null) {
        return DateTime(year, month, 1);
      }
    }
    return DateTime.now();
  }

  double _monthlySubscriptionEquivalent(Subscription sub) {
    final period = sub.billingCycle.period <= 0 ? 1 : sub.billingCycle.period;
    switch (sub.billingCycle.unit) {
      case 'week':
        return (sub.total * 52 / 12) / period;
      case 'year':
        return (sub.total / 12) / period;
      default:
        return sub.total / period;
    }
  }

  @override
  Widget build(BuildContext context) {
    final currency = NumberFormat.currency(
      locale: 'it_IT',
      symbol: '€',
      decimalDigits: 0,
    );
    final pctFmt = NumberFormat.decimalPercentPattern(
      locale: 'it_IT',
      decimalDigits: 0,
    );

    final now = DateTime.now();
    final monthStart = DateTime(now.year, now.month, 1);
    final weekStart = _startOfWeek(now);
    final weekEnd = weekStart.add(const Duration(days: 7));

    final openDeals = crmData.deals
        .where((d) => d.status == DealFirestoreStatus.open)
        .toList();
    final wonDeals = crmData.deals
        .where((d) => d.status == DealFirestoreStatus.won)
        .toList();
    final lostDeals = crmData.deals
        .where((d) => d.status == DealFirestoreStatus.lost)
        .toList();

    final openDealsValue = openDeals.fold<double>(0, (s, d) => s + d.value);
    final wonDealsValue = wonDeals.fold<double>(0, (s, d) => s + d.value);

    final activeSubscriptions = crmData.subscriptions
        .where((s) => s.status == SubscriptionStatus.active)
        .toList();
    final mrr = activeSubscriptions.fold<double>(
      0,
      (sum, sub) => sum + _monthlySubscriptionEquivalent(sub),
    );
    final arr = mrr * 12;

    final monthTracks = workspace.timeTracks.where((t) {
      final d = t.startAt;
      return d.year == now.year && d.month == now.month;
    }).toList();
    final weekTracks = workspace.timeTracks.where((t) {
      final d = t.startAt;
      return !d.isBefore(weekStart) && d.isBefore(weekEnd);
    }).toList();
    final monthHours = monthTracks.fold<double>(0, (s, t) => s + t.hours);
    final weekHours = weekTracks.fold<double>(0, (s, t) => s + t.hours);
    final monthBillableHours = monthTracks
        .where((t) => t.billable)
        .fold<double>(0, (s, t) => s + t.hours);

    final invoicesWithDate = workspace.invoiceDrafts
        .map((invoice) => (invoice: invoice, date: _invoiceDateGuess(invoice)))
        .toList();
    final exportedInvoices = invoicesWithDate
        .where((x) => x.invoice.status == InvoiceStatus.exported)
        .toList();
    final monthInvoices = exportedInvoices.where((x) {
      return x.date.year == now.year && x.date.month == now.month;
    }).toList();
    final monthInvoiced = monthInvoices.fold<double>(
      0,
      (s, x) => s + x.invoice.amount,
    );

    final monthlyTotals = <DateTime, double>{};
    for (final x in exportedInvoices) {
      final key = DateTime(x.date.year, x.date.month, 1);
      monthlyTotals.update(
        key,
        (v) => v + x.invoice.amount,
        ifAbsent: () => x.invoice.amount,
      );
    }
    final lastSixMonths = List.generate(6, (i) {
      final d = DateTime(now.year, now.month - (5 - i), 1);
      return d;
    });

    final quarterTotals = <int, double>{1: 0, 2: 0, 3: 0, 4: 0};
    for (final x in exportedInvoices.where((x) => x.date.year == now.year)) {
      final quarter = ((x.date.month - 1) ~/ 3) + 1;
      quarterTotals.update(quarter, (v) => v + x.invoice.amount);
    }

    final monthExpenses = crmData.expenses
        .where((e) => e.date.year == now.year && e.date.month == now.month)
        .fold<double>(0, (s, e) => s + e.amount);
    final monthRevenues = monthInvoiced + mrr;
    final monthMargin = monthRevenues - monthExpenses;
    final monthMarginPct = monthRevenues <= 0
        ? 0.0
        : monthMargin / monthRevenues;

    final accent = GussoniBrand.primary;
    final billablePct = monthHours > 0 ? monthBillableHours / monthHours : 0.0;
    final winRate = (openDeals.length + wonDeals.length) > 0
        ? wonDeals.length / (openDeals.length + wonDeals.length + lostDeals.length).clamp(1, 999)
        : 0.0;
    final lastSixAmounts = lastSixMonths.map((m) => monthlyTotals[m] ?? 0.0).toList();
    final maxMonth = lastSixAmounts.fold<double>(0, (a, b) => a > b ? a : b);
    final quarterAmounts = [1,2,3,4].map((q) => quarterTotals[q] ?? 0.0).toList();
    final maxQ = quarterAmounts.fold<double>(0, (a, b) => a > b ? a : b);

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // ── Hero KPI row ──────────────────────────────────────────────
        LayoutBuilder(builder: (ctx, bc) {
          final cols = bc.maxWidth > 900 ? 4 : bc.maxWidth > 600 ? 2 : 1;
          return GridView.count(
            crossAxisCount: cols,
            shrinkWrap: true,
            physics: const NeverScrollableScrollPhysics(),
            crossAxisSpacing: 12,
            mainAxisSpacing: 12,
            childAspectRatio: 2.0,
            children: [
              _KpiCard(
                label: 'Pipeline aperta',
                value: currency.format(openDealsValue),
                sub: '${openDeals.length} opportunità',
                icon: Icons.trending_up_outlined,
                iconColor: accent,
              ),
              _KpiCard(
                label: 'MRR',
                value: currency.format(mrr),
                sub: 'ARR ${currency.format(arr)}',
                icon: Icons.repeat_outlined,
                iconColor: const Color(0xFF0EA5E9),
              ),
              _KpiCard(
                label: 'Ore mese',
                value: '${monthHours.toStringAsFixed(1)}h',
                sub: 'Fatturabili ${(billablePct * 100).toStringAsFixed(0)}%',
                icon: Icons.schedule_outlined,
                iconColor: const Color(0xFF8B5CF6),
              ),
              _KpiCard(
                label: 'Margine mese',
                value: currency.format(monthMargin),
                sub: 'Ricavi ${currency.format(monthRevenues)}',
                icon: monthMargin >= 0 ? Icons.arrow_upward : Icons.arrow_downward,
                iconColor: monthMargin >= 0 ? accent : const Color(0xFFEF4444),
                negative: monthMargin < 0,
              ),
            ],
          );
        }),
        const SizedBox(height: 12),

        // ── Secondary KPI row ─────────────────────────────────────────
        Wrap(
          spacing: 12, runSpacing: 12,
          children: [
            _SmallKpi(label: 'Deals vinte', value: wonDeals.length.toString(), sub: currency.format(wonDealsValue)),
            _SmallKpi(label: 'Win rate', value: '${(winRate * 100).toStringAsFixed(0)}%', sub: '${wonDeals.length}/${wonDeals.length + lostDeals.length + openDeals.length} deals'),
            _SmallKpi(label: 'Deals perse', value: lostDeals.length.toString(), sub: 'questo periodo', negative: lostDeals.isNotEmpty),
            _SmallKpi(label: 'Abbonamenti attivi', value: activeSubscriptions.length.toString(), sub: 'MRR ${currency.format(mrr)}'),
            _SmallKpi(label: 'Fatture mese', value: monthInvoices.length.toString(), sub: currency.format(monthInvoiced)),
            _SmallKpi(label: 'Ore settimana', value: '${weekHours.toStringAsFixed(1)}h', sub: 'questa settimana'),
          ],
        ),
        const SizedBox(height: 12),

        // ── Charts row ────────────────────────────────────────────────
        Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Expanded(
              flex: 3,
              child: _ChartCard(
                title: 'Fatturato mensile',
                subtitle: 'Ultimi 6 mesi',
                labels: lastSixMonths.map((m) => DateFormat('MMM', 'it_IT').format(m)).toList(),
                values: lastSixAmounts,
                maxValue: maxMonth,
                currency: currency,
                accent: accent,
              ),
            ),
            const SizedBox(width: 12),
            Expanded(
              flex: 2,
              child: _ChartCard(
                title: 'Fatturato trimestrale',
                subtitle: now.year.toString(),
                labels: ['Q1', 'Q2', 'Q3', 'Q4'],
                values: quarterAmounts,
                maxValue: maxQ,
                currency: currency,
                accent: const Color(0xFF0EA5E9),
              ),
            ),
          ],
        ),
      ],
    );
  }
}

