  Future<void> _deleteTimelineSlot(
    WorkspaceSnapshot workspace,
    TimelineSlot slot,
  ) async {
    await _repository.deleteTimelineSlot(widget.user.uid, slot.id);
    final nextSlots = workspace.plannedSlots
        .where((item) => item.id != slot.id)
        .toList();
    _syncPlanningAfterChange(workspace.copyWith(plannedSlots: nextSlots));
  }

  double _remainingTaskHours(WorkspaceSnapshot workspace, WorkTask task) {
    final tracked = workspace.timeTracks
        .where((track) => track.taskId == task.id)
        .fold<double>(0, (sum, track) => sum + track.hours);
    final consumed = tracked > 0 ? tracked : task.loggedHours;
    return (task.estimatedHours - consumed)
        .clamp(0, task.estimatedHours)
        .toDouble();
  }

  Map<DateTime, double> _taskDayAllocations(
    WorkspaceSnapshot workspace,
    WorkTask task,
  ) {
    final map = <DateTime, double>{};
    for (final slot in workspace.plannedSlots.where(
      (s) => s.taskId == task.id,
    )) {
      final day = DateTime(slot.date.year, slot.date.month, slot.date.day);
      map.update(
        day,
        (value) => value + slot.plannedHours,
        ifAbsent: () => slot.plannedHours,
      );
    }
    return map;
  }

  double _dayPlanningCap(WorkspaceSnapshot workspace, DateTime date) {
    if (_isVacationDay(workspace.vacations, date)) {
      return 0;
    }
    final availability = workspace.availability.firstWhere(
      (entry) => entry.weekday == date.weekday,
      orElse: () => const UserAvailability(weekday: 0, hours: 0, isOff: true),
    );
    if (availability.isOff) {
      return 0;
    }
    final raw = availability.hours <= 0 ? 6.0 : availability.hours;
    return raw.clamp(0, 6).toDouble();
  }

  Future<void> _persistTaskDayAllocations(
    WorkspaceSnapshot workspace,
    WorkTask task,
    Map<DateTime, double> allocations,
  ) async {
    final nextSlots = <TimelineSlot>[];
    var index = 0;
    final orderedDays = allocations.keys.toList()..sort();
    for (final day in orderedDays) {
      final hours = allocations[day] ?? 0;
      if (hours <= 0) {
        continue;
      }
      final slot = TimelineSlot(
        id: 'slot-${task.id}-${day.microsecondsSinceEpoch}-$index',
        taskId: task.id,
        date: day,
        plannedHours: hours,
        startHour: 9,
      );
      index += 1;
      nextSlots.add(slot);
    }
    await _repository.replaceTimelineSlotsForTask(
      widget.user.uid,
      taskId: task.id,
      slots: nextSlots,
    );

    final merged = [
      ...workspace.plannedSlots.where((slot) => slot.taskId != task.id),
      ...nextSlots,
    ];
    _syncPlanningAfterChange(workspace.copyWith(plannedSlots: merged));
  }

  Future<void> _moveTaskPlannedDay(
    WorkspaceSnapshot workspace,
    WorkTask task,
    DateTime fromDay,
    DateTime toDay,
  ) async {
    final from = DateTime(fromDay.year, fromDay.month, fromDay.day);
    final to = DateTime(toDay.year, toDay.month, toDay.day);
    final allocations = _taskDayAllocations(workspace, task);
    final moved = allocations[from] ?? 0;
    if (moved <= 0) {
      return;
    }
    allocations[from] = 0;
    allocations[to] = (allocations[to] ?? 0) + moved;
    await _persistTaskDayAllocations(workspace, task, allocations);
  }

  Future<void> _deleteTaskPlannedDay(
    WorkspaceSnapshot workspace,
    WorkTask task,
    DateTime day,
  ) async {
    final targetDay = DateTime(day.year, day.month, day.day);
    final allocations = _taskDayAllocations(workspace, task);
    allocations[targetDay] = 0;
    await _persistTaskDayAllocations(workspace, task, allocations);
  }

  Future<void> _addTimeOnTaskDay(
    WorkspaceSnapshot workspace,
    WorkTask task,
    DateTime day,
    double deltaHours,
  ) async {
    final targetDay = DateTime(day.year, day.month, day.day);
    if (deltaHours == 0) {
      return;
    }
    final allocations = _taskDayAllocations(workspace, task);
    final current = allocations[targetDay] ?? 0;
    final next = (current + deltaHours).clamp(0.0, 200.0).toDouble();
    allocations[targetDay] = next;
    await _persistTaskDayAllocations(workspace, task, allocations);
  }

