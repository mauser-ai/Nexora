// ── Team member selector dropdown ──

class _TeamMemberSelector extends StatelessWidget {
  const _TeamMemberSelector({
    required this.members,
    required this.currentUserId,
    required this.selectedId,
    required this.onChanged,
    this.showAllOption = false,
  });

  final List<TeamMember> members;
  final String currentUserId;
  final String selectedId;
  final ValueChanged<String?> onChanged;
  final bool showAllOption; // "Tutti" option per task filter

  String _displayName(String id) {
    if (showAllOption && id == 'all') return 'Tutti';
    if (id == currentUserId) {
      return members
          .firstWhere(
            (m) => m.userId == currentUserId,
            orElse: () => const TeamMember(
              userId: '',
              email: '',
              displayName: 'Io',
              role: '',
              status: '',
            ),
          )
          .displayName;
    }
    return members
        .firstWhere(
          (m) => m.userId == id,
          orElse: () => const TeamMember(
            userId: '',
            email: '',
            displayName: '?',
            role: '',
            status: '',
          ),
        )
        .displayName;
  }

  Color _colorForName(String name) {
    final p = [
      const Color(0xFF0369A1),
      const Color(0xFF7C3AED),
      GussoniBrand.primary,
      const Color(0xFFD97706),
    ];
    return p[name.codeUnits.fold<int>(0, (a, c) => a * 31 + c).abs() %
        p.length];
  }

  @override
  Widget build(BuildContext context) {
    final effectiveId = selectedId;
    final displayName = _displayName(effectiveId);
    final color = _colorForName(displayName);

    return PopupMenuButton<String>(
      onSelected: (id) => onChanged(id == 'all' ? null : id),
      itemBuilder: (_) => [
        if (showAllOption)
          PopupMenuItem(
            value: 'all',
            child: Row(
              children: [
                const Icon(
                  Icons.people_outline,
                  size: 16,
                  color: Color(0xFF7D89A8),
                ),
                const SizedBox(width: 8),
                const Text('Tutti i task del team'),
              ],
            ),
          ),
        ...members.map(
          (m) => PopupMenuItem(
            value: m.userId,
            child: Row(
              children: [
                _MemberAvatar(name: m.displayName, size: 24),
                const SizedBox(width: 8),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        m.displayName,
                        style: const TextStyle(
                          fontSize: 13,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                      Text(
                        m.role,
                        style: const TextStyle(
                          fontSize: 11,
                          color: Color(0xFF525D78),
                        ),
                      ),
                    ],
                  ),
                ),
                if (m.userId == currentUserId)
                  const Text(
                    '(tu)',
                    style: TextStyle(fontSize: 11, color: Color(0xFF525D78)),
                  ),
              ],
            ),
          ),
        ),
      ],
      child: Container(
        height: 38,
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 0),
        decoration: BoxDecoration(
          color: const Color(0xFF0E1020),
          borderRadius: BorderRadius.circular(8),
          border: Border.all(color: const Color(0xFF1E2130)),
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            _MemberAvatar(name: displayName, size: 22),
            const SizedBox(width: 8),
            Text(
              displayName,
              style: const TextStyle(
                fontSize: 13,
                fontWeight: FontWeight.w600,
                color: Color(0xFFB8C0D8),
              ),
            ),
            const SizedBox(width: 6),
            const Icon(
              Icons.keyboard_arrow_down,
              size: 16,
              color: Color(0xFF525D78),
            ),
          ],
        ),
      ),
    );
  }
}

class _MemberAvatar extends StatelessWidget {
  const _MemberAvatar({required this.name, this.size = 28});
  final String name;
  final double size;

  Color _color(String n) {
    final p = [
      const Color(0xFF0369A1),
      const Color(0xFF7C3AED),
      GussoniBrand.primary,
      const Color(0xFFD97706),
    ];
    return p[n.codeUnits.fold<int>(0, (a, c) => a * 31 + c).abs() % p.length];
  }

  String _init(String n) {
    final parts = n.trim().split(' ');
    return parts.length >= 2
        ? '${parts[0][0]}${parts[1][0]}'.toUpperCase()
        : (n.isNotEmpty ? n[0].toUpperCase() : '?');
  }

  @override
  Widget build(BuildContext context) {
    final c = _color(name);
    return Container(
      width: size,
      height: size,
      decoration: BoxDecoration(
        shape: BoxShape.circle,
        color: c.withValues(alpha: 0.15),
        border: Border.all(color: c.withValues(alpha: 0.4)),
      ),
      child: Center(
        child: Text(
          _init(name),
          style: TextStyle(
            fontSize: size * 0.38,
            fontWeight: FontWeight.w800,
            color: c,
          ),
        ),
      ),
    );
  }
}

