                          filterUserId: null,
                          onPaginationChanged: _onTaskPaginationChanged,
                        ),
                      // 2 – Società
                    ] else if (selectedIndex == 1) ...[
                      const _SectionTitle(
                        title: 'Società',
                        subtitle:
                            'Anagrafiche aziende clienti con dati fiscali, contatti e note.',
