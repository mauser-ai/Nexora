  Future<void> _updateCompanyContact(CompanyContact contact) {
    return _repository.updateCompanyContact(widget.user.uid, contact);
  }

  Future<void> _deleteCompanyContact(String contactId) {
    return _repository.deleteCompanyContact(widget.user.uid, contactId);
  }

  Future<void> _createTicket(Ticket ticket) {
    return _repository.createTicket(widget.user.uid, ticket);
  }

  Future<void> _updateTicket(Ticket ticket) {
    return _repository.updateTicket(widget.user.uid, ticket);
  }

  Future<void> _deleteTicket(String ticketId) {
    return _repository.deleteTicket(widget.user.uid, ticketId);
  }

  // Apre la creazione ticket dalla lista (usa il dialog esistente nel TicketCenterCard)
  Future<void> _openCreateTicketDialogFromList(
    BuildContext context,
    WorkspaceSnapshot workspace, {
    String? preselectedCompanyId,
  }) async {
    if (workspace.companies.isEmpty) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Crea prima almeno una società.')),
      );
      return;
    }
    String selectedCompanyId =
        (preselectedCompanyId != null &&
            workspace.companies.any((c) => c.id == preselectedCompanyId))
        ? preselectedCompanyId
        : workspace.companies.first.id;
    String? selectedRecipient;
    final subjectController = TextEditingController();

    List<String> recipientsForCompany(String companyId) {
      final out = <String>[];
      for (final company in workspace.companies) {
        if (company.id == companyId && company.email.trim().isNotEmpty)
          out.add(company.email.trim());
      }
      for (final contact in workspace.companyContacts) {
        if (contact.companyId != companyId) continue;
        final email = contact.email.trim();
        if (email.isEmpty || out.contains(email)) continue;
        out.add(email);
      }
      return out;
    }

    await showDialog<void>(
      context: context,
      builder: (ctx) => StatefulBuilder(
        builder: (ctx, setModalState) {
          final recipients = recipientsForCompany(selectedCompanyId);
          selectedRecipient ??= recipients.isNotEmpty ? recipients.first : null;
          return AlertDialog(
            title: const Text('Nuovo ticket'),
            content: SizedBox(
              width: 480,
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  DropdownButtonFormField<String>(
                    initialValue: selectedCompanyId,
                    isExpanded: true,
                    decoration: const InputDecoration(
                      labelText: 'Azienda',
                      border: OutlineInputBorder(),
                    ),
                    items: workspace.companies
                        .map(
                          (c) => DropdownMenuItem(
                            value: c.id,
                            child: Text(c.name),
                          ),
                        )
                        .toList(),
                    onChanged: (v) {
                      if (v == null) return;
                      setModalState(() {
                        selectedCompanyId = v;
                        selectedRecipient = null;
                      });
                    },
                  ),
                  const SizedBox(height: 12),
                  DropdownButtonFormField<String>(
                    initialValue: selectedRecipient,
                    isExpanded: true,
                    decoration: const InputDecoration(
                      labelText: 'Destinatario',
                      border: OutlineInputBorder(),
                    ),
                    items: recipients
                        .map((e) => DropdownMenuItem(value: e, child: Text(e)))
                        .toList(),
                    onChanged: (v) =>
                        setModalState(() => selectedRecipient = v),
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: subjectController,
                    decoration: const InputDecoration(
                      labelText: 'Oggetto ticket',
                      border: OutlineInputBorder(),
                    ),
                  ),
                ],
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.of(ctx).pop(),
                child: const Text('Annulla'),
              ),
              FilledButton(
                onPressed: () async {
                  final subject = subjectController.text.trim();
                  final recipient = selectedRecipient?.trim() ?? '';
                  if (subject.isEmpty || recipient.isEmpty) return;
                  final now = DateTime.now();
                  await _createTicket(
                    Ticket(
                      id: 'tkt-${now.microsecondsSinceEpoch}',
                      companyId: selectedCompanyId,
                      title: subject,
                      recipientEmail: recipient,
                      status: TicketStatus.newTicket,
                      createdAt: now,
                      updatedAt: now,
                      entries: const [],
                    ),
                  );
                  if (ctx.mounted) Navigator.of(ctx).pop();
                },
                child: const Text('Crea ticket'),
              ),
            ],
          );
        },
      ),
    );
    subjectController.dispose();
  }

  // Apre il dettaglio ticket nella sezione Ticket (cambia la selezione)
  Future<void> _openTicketDetail(
    BuildContext context,
    WorkspaceSnapshot workspace,
    Ticket ticket,
  ) async {
    // Naviga alla sezione Ticket full e apre il dettaglio tramite dialog
    await showDialog<void>(
      context: context,
      builder: (ctx) => Dialog(
        insetPadding: const EdgeInsets.all(24),
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 900, maxHeight: 700),
          child: _TicketDetailWrapper(
            ticket: ticket,
            workspace: workspace,
            currentUserName: widget.user.email ?? widget.user.uid,
            onUpdateTicket: _updateTicket,
            emailSignatureHtml: workspace.emailSignatureHtml,
          ),
        ),
      ),
    );
  }

  Future<void> _openCreateCrmContactDialog(
    BuildContext context, {
    required String companyId,
  }) async {
    final firstName = TextEditingController();
    final lastName = TextEditingController();
    final email = TextEditingController();
    final phone = TextEditingController();
    final role = TextEditingController();
    await showDialog<void>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Nuovo contatto'),
        content: SizedBox(
          width: 520,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Row(
                children: [
                  Expanded(
                    child: TextField(
                      controller: firstName,
                      decoration: const InputDecoration(
                        labelText: 'Nome *',
                        border: OutlineInputBorder(),
                      ),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: TextField(
                      controller: lastName,
                      decoration: const InputDecoration(
                        labelText: 'Cognome *',
                        border: OutlineInputBorder(),
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 12),
              TextField(
                controller: email,
                decoration: const InputDecoration(
                  labelText: 'Email',
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: phone,
                decoration: const InputDecoration(
                  labelText: 'Telefono',
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: role,
                decoration: const InputDecoration(
                  labelText: 'Ruolo',
                  border: OutlineInputBorder(),
                ),
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(),
            child: const Text('Annulla'),
          ),
          FilledButton(
            onPressed: () async {
              final fn = firstName.text.trim();
              final ln = lastName.text.trim();
              if (fn.isEmpty || ln.isEmpty) {
                return;
              }
              final now = DateTime.now();
              await _crmRepository.createContact(
                widget.user.uid,
                CrmFirestoreContact(
                  id: 'cnt-${now.microsecondsSinceEpoch}',
                  firstName: fn,
                  lastName: ln,
                  companyId: companyId,
                  email: email.text.trim(),
                  phone: phone.text.trim(),
                  role: role.text.trim(),
                  createdAt: now,
                  updatedAt: now,
                ),
              );
              if (ctx.mounted) {
                Navigator.of(ctx).pop();
              }
            },
            child: const Text('Salva'),
          ),
        ],
      ),
    );
    firstName.dispose();
    lastName.dispose();
    email.dispose();
    phone.dispose();
    role.dispose();
  }

  Future<void> _openCreateDealDialog(
    BuildContext context, {
    required String customerId,
    required String customerType,
  }) async {
    if (_crmData.sortedStages.isEmpty) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Nessuna fase pipeline disponibile.')),
      );
      return;
    }
    final title = TextEditingController();
    final value = TextEditingController(text: '0');
    final probability = TextEditingController(text: '50');
    await showDialog<void>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Nuova opportunità'),
        content: SizedBox(
          width: 440,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(
                controller: title,
                decoration: const InputDecoration(
                  labelText: 'Titolo *',
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: value,
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                decoration: const InputDecoration(
                  labelText: 'Valore (€)',
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: probability,
                keyboardType: TextInputType.number,
                decoration: const InputDecoration(
                  labelText: 'Probabilità %',
                  border: OutlineInputBorder(),
                ),
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(),
            child: const Text('Annulla'),
          ),
          FilledButton(
            onPressed: () async {
              final dealTitle = title.text.trim();
              if (dealTitle.isEmpty) return;
              final now = DateTime.now();
              final amount =
                  double.tryParse(value.text.trim().replaceAll(',', '.')) ?? 0;
              final prob = int.tryParse(probability.text.trim()) ?? 50;
              final stageId = _crmData.sortedStages.first.id;
              await _crmRepository.createDeal(
                widget.user.uid,
                Deal(
                  id: 'deal-${now.microsecondsSinceEpoch}',
                  title: dealTitle,
                  stageId: stageId,
                  status: DealFirestoreStatus.open,
                  value: amount,
                  customerId: customerId,
                  customerType: customerType,
                  probability: prob.clamp(0, 100),
                  createdAt: now,
                  updatedAt: now,
                ),
              );
              if (ctx.mounted) {
                Navigator.of(ctx).pop();
              }
            },
            child: const Text('Crea'),
          ),
        ],
      ),
    );
    title.dispose();
    value.dispose();
    probability.dispose();
  }

  Future<void> _openCreateQuotationDialog(
    BuildContext context, {
    required String customerId,
    required String customerType,
    String? dealId,
  }) async {
    final description = TextEditingController(text: 'Servizio');
    final amount = TextEditingController(text: '0');
    await showDialog<void>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Nuovo preventivo'),
        content: SizedBox(
          width: 460,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(
                controller: description,
                decoration: const InputDecoration(
                  labelText: 'Descrizione riga',
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: amount,
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                decoration: const InputDecoration(
                  labelText: 'Importo imponibile (€)',
                  border: OutlineInputBorder(),
                ),
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(),
            child: const Text('Annulla'),
          ),
          FilledButton(
            onPressed: () async {
              final lineDescription = description.text.trim().isEmpty
                  ? 'Servizio'
                  : description.text.trim();
              final net =
                  double.tryParse(amount.text.trim().replaceAll(',', '.')) ?? 0;
              final now = DateTime.now();
              await _crmRepository.createQuotation(
                widget.user.uid,
                Quotation(
                  id: 'q-${now.microsecondsSinceEpoch}',
                  number: 'PREV-${now.millisecondsSinceEpoch}',
                  status: QuotationStatus.draft,
                  customerId: customerId,
                  customerType: customerType,
                  dealId: dealId,
                  lines: [
                    QuotationLine(
                      description: lineDescription,
                      quantity: 1,
                      unitPrice: net,
                    ),
                  ],
                  createdAt: now,
                  updatedAt: now,
                ),
              );
              if (ctx.mounted) {
                Navigator.of(ctx).pop();
              }
            },
            child: const Text('Crea'),
          ),
        ],
      ),
    );
    description.dispose();
    amount.dispose();
  }

