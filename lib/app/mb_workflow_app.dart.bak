                  : const Text('Accedi', style: TextStyle(fontSize: 14, fontWeight: FontWeight.w700)),
            ),
          ),
          const SizedBox(height: 16),
          const Text(
            'Accesso riservato ai membri del team.\nContatta l\'amministratore per richiedere un account.',
            textAlign: TextAlign.center,
            style: TextStyle(fontSize: 12, color: Color(0xFF525D78)),
          ),
        ],
      ),
    );

    return Scaffold(
      body: Stack(
        children: [
          // Dark background
          Container(
            decoration: const BoxDecoration(
              gradient: LinearGradient(
                colors: [Color(0xFF020208), Color(0xFF050518)],
                begin: Alignment.topLeft, end: Alignment.bottomRight,
              ),
            ),
          ),
          // Neon glow blobs
          Positioned(top: -100, left: -100,
            child: Container(width: 400, height: 400, decoration: BoxDecoration(
              shape: BoxShape.circle,
              gradient: RadialGradient(colors: [accent.withOpacity(.08), Colors.transparent]),
