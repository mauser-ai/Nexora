class ExecutiveSummaryCard extends StatelessWidget {
  const ExecutiveSummaryCard({super.key, required this.workspace});

  final WorkspaceSnapshot workspace;

  @override
  Widget build(BuildContext context) {
    final billableHours = workspace.tasks.fold<double>(
      0,
      (sum, task) => sum + (task.billable ? task.estimatedHours : 0),
    );
    final overdue = workspace.tasks.where(
      (task) =>
          task.status != TaskStatus.done &&
          task.deadline.isBefore(DateTime.now()),
    );

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Wrap(
          spacing: 16,
          runSpacing: 16,
          children: [
            _KpiTile(
              title: 'Clienti attivi',
              value: '${workspace.companies.length}',
              subtitle: 'Anagrafiche realtime',
            ),
            _KpiTile(
              title: 'Progetti attivi',
              value: '${workspace.projects.length}',
              subtitle: 'Portfolio operativo',
            ),
            _KpiTile(
              title: 'Ore fatturabili',
              value: '${billableHours.toStringAsFixed(1)}h',
              subtitle: 'Da task e fasi correnti',
            ),
            _KpiTile(
              title: 'Task critici',
              value: '${overdue.length}',
              subtitle: 'Scaduti o in ritardo',
            ),
          ],
        ),
      ),
    );
  }
}

