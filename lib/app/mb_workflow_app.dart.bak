                        onAddTask: (project) => _openTaskDialog(
                          context,
                          workspace,
                          preselectedCompanyId: project.companyId,
                          preselectedProjectId: project.id,
                        ),
                        onOpenDetail: (project) =>
                            _openDetail('project', project),
                      ),
                      // 7 – Finanze (con submenu: Fatture | Abbonamenti | Note di credito)
                    ] else if (selectedIndex == 6) ...[
                      Row(
                        children: [
                          Expanded(
                            child: _SectionTitle(
                              title: 'Finanze',
                              subtitle: [
                                'Fatture',
                                'Note di credito',
