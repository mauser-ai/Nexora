  // ──────────────────────────────────────────────
  // Navigazione detail – costruisce la scheda dettaglio
  // ──────────────────────────────────────────────

  Widget? _buildDetailPage(
    BuildContext context,
    WorkspaceSnapshot workspace,
    EdgeInsets padding,
  ) {
    switch (_detailType) {
      case 'company':
        final company = _detailEntity as Company;
        return CompanyDetailPage(
          company: company,
          workspace: workspace,
          crmData: _crmData,
          repository: _repository,
          crmRepo: _crmRepository,
          userId: widget.user.uid,
          onBack: _closeDetail,
          onEdit: (c) => _openCompanyDialog(context: context, company: c),
          onAddDeal: () => _openCreateDealDialog(
            context,
            customerId: company.id,
            customerType: 'company',
          ),
          onAddQuotation: () => _openCreateQuotationDialog(
            context,
            customerId: company.id,
            customerType: 'company',
          ),
          onAddContact: () =>
              _openCreateCrmContactDialog(context, companyId: company.id),
          onAddProject: () => _openProjectDialog(
            context,
            workspace,
            preselectedCompanyId: company.id,
          ),
          onAddInvoice: () => _openInvoiceDialog(
            context,
            workspace,
            preselectedCompanyId: company.id,
          ),
          onAddTicket: () => _openCreateTicketDialogFromList(
            context,
            workspace,
            preselectedCompanyId: company.id,
          ),
          onAddTask: () => _openTaskDialog(
            context,
            workspace,
            preselectedCompanyId: company.id,
          ),
          onAddWorkOrder: () =>
              _openCreateWorkOrderDialog(context, companyId: company.id),
          onOpenContact: (c) => _openDetail('contact', c),
          onOpenDeal: (d) => _openDetail('deal', d),
          onOpenQuotation: (q) => _openDetail('quotation', q),
          onOpenProject: (p) => _openDetail('project', p),
          onOpenInvoice: (inv) => _openDetail('invoice', inv),
          onOpenTicket: (t) => _openTicketDetail(context, workspace, t),
          onOpenTask: (t) => _openDetail('task', t),
        );
      case 'contact':
        final contact = _detailEntity as CrmFirestoreContact;
        return ContactDetailPage(
          contact: contact,
          workspace: workspace,
          crmData: _crmData,
          crmRepo: _crmRepository,
          userId: widget.user.uid,
          onBack: _closeDetail,
          onEdit: (c) async {
            /* edit dialog via showDialog */
          },
          onDelete: () =>
              _crmRepository.deleteContact(widget.user.uid, contact.id),
          onAddDeal: () => _openCreateDealDialog(
            context,
            customerId: contact.id,
            customerType: 'contact',
          ),
          onAddQuotation: () => _openCreateQuotationDialog(
            context,
            customerId: contact.id,
            customerType: 'contact',
          ),
          onAddTask: () => _openTaskDialog(
            context,
            workspace,
            preselectedCompanyId: contact.companyId,
          ),
          onOpenDeal: (d) => _openDetail('deal', d),
          onOpenQuotation: (q) => _openDetail('quotation', q),
          onOpenTask: (t) => _openDetail('task', t),
        );
      case 'deal':
        final deal = _detailEntity as Deal;
        return DealDetailPage(
          deal: deal,
          workspace: workspace,
          crmData: _crmData,
          crmRepo: _crmRepository,
          userId: widget.user.uid,
          onBack: _closeDetail,
          onEdit: (d) async {},
          onOpenQuotation: (q) => _openDetail('quotation', q),
          onOpenProject: (p) => _openDetail('project', p),
          onOpenTask: (t) => _openDetail('task', t),
        );
      case 'quotation':
        final quotation = _detailEntity as Quotation;
        return QuotationDetailPage(
          quotation: quotation,
          workspace: workspace,
          crmData: _crmData,
          crmRepo: _crmRepository,
          userId: widget.user.uid,
          onBack: _closeDetail,
          onDelete: () =>
              _crmRepository.deleteQuotation(widget.user.uid, quotation.id),
        );
      case 'project':
        final project = _detailEntity as Project;
        return ProjectDetailPage(
          project: project,
          workspace: workspace,
          crmData: _crmData,
          onBack: _closeDetail,
          onEdit: (p) => _openProjectDialog(context, workspace, project: p),
          onAddPhase: () =>
              _openPhaseDialog(context, workspace, project: project),
          onAddTask: () => _openTaskDialog(
            context,
            workspace,
            preselectedCompanyId: project.companyId,
            preselectedProjectId: project.id,
          ),
          onAddTaskToPhase: (phase) => _openTaskDialog(
            context,
            workspace,
            preselectedCompanyId: project.companyId,
            preselectedProjectId: project.id,
            preselectedPhaseId: phase.id,
          ),
          onAddTimeTrack: () =>
              _openTimeTrackDialog(context, workspace, date: DateTime.now()),
          onOpenTask: (t) => _openDetail('task', t),
        );
      case 'invoice':
        final invoice = _detailEntity as InvoiceDraft;
        return InvoiceDetailPage(
          invoice: invoice,
          workspace: workspace,
          crmData: _crmData,
          onBack: _closeDetail,
          onEdit: (inv) =>
              _openInvoiceDialog(context, workspace, initialInvoice: inv),
          onExportXml: (inv) => _exportInvoiceXml(context, workspace, inv),
          onEmitYoudox: (inv) =>
              _emitInvoiceYoudoxDraft(context, workspace, inv),
          onDelete: (inv) => _deleteInvoice(inv),
        );
      case 'task':
        final task = _detailEntity as WorkTask;
        return TaskDetailPage(
          task: task,
          workspace: workspace,
          onBack: _closeDetail,
          onEdit: (t) => _openTaskDialog(context, workspace, task: t),
        );
      case 'product':
        final product = _detailEntity as Product;
        return ProductDetailPage(
          product: product,
          crmData: _crmData,
          onBack: _closeDetail,
          onDelete: () =>
              _crmRepository.deleteProduct(widget.user.uid, product.id),
        );
      default:
        return null;
    }
  }

  Future<void> _openInvoiceDialog(
    BuildContext context,
    WorkspaceSnapshot workspace, {
    InvoiceDraft? initialInvoice,
    String? preselectedCompanyId,
  }) async {
    await showDialog<void>(
      context: context,
      builder: (context) => Dialog(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 860),
          child: InvoiceEditorCard(
            workspace: workspace,
            initialInvoice: initialInvoice,
            preselectedCompanyId: preselectedCompanyId,
            onSubmit: _saveInvoice,
          ),
        ),
      ),
